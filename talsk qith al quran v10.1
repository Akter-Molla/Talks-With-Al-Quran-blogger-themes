    function getDriveViewUrl(driveId) {
      if (!driveId) return null;
      return 'https://drive.google.com/file/d/' + driveId + '/view';
    }

    function getDriveEmbedUrl(driveId) {
      if (!driveId) return null;
      return 'https://drive.google.com/file/d/' + driveId + '/preview';
    }

    function formatTime(seconds) {
      var mins = Math.floor(seconds / 60);
      var secs = seconds % 60;
      return mins + ' মিনিট ' + secs + ' সেকেন্ড';
    }

    function findBookByName(name) {
      if (!state.books || state.books.length === 0) return null;
      var searchName = name.toLowerCase().trim();
      searchName = searchName.replace(/বই|পড়|পড়|read|book|খুল|দেখ|show|পিডিএফ|pdf/gi, '').trim();
      
      for (var i = 0; i < state.books.length; i++) {
        var book = state.books[i];
        if (book.title && book.title.toLowerCase().indexOf(searchName) !== -1) {
          return book;
        }
      }
      return null;
    }

    // ============================================================
    // 10. MESSAGE FUNCTIONS
    // ============================================================
    function addMessage(text, isUser, type, isHTML) {
      isUser = isUser || false;
      type = type || 'normal';
      isHTML = isHTML || false;
      
      if (dom.welcomeSection && state.welcomeVisible) {
        dom.welcomeSection.style.display = 'none';
        state.welcomeVisible = false;
      }

      var div = document.createElement('div');
      div.className = 'message ' + (isUser ? 'user' : 'bot');
      if (!isUser && type !== 'normal') {
        div.classList.add(type);
      }
      
      if (isHTML) {
        div.innerHTML = text + '<div class="message-timestamp">' + getTimestamp() + '</div>';
      } else {
        div.textContent = text;
        div.innerHTML += '<div class="message-timestamp">' + getTimestamp() + '</div>';
      }
      
      dom.messages.appendChild(div);
      scrollToBottom();
      return div;
    }

    function addUserMessage(text) {
      return addMessage(text, true);
    }

    function addBotMessage(text, type, isHTML) {
      type = type || 'normal';
      isHTML = isHTML || false;
      return addMessage(text, false, type, isHTML);
    }

    function showTyping() {
      var div = document.createElement('div');
      div.id = 'typing-indicator';
      div.className = 'typing-indicator';
      div.innerHTML = '<span></span><span></span><span></span>';
      dom.messages.appendChild(div);
      scrollToBottom();
    }

    function removeTyping() {
      var el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    // ============================================================
    // 11. CLOCK
    // ============================================================
    function updateClock() {
      var now = new Date();
      var hours = now.getHours();
      var ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12;
      var minutes = String(now.getMinutes()).padStart(2, '0');
      var seconds = String(now.getSeconds()).padStart(2, '0');
      if (dom.clock) dom.clock.textContent = hours + ':' + minutes + ':' + seconds;
      if (dom.clockAmPm) dom.clockAmPm.textContent = ampm;
    }

    // ============================================================
    // 12. DATA LOADING
    // ============================================================
    function loadData() {
      setDataStatus('✅ ডেটা প্রস্তুত', false);
      fadeDataStatus();
      
      // Try to load blog posts from Blogger
      var feedUrl = window.location.origin + '/feeds/posts/default?alt=json&max-results=10';
      fetch(feedUrl)
        .then(function(response) {
          if (!response.ok) throw new Error('Blog feed not available');
          return response.json();
        })
        .then(function(data) {
          if (data && data.feed && data.feed.entry) {
            state.blogPosts = data.feed.entry.map(function(entry) {
              var content = entry.content ? entry.content.$t || '' : '';
              var summary = entry.summary ? entry.summary.$t || '' : '';
              content = content.replace(/<[^>]*>/g, '').trim();
              summary = summary.replace(/<[^>]*>/g, '').trim() || content.substring(0, 200) + '...';
              return {
                title: entry.title.$t || '',
                content: content,
                summary: summary,
                published: entry.published ? entry.published.$t || '' : '',
                link: entry.link ? entry.link.find(function(l) { return l.rel === 'alternate'; })?.href || '' : '',
                author: entry.author ? entry.author[0]?.name?.$t || '' : '',
                id: entry.id ? entry.id.$t || '' : 'post-' + Math.random().toString(36).substr(2, 9)
              };
            });
          }
        })
        .catch(function() {
          state.blogPosts = [
            {id:'p1', title:'কুরআনের গুরুত্ব ও ফযিলত', content:'কুরআন হলো মানবজাতির জন্য আল্লাহর সর্বশেষ কিতাব।', summary:'কুরআন হলো মানবজাতির জন্য আল্লাহর সর্বশেষ কিতাব।', published:new Date().toISOString(), link:'#', author:'Admin'},
            {id:'p2', title:'নামাজের গুরুত্ব ও সঠিক পদ্ধতি', content:'নামাজ ইসলামের দ্বিতীয় স্তম্ভ। এটি মুমিনের মিরাজ।', summary:'নামাজ ইসলামের দ্বিতীয় স্তম্ভ।', published:new Date().toISOString(), link:'#', author:'Admin'}
          ];
        });
      
      // Try to load books with "book" label
      var bookFeedUrl = window.location.origin + '/feeds/posts/default/-/book?alt=json&max-results=20';
      fetch(bookFeedUrl)
        .then(function(response) {
          if (!response.ok) throw new Error('Book feed not available');
          return response.json();
        })
        .then(function(data) {
          if (data && data.feed && data.feed.entry) {
            var blogBooks = data.feed.entry.map(function(entry) {
              var content = entry.content ? entry.content.$t || '' : '';
              var summary = entry.summary ? entry.summary.$t || '' : '';
              content = content.replace(/<[^>]*>/g, '').trim();
              summary = summary.replace(/<[^>]*>/g, '').trim() || content.substring(0, 150) + '...';
              
              var driveId = null;
              var driveMatch = content.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
              if (driveMatch) driveId = driveMatch[1];
              
              var category = 'বই';
              if (entry.category && entry.category.length > 0) {
                var labels = entry.category.map(function(c) { return c.term; });
                var bookLabel = labels.find(function(l) { return l.toLowerCase() !== 'book'; });
                if (bookLabel) category = bookLabel;
              }
              
              return {
                id: entry.id ? entry.id.$t || '' : 'book-' + Math.random().toString(36).substr(2, 9),
                title: entry.title.$t || 'নামহীন বই',
                author: 'ব্লগার',
                icon: '📖',
                driveId: driveId,
                description: summary,
                category: category,
                price: 'ফ্রী',
                isBloggerBook: true,
                link: entry.link ? entry.link.find(function(l) { return l.rel === 'alternate'; })?.href || '' : ''
              };
            });
            state.books = BOOKS.concat(blogBooks);
          }
        })
        .catch(function() {
          state.books = BOOKS;
        });
    }

