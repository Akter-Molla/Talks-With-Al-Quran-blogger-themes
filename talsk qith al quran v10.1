      html += '<button id="start-full-quran-load-btn" onclick="window.startFullQuranLoad()" style="width:100%;padding:0.5rem;background:var(--gold-gradient);border:none;border-radius:var(--rounded);cursor:pointer;font-weight:800;font-family:var(--font-ui);color:var(--dark);font-size:0.85rem;">🌐 সম্পূর্ণ কুরআন লোড করুন</button>';
      html += '</div></div>';
      addBotMessage(html, 'info', true);
    }

    window.startFullQuranLoad = function() {
      if (state.fullQuranLoaded) {
        addBotMessage('✅ সম্পূর্ণ কুরআন ডেটা ইতিমধ্যে লোড করা আছে। এখন যেকোনো আয়াত, সূরা বা তাফসীর খুঁজতে পারবেন।', 'success');
        return;
      }
      if (state.fullQuranLoading) {
        addBotMessage('⏳ ইতিমধ্যে লোড হচ্ছে, অনুগ্রহ করে অপেক্ষা করুন...', 'info');
        return;
      }

      state.fullQuranLoading = true;

      var btn = document.getElementById('start-full-quran-load-btn');
      if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ লোড হচ্ছে... (কিছুটা সময় লাগতে পারে)';
      }

      addBotMessage('🌐 সম্পূর্ণ কুরআন (আরবি + বাংলা অনুবাদ + তাফসীর ইবনে কাসীর) লোড হচ্ছে, দয়া করে অপেক্ষা করুন...', 'info');

      Promise.all([
        fetch(GITHUB_QURAN_SOURCES.bengali).then(function(r) {
          if (!r.ok) throw new Error('বাংলা অনুবাদ লোড ব্যর্থ');
          return r.json();
        }),
        fetch(GITHUB_QURAN_SOURCES.arabic).then(function(r) {
          if (!r.ok) throw new Error('আরবি টেক্সট লোড ব্যর্থ');
          return r.json();
        }),
        fetch(GITHUB_QURAN_SOURCES.tafsir).then(function(r) {
          if (!r.ok) throw new Error('তাফসীর লোড ব্যর্থ');
          return r.json();
        })
      ]).then(function(results) {
        var bnData = results[0];
        var arData = results[1];
        var tafsirRaw = results[2];

        if (Array.isArray(bnData) && bnData.length > 0) {
          state.quranData = bnData.map(function(item) {
            return { sura: String(item.sura), aya: String(item.aya), text: item.text };
          });
        }

        if (Array.isArray(arData) && arData.length > 0) {
          state.arabicData = arData.map(function(item) {
            return { sura: String(item.sura), VerseIDAr: String(item.VerseIDAr), ayat: item.ayat };
          });
        }

        if (tafsirRaw && typeof tafsirRaw === 'object') {
          var flatTafsir = {};
          Object.keys(tafsirRaw).forEach(function(key) {
            var val = tafsirRaw[key];
            if (val && typeof val === 'object' && val.text) {
              flatTafsir[key] = val.text;
            } else if (typeof val === 'string') {
              flatTafsir[key] = val;
            }
          });
          state.tafsirData = flatTafsir;
        }

        state.fullQuranLoaded = true;
        state.fullQuranLoading = false;

        addBotMessage('✅ সম্পূর্ণ কুরআন লোড সম্পন্ন হয়েছে!<br>📖 ' + state.quranData.length + ' টি আয়াত (বাংলা)<br>🕋 ' + state.arabicData.length + ' টি আয়াত (আরবি)<br>📚 ' + Object.keys(state.tafsirData).length + ' টি তাফসীর এন্ট্রি<br><br>এখন যেকোনো সূরা:আয়াত (যেমন 18:10), কীওয়ার্ড, অথবা "কুরআন-তাফসীর" ট্যাব থেকে খুঁজতে পারবেন।', 'success', true);
      }).catch(function(err) {
        state.fullQuranLoading = false;
        console.error('Full Quran load error:', err);
        addBotMessage('❌ সম্পূর্ণ কুরআন ডেটা লোড করতে সমস্যা হয়েছে। ইন্টারনেট সংযোগ পরীক্ষা করে আবার চেষ্টা করুন।', 'error');
        var retryBtn = document.getElementById('start-full-quran-load-btn');
        if (retryBtn) {
          retryBtn.disabled = false;
          retryBtn.textContent = '🌐 আবার চেষ্টা করুন';
        }
      });
    };

