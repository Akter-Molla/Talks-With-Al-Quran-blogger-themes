<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  <meta content='Al Quran Pro - Islamic Chatbot Theme' name='theme-name'/>
  <meta content='Akter Molla' name='theme-author'/>
  <meta content='10.0' name='theme-version'/>
  
  <link href='https://fonts.maateen.me/kalpurush/font.css' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&amp;display=swap' rel='stylesheet'/>
  
  <b:skin><![CDATA[
  :root {
    --primary: #0d2b1a;
    --primary-light: #1a4a2a;
    --gold: #d4af37;
    --gold-light: #f0d080;
    --gold-gradient: linear-gradient(135deg, #d4af37, #f0d080, #d4af37);
    --white: #ffffff;
    --dark: #1a1a1a;
    --text: #1a3a1a;
    --text-light: #4a6a4a;
    --light-bg: #f5faf5;
    --gray-light: #f0f5f0;
    --gray-medium: #dce4dc;
    --gray-dark: #6a7a6a;
    --shadow: 0 4px 24px rgba(0,0,0,0.08);
    --shadow-hover: 0 8px 40px rgba(0,0,0,0.12);
    --shadow-large: 0 16px 60px rgba(0,0,0,0.15);
    --rounded: 16px;
    --rounded-full: 50px;
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    --header-gradient: linear-gradient(135deg, #0d2b1a, #1a4a2a);
    --font-bengali: 'Kalpurush', 'Hind Siliguri', sans-serif;
    --font-arabic: 'Amiri', serif;
    --font-ui: 'Hind Siliguri', sans-serif;
    --bengali-font-size: 17px;
    --arabic-font-size: 22px;
  }

  [data-theme="dark"] {
    --primary: #3a9a5f;
    --primary-light: #4ab070;
    --gold: #e8c96a;
    --gold-light: #f0d97a;
    --white: #1a1a1a;
    --dark: #f0f0f0;
    --text: #e0e8e0;
    --text-light: #a0b0a0;
    --light-bg: #121212;
    --gray-light: #2a2a2a;
    --gray-medium: #3a4a3a;
    --gray-dark: #8a9a8a;
    --shadow: 0 4px 24px rgba(0,0,0,0.4);
    --shadow-hover: 0 8px 40px rgba(0,0,0,0.5);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: var(--font-bengali);
    color: var(--text);
    background: var(--light-bg);
    line-height: 1.7;
    overflow: hidden;
    font-size: var(--bengali-font-size);
    transition: background 0.4s, color 0.4s;
    height: 100vh;
    width: 100vw;
  }

  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--gray-light); border-radius: 10px; }
  ::-webkit-scrollbar-thumb { background: var(--gold-gradient); border-radius: 10px; }

  .chatbot-fullpage {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    background: var(--white);
    z-index: 1000;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
  }

  .chatbot-header-premium {
    background: var(--header-gradient);
    padding: 0.5rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 56px;
    flex-shrink: 0;
    box-shadow: 0 2px 20px rgba(0,0,0,0.15);
    position: relative;
    z-index: 10;
  }
  .chatbot-header-premium::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--gold-gradient);
  }

  .header-brand { display: flex; align-items: center; gap: 0.6rem; color: var(--white); }
  .header-brand .brand-icon { font-size: 1.6rem; }
  .header-brand .brand-text { font-size: 1.1rem; font-weight: 700; }
  .header-brand .brand-text span { color: var(--gold-light); }

  .header-controls { display: flex; gap: 0.3rem; flex-wrap: wrap; align-items: center; }
  .control-btn {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--white);
    padding: 0.25rem 0.6rem;
    border-radius: var(--rounded-full);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.6rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    font-family: var(--font-ui);
  }
  .control-btn:hover { background: rgba(255,255,255,0.2); transform: translateY(-2px); }
  .control-btn.featured { background: var(--gold-gradient); color: var(--dark); border-color: var(--gold); font-weight: 800; box-shadow: 0 0 16px rgba(212,175,55,0.35); }
  .control-btn.featured:hover { box-shadow: 0 4px 22px rgba(212,175,55,0.5); transform: translateY(-2px) scale(1.03); }

  .digital-clock {
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    background: rgba(255,255,255,0.08);
    padding: 0.15rem 0.6rem;
    border-radius: var(--rounded-full);
    border: 1px solid rgba(255,255,255,0.1);
    font-family: 'Courier New', monospace;
    min-width: 70px;
    text-align: center;
  }
  .digital-clock .clock-time { font-size: 0.85rem; }
  .digital-clock .clock-am-pm { font-size: 0.55rem; opacity: 0.7; }

  .chat-body-main {
    flex: 1;
    overflow-y: auto;
    padding: 0.8rem 1.2rem;
    background: var(--light-bg);
    scroll-behavior: smooth;
    min-height: 0;
  }

  .welcome-section {
    text-align: center;
    padding: 1.5rem 0 0.5rem;
    animation: fadeInUp 0.8s ease;
  }
  .welcome-section .welcome-icon { font-size: 5.5rem; margin-bottom: 0.3rem; display: inline-block; animation: floatIcon 4s ease-in-out infinite; filter: drop-shadow(0 6px 18px rgba(212,175,55,0.35)); }
  @keyframes floatIcon { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  .welcome-section h1 { font-size: 3.2rem; color: var(--primary); margin-bottom: 0.2rem; font-weight: 800; letter-spacing: -0.5px; }
  .welcome-section h1 span { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .welcome-section .welcome-sub { font-size: 1.35rem; font-weight: 500; color: var(--text-light); max-width: 640px; margin: 0.3rem auto; line-height: 1.6; }
  .welcome-section .feature-badge {
    display: inline-block;
    background: var(--gold-gradient);
    color: var(--dark);
    padding: 0.5rem 1.8rem;
    border-radius: var(--rounded-full);
    font-size: 1rem;
    font-weight: 800;
    margin-top: 0.5rem;
    box-shadow: 0 0 30px rgba(212,175,55,0.35);
    letter-spacing: 0.2px;
  }
  .welcome-section .data-status { font-size: 0.95rem; font-weight: 600; color: var(--text-light); margin-top: 0.4rem; min-height: 1.4rem; }
  .welcome-section .data-status.error { color: #c62828; font-weight: 700; }
  .welcome-section .data-status.hidden { opacity: 0; }

  .quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.9rem;
    max-width: 980px;
    margin: 1.3rem auto 0.3rem;
  }
  .quick-action-premium {
    background: var(--white);
    border: 2px solid var(--gray-medium);
    padding: 1.1rem 0.5rem;
    border-radius: var(--rounded);
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 1rem;
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    box-shadow: var(--shadow);
    min-height: 100px;
  }
  .quick-action-premium .qa-icon { font-size: 2.4rem; }
  .quick-action-premium .qa-label { font-size: 0.92rem; line-height: 1.3; font-weight: 700; }
  .quick-action-premium:hover { border-color: var(--gold); background: rgba(212,175,55,0.06); transform: translateY(-6px) scale(1.02); box-shadow: var(--shadow-hover); }
  .quick-action-premium.primary { border-color: var(--gold); background: var(--gold-gradient); color: var(--dark); box-shadow: 0 0 30px rgba(212,175,55,0.3); }
  .quick-action-premium.primary:hover { box-shadow: 0 4px 30px rgba(212,175,55,0.5); }

  .qa-section-label { font-family: var(--font-ui); font-weight: 800; text-align: center; margin: 1.2rem auto 0.4rem; max-width: 900px; }
  .qa-section-label.main-feature-label { font-size: 1.05rem; color: var(--primary); }
  .qa-section-label.additional-feature-label { font-size: 0.85rem; color: var(--gray-dark); margin-top: 1.4rem; opacity: 0.85; }

  .quick-actions-grid.main-feature-grid { grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); max-width: 720px; }
  .quick-actions-grid.additional-feature-grid { grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 0.5rem; max-width: 900px; opacity: 0.92; }
  .quick-action-premium.secondary { min-height: 72px; padding: 0.7rem 0.3rem; font-size: 0.8rem; box-shadow: var(--shadow-sm, var(--shadow)); }
  .quick-action-premium.secondary .qa-icon { font-size: 1.6rem; }
  .quick-action-premium.secondary .qa-label { font-size: 0.72rem; font-weight: 600; }

  .message {
    margin-bottom: 0.6rem;
    padding: 0.6rem 1rem;
    border-radius: 1rem;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.7;
    animation: messageSlide 0.35s ease;
    font-size: 0.95rem;
    box-shadow: var(--shadow-sm);
  }
  @keyframes messageSlide { from { opacity: 0; transform: translateY(20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .message.user {
    background: linear-gradient(135deg, #e8f0fe, #d4e0fa);
    margin-left: auto;
    border-bottom-right-radius: 0.3rem;
    color: #0d47a1;
    border: 1px solid #bbdefb;
  }
  [data-theme="dark"] .message.user { background: linear-gradient(135deg, #1a2a4a, #0d1a3a); color: #90caf9; border-color: #1a3a5a; }
  .message.bot {
    background: linear-gradient(135deg, var(--light-green), #e8f5e8);
    margin-right: auto;
    border-bottom-left-radius: 0.3rem;
    color: var(--text);
    border: 1px solid #c8e6c9;
  }
  [data-theme="dark"] .message.bot { background: linear-gradient(135deg, #1a2a1a, #0d1a0d); border-color: #2a4a2a; }
  .message.bot.error { background: linear-gradient(135deg, #ffebee, #ffcdd2); border-color: #ef9a9a; color: #c62828; }
  .message.bot.success { background: linear-gradient(135deg, #e8f5e9, #c8e6c9); border-color: #81c784; color: #2e7d32; }
  .message.bot.info { background: linear-gradient(135deg, #e3f2fd, #bbdefb); border-color: #64b5f6; color: #0d47a1; }
  .message-timestamp { font-size: 0.45rem; color: var(--gray-dark); margin-top: 0.1rem; opacity: 0.5; }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem;
    margin: 0.4rem 0;
  }
  .book-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    border: 2px solid var(--gray-light);
    text-align: center;
  }
  .book-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-hover); border-color: var(--gold); }
  .book-card .book-icon { font-size: 2rem; margin-bottom: 0.1rem; display: block; }
  .book-card .book-title { font-size: 0.75rem; font-weight: 700; color: var(--primary); line-height: 1.2; }
  .book-card .book-author { font-size: 0.6rem; color: var(--gray-dark); }
  .book-card .book-price { font-size: 0.65rem; font-weight: 700; color: var(--gold); margin: 0.1rem 0; }
  .book-card .book-actions { display: flex; gap: 0.2rem; flex-wrap: wrap; justify-content: center; margin-top: 0.15rem; }
  .book-card .book-btn { padding: 0.15rem 0.5rem; border: none; border-radius: var(--rounded-full); cursor: pointer; font-weight: 600; font-family: var(--font-ui); font-size: 0.5rem; transition: var(--transition); }
  .book-card .book-btn.preview { background: var(--gold-gradient); color: var(--dark); }
  .book-card .book-btn.preview:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .book-card .book-btn.download { background: var(--primary); color: var(--white); }
  .book-card .book-btn.download:hover { background: var(--primary-light); transform: translateY(-2px); }
  .book-card .book-badge { display: inline-block; font-size: 0.4rem; background: var(--gold-gradient); color: var(--dark); padding: 0.05rem 0.4rem; border-radius: var(--rounded-full); font-weight: 700; margin-bottom: 0.1rem; }

  .book-category-tabs {
    display: flex; gap: 0.3rem; flex-wrap: wrap; margin: 0.2rem 0 0.4rem; justify-content: center;
  }
  .book-category-tab {
    padding: 0.2rem 0.7rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded-full); background: var(--white); cursor: pointer; font-family: var(--font-ui); font-size: 0.55rem; font-weight: 600; transition: var(--transition); color: var(--text);
  }
  .book-category-tab:hover { border-color: var(--primary); background: rgba(26,71,42,0.05); }
  .book-category-tab.active { border-color: var(--gold); background: var(--gold-gradient); color: var(--dark); }

  .pdf-viewer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }
  .pdf-viewer-overlay.active { display: flex !important; animation: fadeIn 0.3s ease; }
  .pdf-viewer-overlay.fullscreen { padding: 0; }
  .pdf-viewer-overlay.fullscreen .pdf-viewer-content { width: 100vw !important; height: 100vh !important; max-width: 100vw !important; max-height: 100vh !important; border-radius: 0 !important; }

  .pdf-viewer-content {
    background: var(--white);
    border-radius: var(--rounded);
    width: 95%;
    max-width: 1100px;
    max-height: 94vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-large);
    animation: scaleIn 0.3s ease;
    overflow: hidden;
  }
  .pdf-viewer-header {
    display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1.2rem; background: var(--header-gradient); color: white; flex-shrink: 0;
  }
  .pdf-viewer-header h3 { color: white; font-size: 0.95rem; margin: 0; flex: 1; margin-right: 0.5rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pdf-viewer-header .viewer-controls { display: flex; gap: 0.3rem; align-items: center; }
  .pdf-viewer-header .viewer-btn { background: rgba(255,255,255,0.15); border: none; color: white; cursor: pointer; padding: 0.25rem 0.5rem; border-radius: var(--rounded); transition: var(--transition); font-size: 0.7rem; font-family: var(--font-ui); }
  .pdf-viewer-header .viewer-btn:hover { background: rgba(255,255,255,0.3); }
  .pdf-viewer-header .viewer-btn.close { font-size: 1rem; padding: 0.05rem 0.45rem; }
  .pdf-viewer-header .viewer-btn.close:hover { background: rgba(255,0,0,0.3); }

  .pdf-viewer-body {
    flex: 1; overflow-y: auto; padding: 0.5rem; background: #f0f0f0; min-height: 350px; max-height: 70vh; position: relative;
  }
  .pdf-viewer-body iframe { width: 100%; height: 100%; min-height: 500px; border: none; border-radius: 8px; }
  .pdf-viewer-body .pdf-loading { display: flex; justify-content: center; align-items: center; height: 300px; font-size: 1rem; color: var(--gray-dark); flex-direction: column; gap: 0.5rem; }
  .pdf-viewer-body .pdf-loading .spinner { width: 40px; height: 40px; border: 4px solid var(--gray-light); border-top: 4px solid var(--gold); border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  .pdf-viewer-footer {
    padding: 0.4rem 1rem; background: var(--gray-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.3rem; flex-shrink: 0;
  }
  .pdf-viewer-footer .page-info { font-size: 0.7rem; color: var(--gray-dark); }
  .pdf-viewer-footer .page-controls { display: flex; gap: 0.3rem; }
  .pdf-viewer-footer .page-btn { padding: 0.15rem 0.5rem; border: 1px solid var(--gray-medium); border-radius: var(--rounded); background: var(--white); cursor: pointer; font-family: var(--font-ui); font-size: 0.6rem; transition: var(--transition); }
  .pdf-viewer-footer .page-btn:hover:not(:disabled) { background: var(--primary); color: var(--white); border-color: var(--primary); }
  .pdf-viewer-footer .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .pdf-viewer-footer .zoom-controls { display: flex; gap: 0.2rem; align-items: center; }
  .pdf-viewer-footer .zoom-controls .zoom-label { font-size: 0.6rem; color: var(--gray-dark); min-width: 35px; text-align: center; }
  .pdf-viewer-footer .zoom-controls .zoom-btn { padding: 0.1rem 0.35rem; border: 1px solid var(--gray-medium); border-radius: var(--rounded); background: var(--white); cursor: pointer; font-family: var(--font-ui); font-size: 0.6rem; transition: var(--transition); }
  .pdf-viewer-footer .zoom-controls .zoom-btn:hover { background: var(--primary); color: var(--white); border-color: var(--primary); }

  .tool-card { background: var(--white); border-radius: var(--rounded); padding: 0.8rem 1rem; margin: 0.4rem 0; border-bottom: 3px solid var(--gold); box-shadow: var(--shadow-sm); }
  .tool-card .tool-title { font-size: 1rem; font-weight: 700; color: var(--primary); margin-bottom: 0.1rem; }
  .tool-card .tool-content { font-size: 0.85rem; line-height: 1.8; color: var(--text); }

  .hadith-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; border-right: 4px solid var(--gold); box-shadow: var(--shadow-sm); }
  .hadith-card .hadith-text { font-size: 0.9rem; line-height: 1.8; font-style: italic; color: var(--text); }
  .hadith-card .hadith-translation { margin: 0.1rem 0; font-size: 0.8rem; }
  .hadith-card .hadith-source { font-size: 0.65rem; color: var(--gray-dark); margin-top: 0.1rem; }
  .hadith-card .hadith-number { font-size: 0.6rem; color: var(--gold); font-weight: 600; margin-bottom: 0.1rem; }

  .knowledge-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; border-bottom: 3px solid var(--gold); box-shadow: var(--shadow-sm); }
  .knowledge-card .kb-title { font-size: 0.9rem; font-weight: 700; color: var(--primary); }
  .knowledge-card .kb-content { font-size: 0.8rem; line-height: 1.8; color: var(--text); margin-top: 0.1rem; }
  .knowledge-card .kb-source { font-size: 0.6rem; color: var(--gray-dark); margin-top: 0.1rem; }
  .knowledge-card .kb-number { font-size: 0.6rem; color: var(--gold); font-weight: 600; }

  .knowledge-nav { display: flex; gap: 0.3rem; flex-wrap: wrap; margin-top: 0.3rem; justify-content: center; }
  .knowledge-nav-btn { padding: 0.2rem 0.7rem; border: none; border-radius: var(--rounded-full); cursor: pointer; font-weight: 600; font-family: var(--font-ui); font-size: 0.65rem; transition: var(--transition); background: var(--primary); color: var(--white); }
  .knowledge-nav-btn:hover { background: var(--primary-light); transform: translateY(-2px); }
  .knowledge-nav-btn.gold { background: var(--gold-gradient); color: var(--dark); }
  .knowledge-nav-btn:disabled { opacity: 0.4; cursor: not-allowed; transform: none !important; }

  .prayer-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; box-shadow: var(--shadow-sm); }
  .prayer-card .prayer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.1rem; }
  .prayer-card .prayer-item { display: flex; justify-content: space-between; padding: 0.05rem 0.2rem; border-bottom: 1px solid var(--gray-light); }
  .prayer-card .prayer-item .name { font-weight: 600; color: var(--primary); font-size: 0.8rem; }
  .prayer-card .prayer-item .time { color: var(--text-light); font-size: 0.8rem; }

  .time-tracker-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; box-shadow: var(--shadow-sm); border-left: 4px solid var(--gold); text-align: center; }
  .time-tracker-card .time-display { font-size: 2rem; font-weight: 700; color: var(--primary); font-family: 'Courier New', monospace; }
  .time-tracker-card .time-label { font-size: 0.65rem; color: var(--gray-dark); margin-top: 0.05rem; }
  .time-tracker-card .time-controls { display: flex; gap: 0.3rem; justify-content: center; margin-top: 0.3rem; }
  .time-tracker-card .time-btn { padding: 0.2rem 0.7rem; border: 2px solid var(--primary); border-radius: var(--rounded-full); background: var(--white); cursor: pointer; font-family: var(--font-ui); font-size: 0.65rem; font-weight: 600; transition: var(--transition); color: var(--primary); }
  .time-tracker-card .time-btn:hover { background: var(--primary); color: var(--white); }
  .time-tracker-card .time-btn.gold { border-color: var(--gold); background: var(--gold-gradient); color: var(--dark); }

  .zakat-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; box-shadow: var(--shadow-sm); border-bottom: 3px solid var(--gold); }
  .zakat-card .zakat-title { font-size: 1rem; font-weight: 700; color: var(--primary); text-align: center; margin-bottom: 0.3rem; }
  .zakat-card .zakat-input-group { margin: 0.2rem 0; }
  .zakat-card .zakat-input-group label { display: block; font-weight: 600; font-size: 0.75rem; color: var(--text); }
  .zakat-card .zakat-input-group input { width: 100%; padding: 0.3rem 0.5rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded); font-family: var(--font-ui); font-size: 0.85rem; }
  .zakat-card .zakat-input-group input:focus { border-color: var(--primary); outline: none; }
  .zakat-card .zakat-result { text-align: center; padding: 0.3rem; background: var(--light-green); border-radius: var(--rounded); margin-top: 0.3rem; }
  .zakat-card .zakat-result .amount { font-size: 1.3rem; font-weight: 700; color: var(--primary); }
  .zakat-card .zakat-btn { width: 100%; padding: 0.4rem; background: var(--gold-gradient); border: none; border-radius: var(--rounded); font-weight: 700; font-family: var(--font-ui); font-size: 0.85rem; cursor: pointer; transition: var(--transition); color: var(--dark); margin-top: 0.2rem; }
  .zakat-card .zakat-btn:hover { transform: translateY(-2px); box-shadow: var(--shadow); }

  .quiz-card { background: var(--white); border-radius: var(--rounded); padding: 0.6rem 0.8rem; margin: 0.3rem 0; box-shadow: var(--shadow-sm); }
  .quiz-card .question { font-size: 0.9rem; font-weight: 600; color: var(--primary); margin-bottom: 0.2rem; }
  .quiz-card .option-btn { display: block; width: 100%; padding: 0.3rem 0.5rem; margin: 0.05rem 0; border: 2px solid var(--gray-medium); border-radius: var(--rounded); background: var(--white); cursor: pointer; transition: var(--transition); font-family: var(--font-ui); font-size: 0.8rem; text-align: left; }
  .quiz-card .option-btn:hover { border-color: var(--primary); background: rgba(26,71,42,0.05); }
  .quiz-card .option-btn.correct { border-color: #4caf50; background: #e8f5e9; }
  .quiz-card .option-btn.wrong { border-color: #f44336; background: #ffebee; }
  .quiz-card .result { text-align: center; padding: 0.3rem; font-size: 0.9rem; font-weight: 600; }
  .quiz-progress { font-size: 0.7rem; color: var(--gray-dark); text-align: center; margin-bottom: 0.2rem; }

  .home-btn-container { text-align: center; margin: 0.5rem 0; }
  .home-btn { padding: 0.4rem 1.8rem; background: var(--primary); color: var(--white); border: none; border-radius: var(--rounded-full); font-weight: 700; font-family: var(--font-ui); font-size: 0.8rem; cursor: pointer; transition: var(--transition); }
  .home-btn:hover { background: var(--primary-light); transform: translateY(-3px); box-shadow: var(--shadow); }

  .arabic-text { font-family: var(--font-arabic); font-size: var(--arabic-font-size); text-align: right; direction: rtl; padding: 0.5rem; background: var(--light-green); border-radius: var(--rounded); margin: 0.2rem 0; line-height: 2.2; word-wrap: break-word; }
  .verse-arabic { font-size: 1.3rem; text-align: right; direction: rtl; padding: 0.6rem; background: var(--light-green); border-radius: var(--rounded); border-right: 4px solid var(--gold); font-family: var(--font-arabic); line-height: 2.2; margin-bottom: 0.5rem; }
  .verse-translation { padding: 0.3rem 0.5rem; background: #f8f9fa; border-radius: var(--rounded); border-left: 4px solid var(--primary); margin-bottom: 0.5rem; }
  .tafsir-text { padding: 0.5rem; background: #fffde7; border-radius: var(--rounded); border-left: 4px solid var(--gold); line-height: 1.8; }
  .tafsir-source { margin-top: 0.5rem; font-style: italic; color: var(--gray-dark); font-size: 0.7rem; border-top: 1px solid var(--gray-medium); padding-top: 0.5rem; }

  .ayat-navigation { display: flex; gap: 0.3rem; justify-content: center; margin: 0.2rem 0; }
  .ayat-nav-btn { padding: 0.2rem 0.7rem; border: 2px solid var(--primary); border-radius: var(--rounded-full); background: var(--white); cursor: pointer; font-weight: 600; font-family: var(--font-ui); font-size: 0.7rem; transition: var(--transition); }
  .ayat-nav-btn:hover:not(:disabled) { background: var(--primary); color: var(--white); }
  .ayat-nav-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .ayat-nav-btn.gold { background: var(--gold-gradient); border-color: var(--gold); color: var(--dark); }

  .search-highlight { background: var(--gold); color: var(--dark); padding: 0.05rem 0.2rem; border-radius: 3px; font-weight: 600; }
  .search-result-item { background: var(--white); padding: 0.3rem 0.5rem; margin: 0.2rem 0; border-radius: var(--rounded); border-left: 3px solid var(--gold); box-shadow: var(--shadow-sm); }
  .search-result-item .search-result-sura { font-weight: 600; color: var(--primary); margin-bottom: 0.05rem; font-size: 0.8rem; }
  .search-result-item .search-result-text { color: var(--text); line-height: 1.6; font-size: 0.8rem; }

  .tafsir-modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 9999; justify-content: center; align-items: center; padding: 1.2rem;
  }
  .tafsir-modal-overlay.active { display: flex; animation: fadeIn 0.3s ease; }
  .tafsir-modal-content { background: var(--white); border-radius: var(--rounded); max-width: 700px; width: 100%; max-height: 85vh; display: flex; flex-direction: column; box-shadow: var(--shadow-large); animation: scaleIn 0.3s ease; overflow: hidden; }
  .tafsir-modal-header { display: flex; justify-content: space-between; align-items: center; padding: 0.6rem 1rem; background: var(--header-gradient); color: white; }
  .tafsir-modal-header h3 { color: white; font-size: 0.95rem; margin: 0; }
  .tafsir-modal-header .close-modal { background: rgba(255,255,255,0.15); border: none; color: white; cursor: pointer; font-size: 1rem; padding: 0.1rem 0.4rem; border-radius: var(--rounded); transition: var(--transition); }
  .tafsir-modal-header .close-modal:hover { background: rgba(255,255,255,0.3); transform: rotate(90deg); }
  .tafsir-modal-body { padding: 0.8rem; overflow-y: auto; flex: 1; line-height: 1.8; color: var(--text); }

  .settings-panel-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 9998; justify-content: flex-end;
  }
  .settings-panel-overlay.active { display: flex; }
  .settings-panel-content {
    background: var(--white); width: 380px; max-width: 92vw; height: 100vh; padding: 1rem; overflow-y: auto; animation: slideInRight 0.3s ease;
  }
  @keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .settings-panel-content .settings-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--gray-medium); }
  .settings-panel-content .settings-header h2 { font-size: 1.1rem; color: var(--primary); margin: 0; }
  .settings-panel-content .settings-header .close-settings { background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--gray-dark); transition: var(--transition); padding: 0.1rem; }
  .settings-panel-content .settings-header .close-settings:hover { color: var(--primary); transform: rotate(90deg); }
  .settings-panel-content .setting-group { margin-bottom: 0.8rem; }
  .settings-panel-content .setting-group label { display: block; font-weight: 600; color: var(--primary); margin-bottom: 0.1rem; font-size: 0.8rem; }
  .settings-panel-content .setting-group .range-container { display: flex; align-items: center; gap: 0.5rem; }
  .settings-panel-content .setting-group input[type="range"] { flex: 1; height: 4px; -webkit-appearance: none; appearance: none; background: var(--gray-medium); border-radius: 3px; outline: none; }
  .settings-panel-content .setting-group input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--gold-gradient); cursor: pointer; }
  .settings-panel-content .setting-group .range-value { min-width: 35px; text-align: center; font-weight: 700; color: var(--primary); font-size: 0.85rem; background: var(--light-green); padding: 0.05rem 0.3rem; border-radius: var(--rounded); }
  .settings-panel-content .setting-group select { width: 100%; padding: 0.3rem 0.4rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded); font-family: var(--font-ui); font-size: 0.8rem; background: var(--white); color: var(--text); }
  .settings-panel-content .setting-group select:focus { border-color: var(--primary); outline: none; }
  .settings-panel-content .setting-group .checkbox-group { display: flex; align-items: center; gap: 0.3rem; }
  .settings-panel-content .setting-group .checkbox-group input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--primary); cursor: pointer; }
  .settings-panel-content .setting-group .checkbox-group label { margin-bottom: 0; cursor: pointer; font-size: 0.8rem; }
  .settings-panel-content .btn-reset { width: 100%; padding: 0.4rem; background: var(--primary); color: var(--white); border: none; border-radius: var(--rounded); font-weight: 600; font-family: var(--font-ui); font-size: 0.8rem; cursor: pointer; transition: var(--transition); }
  .settings-panel-content .btn-reset:hover { background: var(--primary-light); transform: translateY(-2px); }

  .sura-panel-overlay {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); z-index: 9998; justify-content: flex-start;
  }
  .sura-panel-overlay.active { display: flex; }
  .sura-panel-content {
    background: var(--white); width: 340px; max-width: 90vw; height: 100vh; padding: 0.8rem; overflow-y: auto; animation: slideInLeft 0.3s ease;
  }
  @keyframes slideInLeft { from { transform: translateX(-100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .sura-panel-content .sura-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--gray-medium); }
  .sura-panel-content .sura-header h2 { font-size: 1rem; color: var(--primary); margin: 0; }
  .sura-panel-content .sura-header .close-sura { background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--gray-dark); transition: var(--transition); padding: 0.1rem; }
  .sura-panel-content .sura-header .close-sura:hover { color: var(--primary); transform: rotate(90deg); }
  .sura-panel-content .sura-search { width: 100%; padding: 0.3rem 0.5rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded-full); font-family: var(--font-ui); font-size: 0.75rem; background: var(--white); color: var(--text); margin-bottom: 0.5rem; }
  .sura-panel-content .sura-search:focus { border-color: var(--primary); outline: none; }
  .sura-panel-content .sura-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 0.2rem; }
  .sura-panel-content .sura-grid .sura-item { background: var(--light-green); border: 2px solid transparent; border-radius: var(--rounded); padding: 0.2rem 0.05rem; text-align: center; cursor: pointer; transition: var(--transition); font-weight: 600; color: var(--primary); font-size: 0.55rem; font-family: var(--font-ui); }
  .sura-panel-content .sura-grid .sura-item:hover { background: var(--primary); color: var(--white); transform: translateY(-2px); }
  .sura-panel-content .sura-grid .sura-item small { display: block; font-weight: 400; font-size: 0.4rem; opacity: 0.6; margin-top: 1px; }

  .quran-tafsir-tab {
    display: none;
    flex: 1;
    flex-direction: column;
    overflow-y: auto;
    padding: 1.2rem 2rem 2rem;
    background: linear-gradient(180deg, var(--light-bg) 0%, var(--light-bg) 100%);
    min-height: 0;
  }
  .quran-tafsir-tab.active { display: flex; animation: fadeIn 0.3s ease; }
  .qt-tab-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; padding-bottom: 0.8rem; border-bottom: 3px solid var(--gold); flex-shrink: 0; width: 100%; }
  .qt-tab-header h2 { font-size: 1.8rem; color: var(--primary); margin: 0; font-weight: 800; letter-spacing: -0.3px; }
  .qt-inner { width: 100%; max-width: 1200px; margin: 0 auto; flex: 1; display: flex; flex-direction: column; }
  .qt-tabs { display: flex; gap: 0.6rem; margin-bottom: 1rem; flex-shrink: 0; width: 100%; }
  .qt-tab-btn { flex: 1; padding: 0.9rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded); background: var(--white); cursor: pointer; font-family: var(--font-ui); font-weight: 700; font-size: 1.05rem; color: var(--text); transition: var(--transition); box-shadow: var(--shadow-sm, var(--shadow)); }
  .qt-tab-btn:hover { border-color: var(--gold); transform: translateY(-2px); }
  .qt-tab-btn.active { border-color: var(--gold); background: var(--gold-gradient); color: var(--dark); box-shadow: 0 4px 20px rgba(212,175,55,0.35); }
  .qt-controls { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1.2rem; flex-shrink: 0; width: 100%; background: var(--white); padding: 1rem; border-radius: var(--rounded); box-shadow: var(--shadow); }
  .qt-controls select, .qt-controls input { padding: 0.7rem 0.9rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded); font-family: var(--font-ui); font-size: 1.05rem; background: var(--white); color: var(--text); }
  .qt-controls select:focus, .qt-controls input:focus { border-color: var(--gold); outline: none; box-shadow: 0 0 0 4px rgba(212,175,55,0.15); }
  .qt-controls select { flex: 3; min-width: 220px; }
  .qt-controls input { flex: 1; min-width: 110px; }
  .qt-controls button.qt-go-btn { padding: 0.7rem 1.6rem; border: none; border-radius: var(--rounded-full); background: var(--gold-gradient); color: var(--dark); font-weight: 800; cursor: pointer; font-family: var(--font-ui); font-size: 1.05rem; transition: var(--transition); box-shadow: 0 3px 15px rgba(212,175,55,0.3); }
  .qt-controls button.qt-go-btn:hover { transform: translateY(-3px); box-shadow: 0 6px 25px rgba(212,175,55,0.4); }
  .qt-display { flex: 1; min-height: 260px; width: 100%; background: var(--white); border-radius: var(--rounded); padding: 1.5rem; box-shadow: var(--shadow); }
  .qt-empty { text-align: center; color: var(--gray-dark); font-size: 1.05rem; padding: 4rem 1rem; }
  .qt-nav { display: flex; gap: 0.6rem; margin-top: 1.2rem; flex-shrink: 0; width: 100%; }
  .qt-nav .ayat-nav-btn { flex: 1; padding: 0.8rem; font-size: 0.95rem; }
  .quran-tafsir-tab .verse-arabic { font-size: 1.8rem; line-height: 2.6; padding: 1.2rem; }
  .quran-tafsir-tab .verse-translation { font-size: 1.05rem; line-height: 1.9; padding: 0.9rem 1.1rem; }
  .quran-tafsir-tab .tafsir-text { font-size: 1rem; line-height: 2; padding: 1.1rem; }
  @media (max-width: 768px) {
    .quran-tafsir-tab { padding: 0.8rem 0.9rem 1.5rem; }
    .qt-tab-header h2 { font-size: 1.3rem; }
    .qt-tab-btn { font-size: 0.85rem; padding: 0.6rem; }
    .qt-controls select, .qt-controls input, .qt-controls button.qt-go-btn { font-size: 0.9rem; padding: 0.55rem 0.7rem; }
    .quran-tafsir-tab .verse-arabic { font-size: 1.4rem; line-height: 2.3; }
  }

  .chat-input-area {
    padding: 0.35rem 0.8rem;
    background: var(--white);
    border-top: 1px solid var(--gray-medium);
    display: flex;
    gap: 0.3rem;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 48px;
  }
  .chat-input-area .input-wrapper { flex: 1; position: relative; min-width: 70px; }
  .chat-input-area input {
    width: 100%; padding: 0.35rem 0.7rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded-full); outline: none; font-family: var(--font-ui); font-size: 0.85rem; background: var(--white); color: var(--text); transition: var(--transition);
  }
  .chat-input-area input:focus { border-color: var(--gold); box-shadow: 0 0 0 4px rgba(212,175,55,0.15); }

  .input-btn {
    padding: 0.25rem 0.6rem; border: none; border-radius: var(--rounded-full); cursor: pointer; transition: var(--transition); font-weight: 600; font-family: var(--font-ui); font-size: 0.7rem; display: flex; align-items: center; gap: 0.1rem; min-height: 32px;
  }
  .input-btn.send { background: var(--gold-gradient); color: var(--dark); box-shadow: 0 3px 15px rgba(212,175,55,0.3); }
  .input-btn.send:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 6px 25px rgba(212,175,55,0.4); }
  .input-btn.secondary { background: var(--primary); color: var(--white); }
  .input-btn.secondary:hover:not(:disabled) { background: var(--primary-light); transform: translateY(-3px); }
  .input-btn.outline { background: transparent; border: 1px solid var(--gray-medium); color: var(--text); }
  .input-btn.outline:hover:not(:disabled) { border-color: var(--primary); background: rgba(26,71,42,0.05); transform: translateY(-3px); }

  .typing-indicator {
    display: flex; gap: 0.2rem; padding: 0.25rem 0.4rem; background: var(--gray-light); border-radius: var(--rounded); align-items: center; margin-bottom: 0.4rem; max-width: 45px;
  }
  .typing-indicator span { width: 5px; height: 5px; background: var(--primary); border-radius: 50%; animation: typingBounce 1.4s infinite; }
  .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes typingBounce { 0%,60%,100% { transform: translateY(0); opacity: 0.4; } 30% { transform: translateY(-6px); opacity: 1; } }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

  @media (max-width: 768px) {
    .chatbot-header-premium { padding: 0.3rem 0.6rem; min-height: 44px; }
    .header-brand .brand-text { font-size: 0.8rem; }
    .control-btn { font-size: 0.5rem; padding: 0.1rem 0.35rem; }
    .digital-clock { font-size: 0.5rem; min-width: 55px; padding: 0.05rem 0.3rem; }
    .digital-clock .clock-time { font-size: 0.65rem; }
    .chat-body-main { padding: 0.4rem 0.6rem; }
    .chat-input-area { padding: 0.25rem 0.5rem; min-height: 40px; }
    .input-btn { font-size: 0.6rem; padding: 0.2rem 0.4rem; min-height: 26px; }
    .welcome-section h1 { font-size: 2rem; }
    .welcome-section .welcome-icon { font-size: 3.5rem; }
    .quick-actions-grid { grid-template-columns: repeat(auto-fit, minmax(85px, 1fr)); gap: 0.3rem; }
    .quick-action-premium { padding: 0.5rem 0.2rem; font-size: 0.6rem; min-height: 60px; }
    .quick-action-premium .qa-icon { font-size: 1.4rem; }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
  }
  @media (max-width: 480px) {
    .header-brand .brand-text { font-size: 0.65rem; }
    .header-brand .brand-icon { font-size: 1rem; }
    .control-btn { font-size: 0.4rem; padding: 0.05rem 0.2rem; }
    .digital-clock { font-size: 0.4rem; min-width: 45px; }
    .welcome-section h1 { font-size: 1.6rem; }
    .quick-actions-grid { grid-template-columns: 1fr 1fr; gap: 0.2rem; }
    .quick-action-premium { font-size: 0.5rem; padding: 0.35rem 0.15rem; min-height: 50px; }
    .quick-action-premium .qa-icon { font-size: 1.2rem; }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); }
  }
  ]]></b:skin>
</head>

<body>
  <!-- ===== BLOGGER SECTION ===== -->
  <b:section class='main' id='main-section' maxwidgets='1' showaddelement='yes'>
    <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
      <b:widget-settings>
        <b:widget-setting name='showDateHeader'>false</b:widget-setting>
        <b:widget-setting name='commentLabel'>$type={blogger}</b:widget-setting>
        <b:widget-setting name='style.textcolor'>#ffffff</b:widget-setting>
        <b:widget-setting name='showShareButtons'>true</b:widget-setting>
        <b:widget-setting name='showCommentLink'>true</b:widget-setting>
        <b:widget-setting name='style.urlcolor'>#ffffff</b:widget-setting>
        <b:widget-setting name='showAuthor'>true</b:widget-setting>
        <b:widget-setting name='style.linkcolor'>#ffffff</b:widget-setting>
        <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
        <b:widget-setting name='style.bgcolor'>#ffffff</b:widget-setting>
        <b:widget-setting name='timestampLabel'>&#8226;</b:widget-setting>
        <b:widget-setting name='reactionsLabel'/>
        <b:widget-setting name='showAuthorProfile'>false</b:widget-setting>
        <b:widget-setting name='style.layout'>1x1</b:widget-setting>
        <b:widget-setting name='showLabels'>true</b:widget-setting>
        <b:widget-setting name='showLocation'>false</b:widget-setting>
        <b:widget-setting name='postLabelsLabel'>Tags:</b:widget-setting>
        <b:widget-setting name='showTimestamp'>true</b:widget-setting>
        <b:widget-setting name='postsPerAd'>1</b:widget-setting>
        <b:widget-setting name='showBacklinks'>false</b:widget-setting>
        <b:widget-setting name='style.bordercolor'>#ffffff</b:widget-setting>
        <b:widget-setting name='showInlineAds'>false</b:widget-setting>
        <b:widget-setting name='showReactions'>false</b:widget-setting>
      </b:widget-settings>
      <b:includable id='main'>
        <div style='display:none;'>
          <b:loop values='data:posts' var='post'>
            <h2><data:post.title/></h2>
            <div><data:post.body/></div>
          </b:loop>
        </div>
      </b:includable>
      <b:includable id='aboutPostAuthor'>
        <div class='author-name'><a class='g-profile' expr:href='data:post.author.profileUrl' rel='author' title='author profile'><span><data:post.author.name/></span></a></div>
        <div><span class='author-desc'><data:post.author.aboutMe/></span></div>
