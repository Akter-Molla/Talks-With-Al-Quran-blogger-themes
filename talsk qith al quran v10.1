    window.selectAya = function(sura, aya) {
      var result = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      
      if (result) {
        state.currentAya = result;
        state.currentAyaIndex = state.quranData.indexOf(result);
        displayAyaResult(result);
      } else {
        addBotMessage('❌ সূরা ' + sura + ', আয়াত ' + aya + ' পাওয়া যায়নি।', 'error');
      }
    };

    function displayAyaResult(aya) {
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(aya.sura) && String(a.VerseIDAr) === String(aya.aya);
      });
      
      var idx = state.currentAyaIndex !== -1 ? state.currentAyaIndex : 0;
      var html = '<strong>সূরা ' + aya.sura + ', আয়াত ' + aya.aya + ' (সূরা ' + getSurahName(parseInt(aya.sura)) + ')</strong>';
      
      if (arabic && arabic.ayat) {
        html += '<div class="arabic-text">' + arabic.ayat + '</div>';
      }
      
      html += '<div style="padding:0.3rem 0.5rem;background:#f8f9fa;border-radius:var(--rounded);border-left:4px solid var(--primary);margin:0.2rem 0;">' + aya.text + '</div>';
      
      html += '<div class="ayat-navigation">';
      html += '<button class="ayat-nav-btn" onclick="window.navigateAyat(-1)" ' + (idx <= 0 ? 'disabled' : '') + '>◀ আগের</button>';
      html += '<button class="ayat-nav-btn gold" onclick="window.navigateAyat(1)" ' + (idx >= state.quranData.length - 1 ? 'disabled' : '') + '>পরবর্তী ▶</button>';
      html += '</div>';
      
      html += '<div style="display:flex;gap:0.2rem;flex-wrap:wrap;margin-top:0.2rem;justify-content:center;">';
      html += '<button onclick="window.showTafsir(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--primary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">📖 তাফসীর</button>';
      html += '<button onclick="window.playAudio(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--secondary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">🎧 শুনুন</button>';
      html += '<button onclick="window.copyAya(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--gold);color:#000;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">📋 কপি</button>';
      html += '</div>';
      
      html += '<div class="home-btn-container"><button class="home-btn" onclick="window.goHome()">🏠 হোমে যান</button></div>';
      addBotMessage(html, 'normal', true);
    }

    window.navigateAyat = function(direction) {
      var idx = state.currentAyaIndex;
      if (idx === -1) {
        if (state.currentAya) idx = state.quranData.indexOf(state.currentAya);
        if (idx === -1) {
          addBotMessage('❌ কোনো আয়াত নির্বাচিত নেই।', 'error');
          return;
        }
      }
      
      var newIdx = idx + direction;
      if (newIdx < 0 || newIdx >= state.quranData.length) {
        addBotMessage('❌ এই দিকে আর কোনো আয়াত নেই।', 'info');
        return;
      }
      
      state.currentAyaIndex = newIdx;
      state.currentAya = state.quranData[newIdx];
      displayAyaResult(state.currentAya);
    };

    function showTafsirModal(sura, aya) {
      var key = sura + ':' + aya;
      var tafsir = state.tafsirData[key];
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
      });
      var bengali = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      
      var html = '';
      if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
      if (bengali) html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
      if (tafsir) {
        html += '<div class="tafsir-text"><strong>তাফসীর:</strong><br>' + tafsir + '</div>';
      } else {
        html += '<div class="tafsir-text"><p>এই আয়াতের তাফসীর এখনও যোগ করা হয়নি।</p></div>';
      }
      html += '<div class="tafsir-source"><strong>উৎস:</strong> ইবনে কাসিরের তাফসীর</div>';
      
      dom.tafsirTitle.textContent = 'সূরা ' + sura + ', আয়াত ' + aya + ' - তাফসীর';
