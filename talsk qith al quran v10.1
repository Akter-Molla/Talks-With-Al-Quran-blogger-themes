    function loadSettings() {
      var saved = localStorage.getItem('quranChatSettings');
      if (saved) {
        try {
          var settings = JSON.parse(saved);
          var bengaliSize = document.getElementById('bengali-font-size');
          var arabicSize = document.getElementById('arabic-font-size');
          var audioSpeed = document.getElementById('audio-speed');
          if (settings.bengaliSize) {
            bengaliSize.value = settings.bengaliSize;
            document.getElementById('bengali-font-size-value').textContent = settings.bengaliSize + 'px';
          }
          if (settings.arabicSize) {
            arabicSize.value = settings.arabicSize;
            document.getElementById('arabic-font-size-value').textContent = settings.arabicSize + 'px';
          }
          if (settings.audioSpeed) {
            audioSpeed.value = settings.audioSpeed;
            document.getElementById('audio-speed-value').textContent = settings.audioSpeed + 'x';
          }
          document.getElementById('bengali-font-family').value = settings.bengaliFont || 'Kalpurush, Hind Siliguri, sans-serif';
          document.getElementById('arabic-font-family').value = settings.arabicFont || 'Amiri, serif';
          document.getElementById('auto-play-audio').checked = settings.autoPlayAudio || false;
          state.audioSettings.speed = parseFloat(settings.audioSpeed) || 1;
          state.audioSettings.autoPlay = settings.autoPlayAudio || false;
          state.fontSettings.bengaliSize = parseInt(settings.bengaliSize) || 18;
          state.fontSettings.arabicSize = parseInt(settings.arabicSize) || 22;
          state.fontSettings.bengaliFont = settings.bengaliFont || 'Kalpurush, Hind Siliguri, sans-serif';
          state.fontSettings.arabicFont = settings.arabicFont || 'Amiri, serif';
          applySettings();
        } catch(e) {}
      }
    }

    function saveSettings() {
      var settings = {
        bengaliSize: document.getElementById('bengali-font-size').value,
        arabicSize: document.getElementById('arabic-font-size').value,
        audioSpeed: document.getElementById('audio-speed').value,
        bengaliFont: document.getElementById('bengali-font-family').value,
        arabicFont: document.getElementById('arabic-font-family').value,
        autoPlayAudio: document.getElementById('auto-play-audio').checked
      };
      localStorage.setItem('quranChatSettings', JSON.stringify(settings));
      state.audioSettings.speed = parseFloat(settings.audioSpeed);
      state.audioSettings.autoPlay = settings.autoPlayAudio;
      state.fontSettings.bengaliSize = parseInt(settings.bengaliSize);
      state.fontSettings.arabicSize = parseInt(settings.arabicSize);
      state.fontSettings.bengaliFont = settings.bengaliFont;
      state.fontSettings.arabicFont = settings.arabicFont;
      applySettings();
    }

    function applySettings() {
      var root = document.documentElement;
      root.style.setProperty('--bengali-font-size', state.fontSettings.bengaliSize + 'px');
      root.style.setProperty('--arabic-font-size', state.fontSettings.arabicSize + 'px');
      root.style.setProperty('--font-bengali', state.fontSettings.bengaliFont);
      root.style.setProperty('--font-arabic', state.fontSettings.arabicFont);
    }

    function resetSettings() {
      document.getElementById('bengali-font-size').value = 18;
      document.getElementById('bengali-font-size-value').textContent = '18px';
      document.getElementById('arabic-font-size').value = 22;
      document.getElementById('arabic-font-size-value').textContent = '22px';
      document.getElementById('audio-speed').value = 1;
      document.getElementById('audio-speed-value').textContent = '1.0x';
      document.getElementById('bengali-font-family').value = 'Kalpurush, Hind Siliguri, sans-serif';
      document.getElementById('arabic-font-family').value = 'Amiri, serif';
      document.getElementById('auto-play-audio').checked = false;
      saveSettings();
      addBotMessage('✅ সেটিংস রিসেট করা হয়েছে!', 'success');
    }

