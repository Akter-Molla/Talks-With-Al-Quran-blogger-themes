    // ==================== BLOG POSTS ====================
    function loadBlogPosts() {
      var blogUrl = window.location.origin;
      var feedUrl = blogUrl + '/feeds/posts/default?alt=json&max-results=10';
      
      fetch(feedUrl)
        .then(function(response) {
          if (!response.ok) throw new Error('Blog feed not available');
          return response.json();
        })
        .then(function(data) {
          if (data && data.feed && data.feed.entry) {
            state.blogPosts = data.feed.entry.map(function(entry) {
              var content = entry.content ? entry.content.$t || '' : '';
              var summary = entry.summary ? entry.summary.$t || '' : '';
              content = cleanHtmlContent(content);
              summary = cleanHtmlContent(summary) || content.substring(0, 200) + '...';
              
              return {
                title: entry.title.$t || '',
                content: content,
                summary: summary,
                published: entry.published ? entry.published.$t || '' : '',
