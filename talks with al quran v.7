    function toggleBlogPostImpl(postId) {
      var post = null;
      for (var i = 0; i < state.blogPosts.length; i++) {
        var p = state.blogPosts[i];
        var pId = p.id || 'post-' + i;
        if (pId === postId) {
          post = p;
          break;
        }
      }
      if (!post) return;
      
      state.expandedPosts[postId] = !state.expandedPosts[postId];
      var messages = dom.messages.querySelectorAll('.message.bot');
      for (var j = messages.length - 1; j >= 0; j--) {
        if (messages[j].innerHTML.indexOf('সাম্প্রতিক ব্লগ পোস্ট') !== -1) {
          messages[j].remove();
          showBlogPosts();
          return;
        }
      }
      showBlogPosts();
    }

    function copyBlogPostImpl(postId) {
      var post = null;
      for (var i = 0; i < state.blogPosts.length; i++) {
        var p = state.blogPosts[i];
        var pId = p.id || 'post-' + i;
        if (pId === postId) {
          post = p;
          break;
        }
      }
      if (!post) return;
      
      var text = post.title + '\n\n' + post.content;
      navigator.clipboard.writeText(text).then(function() {
        addBotMessage('✅ পোস্ট কপি করা হয়েছে!', 'success');
      }).catch(function() {
        addBotMessage('❌ কপি করতে সমস্যা হয়েছে।', 'error');
      });
    }

    window.toggleBlogPost = toggleBlogPostImpl;
    window.copyBlogPost = copyBlogPostImpl;

