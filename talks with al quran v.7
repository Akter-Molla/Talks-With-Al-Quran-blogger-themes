    function cleanHtmlContent(html) {
      if (!html) return '';
      html = html.replace(/<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi, '');
      html = html.replace(/<style\b[^<]*(?:(?!<\/style>)<[^<]*)*<\/style>/gi, '');
      html = html.replace(/<br\s*\/?>/gi, '\n');
      html = html.replace(/<\/p>/gi, '\n\n');
      html = html.replace(/<p>/gi, '');
      html = html.replace(/<div[^>]*>/gi, '');
      html = html.replace(/<\/div>/gi, '');
      html = html.replace(/<b[^>]*>/gi, '**');
      html = html.replace(/<\/b>/gi, '**');
      html = html.replace(/<strong[^>]*>/gi, '**');
      html = html.replace(/<\/strong>/gi, '**');
      html = html.replace(/<i[^>]*>/gi, '*');
      html = html.replace(/<\/i>/gi, '*');
      html = html.replace(/<em[^>]*>/gi, '*');
      html = html.replace(/<\/em>/gi, '*');
      html = html.replace(/<[^>]*>/g, '');
      return html.trim();
    }

    // ==================== PDF VIEWER FUNCTIONS ====================
    function getDriveDirectUrl(driveId) {
      // Google Drive direct download URL
      return 'https://drive.google.com/uc?export=download&id=' + driveId;
    }

    function getDriveEmbedUrl(driveId) {
      // Google Drive embed URL for preview
      return 'https://drive.google.com/file/d/' + driveId + '/preview';
    }

    function loadPDF(pdfUrl, title) {
      state.currentPdfUrl = pdfUrl;
      dom.pdfTitle.textContent = title || 'পিডিএফ বই';
      
      // Show loading
      dom.pdfBody.innerHTML = '<div class="pdf-loading"><div class="spinner"></div><span>পিডিএফ লোড হচ্ছে...</span></div>';
      dom.pdfViewer.classList.add('active');
      document.body.style.overflow = 'hidden';

      // Set download button
      dom.pdfDownloadBtn.onclick = function() {
        window.open(pdfUrl, '_blank');
      };

      // Try to load with PDF.js
      var pdfjsLib = window['pdfjs-dist/build/pdf'];
      
      if (pdfjsLib) {
        pdfjsLib.getDocument(pdfUrl).promise.then(function(pdf) {
          state.pdfDoc = pdf;
          state.pdfTotalPages = pdf.numPages;
          state.pdfPageNum = 1;
          renderPDFPage();
        }).catch(function(error) {
          console.error('PDF load error:', error);
          // Fallback: Use Google Drive embed
          fallbackPDFViewer(pdfUrl);
        });
      } else {
        fallbackPDFViewer(pdfUrl);
      }
    }

    function renderPDFPage() {
      if (!state.pdfDoc) return;
      
      var pageNum = state.pdfPageNum;
      var pdf = state.pdfDoc;
      
      dom.pdfPageInfo.textContent = 'পৃষ্ঠা ' + pageNum + ' / ' + state.pdfTotalPages;
      dom.pdfPrevBtn.disabled = (pageNum <= 1);
      dom.pdfNextBtn.disabled = (pageNum >= state.pdfTotalPages);
      
      pdf.getPage(pageNum).then(function(page) {
        var viewport = page.getViewport({ scale: state.pdfScale });
        var canvas = document.createElement('canvas');
        var context = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        
        dom.pdfBody.innerHTML = '';
        dom.pdfBody.appendChild(canvas);
        
        var renderContext = {
          canvasContext: context,
          viewport: viewport
        };
        
        return page.render(renderContext).promise;
      }).catch(function(error) {
        console.error('Page render error:', error);
        fallbackPDFViewer(state.currentPdfUrl);
      });
    }

    function fallbackPDFViewer(pdfUrl) {
      // Use Google Drive embed as fallback
      var driveId = pdfUrl.split('id=')[1] || '';
      if (driveId) {
        var embedUrl = getDriveEmbedUrl(driveId);
        dom.pdfBody.innerHTML = '<iframe src="' + embedUrl + '" style="width:100%;height:100%;min-height:500px;border:none;"></iframe>';
        dom.pdfPageInfo.textContent = 'পিডিএফ প্রিভিউ (Google Drive)';
        dom.pdfPrevBtn.disabled = true;
        dom.pdfNextBtn.disabled = true;
      } else {
        dom.pdfBody.innerHTML = '<div class="pdf-loading"><span>⚠️ পিডিএফ লোড করা সম্ভব হচ্ছে না। ডাউনলোড বাটনে ক্লিক করুন।</span></div>';
      }
    }

    function closePDFViewer() {
      dom.pdfViewer.classList.remove('active');
      document.body.style.overflow = '';
      state.pdfDoc = null;
      state.pdfPageNum = 1;
      state.pdfTotalPages = 0;
    }

