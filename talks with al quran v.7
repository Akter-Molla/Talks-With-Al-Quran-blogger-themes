    // ==================== MESSAGE FUNCTIONS ====================
    function addMessage(text, isUser, type, isHTML) {
      isUser = isUser || false;
      type = type || 'normal';
      isHTML = isHTML || false;
      
      if (dom.welcomeSection && state.welcomeVisible) {
        dom.welcomeSection.style.display = 'none';
        state.welcomeVisible = false;
      }

      var div = document.createElement('div');
      div.className = 'message ' + (isUser ? 'user' : 'bot');
      if (!isUser && type !== 'normal') {
        div.classList.add(type);
      }
      
      if (isHTML) {
        div.innerHTML = text + '<div class="message-timestamp">' + getTimestamp() + '</div>';
      } else {
        div.textContent = text;
        div.innerHTML += '<div class="message-timestamp">' + getTimestamp() + '</div>';
      }
      
      dom.messages.appendChild(div);
      scrollToBottom();
      return div;
    }

    function addUserMessage(text) {
      return addMessage(text, true);
    }

    function addBotMessage(text, type, isHTML) {
      type = type || 'normal';
      isHTML = isHTML || false;
      return addMessage(text, false, type, isHTML);
    }

    function showTyping() {
      var div = document.createElement('div');
      div.id = 'typing-indicator';
      div.className = 'typing-indicator';
      div.innerHTML = '<span></span><span></span><span></span>';
      dom.messages.appendChild(div);
      scrollToBottom();
    }

    function removeTyping() {
      var el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    function clearChat() {
      dom.messages.innerHTML = '';
      if (dom.welcomeSection) {
        dom.welcomeSection.style.display = 'block';
        state.welcomeVisible = true;
      }
      state.currentAya = null;
      state.currentAyaIndex = -1;
      state.currentSearchResults = [];
      state.quizState = null;
      state.isHomeScreen = false;
      dom.input.value = '';
      dom.input.focus();
    }

    // ==================== LOAD QURAN DATA ====================
    async function loadQuranData() {
      try {
        setDataStatus('⏳ কুরআন ডেটা লোড হচ্ছে...', false);
        
        var [quranRes, arabicRes, tafsirRes] = await Promise.all([
          fetch("https://raw.githubusercontent.com/Akter-Molla/Quran-bot-bn/main/ayats_bn.json"),
          fetch("https://raw.githubusercontent.com/alQuranBD/Database/master/json/ayats_ar.json"),
          fetch("https://raw.githubusercontent.com/Akter-Molla/Quran-bot-bn/main/Tafseer_ibn_Kathir.json")
        ]);

        if (!quranRes.ok || !arabicRes.ok || !tafsirRes.ok) {
          throw new Error('ডেটা লোড করতে সমস্যা হয়েছে');
        }

        state.quranData = await quranRes.json();
        state.arabicData = await arabicRes.json();
        state.tafsirData = await tafsirRes.json();

        loadHadithData();
        loadKnowledgeBase();
        loadBlogPosts();

        state.dataLoaded = true;
        setDataStatus('✅ ডেটা প্রস্তুত', false);
        fadeDataStatus();

      } catch (error) {
        console.error('ডেটা লোডিং ত্রুটি:', error);
        setDataStatus('❌ ডেটা লোড করতে সমস্যা হয়েছে। পৃষ্ঠাটি রিফ্রেশ করুন।', true);
      }
    }

