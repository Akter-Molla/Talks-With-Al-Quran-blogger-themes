        html += '<div class="sura-item" data-sura="' + num + '"><strong>' + num + '</strong><br>' + name + '<small>' + count + '</small></div>';
      });
      
      dom.suraGrid.innerHTML = html;
      
      dom.suraGrid.querySelectorAll('.sura-item').forEach(function(el) {
        el.addEventListener('click', function() {
          var sura = this.getAttribute('data-sura');
          dom.input.value = sura + ':1';
          dom.input.focus();
          closeSuraPanel();
          processQuery(sura + ':1');
        });
      });
    }

    function filterSuraList(query) {
      var items = dom.suraGrid.querySelectorAll('.sura-item');
      var q = query.toLowerCase();
      items.forEach(function(item) {
        var text = item.textContent.toLowerCase();
        item.style.display = text.indexOf(q) !== -1 ? '' : 'none';
      });
    }

    function openSuraPanel() {
      dom.suraPanel.classList.add('active');
      document.body.style.overflow = 'hidden';
      dom.suraSearch.focus();
    }

    function closeSuraPanel() {
      dom.suraPanel.classList.remove('active');
      document.body.style.overflow = '';
    }

    function openSettingsPanel() {
      dom.settingsPanel.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeSettingsPanel() {
      dom.settingsPanel.classList.remove('active');
      document.body.style.overflow = '';
    }

    // ==================== GLOBAL EXPOSURE ====================
    window.selectAya = function(sura, aya) {
      var result = state.quranData.find(function(a) { return a.sura === sura && a.aya === aya; });
      if (result) {
        state.currentAya = result;
        state.currentAyaIndex = state.quranData.indexOf(result);
        displayAyaResult(result);
        if (state.audioSettings.autoPlay) {
          setTimeout(function() { playAudio(sura, aya); }, 1000);
        }
      }
    };

    window.goHome = goHome;
    window.handleQuickAction = handleQuickAction;
    window.openPDF = openPDF;

    // ==================== EVENT BINDING ====================
    function init() {
      // Start clock
      updateClock();
      setInterval(updateClock, 1000);

      loadQuranData();
      loadSettings();
      loadTheme();
      loadSuraList();

      // Event delegation for quick action buttons
      dom.messages.addEventListener('click', function(e) {
        var target = e.target.closest('.quick-action-premium');
        if (target) {
          var action = target.getAttribute('data-action');
          if (action) {
            handleQuickAction(action);
          }
        }
      });

      // Welcome section quick action buttons
      document.querySelectorAll('#welcome-section .quick-action-premium').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var action = this.getAttribute('data-action');
          handleQuickAction(action);
        });
      });

      dom.sendBtn.addEventListener('click', function() {
        processQuery(dom.input.value);
      });

      dom.input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          processQuery(dom.input.value);
        }
      });

      dom.clearBtn.addEventListener('click', clearChat);

      dom.homeBtn.addEventListener('click', function() {
        goHome();
      });

      dom.tafsirBtn.addEventListener('click', function() {
        if (state.currentAya) {
          showTafsirModal(state.currentAya.sura, state.currentAya.aya);
        } else {
          addBotMessage('⚠️ প্রথমে একটি আয়াত নির্বাচন করুন বা সূরা:আয়াত লিখুন।', 'error');
        }
      });

      dom.voiceBtn.addEventListener('click', toggleVoice);
      dom.themeToggle.addEventListener('click', toggleTheme);

      dom.suraPanelBtn.addEventListener('click', openSuraPanel);
      dom.closeSura.addEventListener('click', closeSuraPanel);
      dom.suraSearch.addEventListener('input', function(e) {
        filterSuraList(e.target.value);
      });

      dom.settingsPanelBtn.addEventListener('click', openSettingsPanel);
      dom.closeSettings.addEventListener('click', closeSettingsPanel);

      // Settings range sliders
      var bengaliRange = document.getElementById('bengali-font-size');
      var arabicRange = document.getElementById('arabic-font-size');
      var audioRange = document.getElementById('audio-speed');
      
      bengaliRange.addEventListener('input', function() {
        document.getElementById('bengali-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      arabicRange.addEventListener('input', function() {
        document.getElementById('arabic-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      audioRange.addEventListener('input', function() {
        document.getElementById('audio-speed-value').textContent = this.value + 'x';
        saveSettings();
      });

      document.querySelectorAll('#bengali-font-family, #arabic-font-family, #auto-play-audio, #show-transliteration').forEach(function(el) {
        el.addEventListener('change', saveSettings);
      });

      document.getElementById('reset-settings').addEventListener('click', resetSettings);

      dom.closeTafsir.addEventListener('click', closeTafsirModal);
      dom.tafsirModal.addEventListener('click', function(e) {
        if (e.target === dom.tafsirModal) closeTafsirModal();
      });

      // PDF Viewer controls
      dom.pdfCloseBtn.addEventListener('click', closePDFViewer);
      dom.pdfPrevBtn.addEventListener('click', function() {
        if (state.pdfDoc && state.pdfPageNum > 1) {
          state.pdfPageNum--;
          renderPDFPage();
        }
      });
      dom.pdfNextBtn.addEventListener('click', function() {
        if (state.pdfDoc && state.pdfPageNum < state.pdfTotalPages) {
          state.pdfPageNum++;
          renderPDFPage();
        }
      });
      dom.pdfFullscreenBtn.addEventListener('click', function() {
        if (dom.pdfViewer.requestFullscreen) {
          dom.pdfViewer.requestFullscreen();
        }
      });
      dom.pdfViewer.addEventListener('click', function(e) {
        if (e.target === dom.pdfViewer) {
          closePDFViewer();
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeTafsirModal();
          closeSuraPanel();
          closeSettingsPanel();
          closePDFViewer();
        }
      });

      dom.input.focus();
      console.log('🤖 কুরআন বট ৫.০ লোড হয়েছে!');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
  //]]>
  </script>
</body>
</html>
