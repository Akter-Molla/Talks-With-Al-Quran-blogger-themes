    function startQuiz() {
      var questions = [
        { q: "কুরআনের প্রথম সূরার নাম কি?", o: ["আল-ফাতিহা","আল-বাকারা","আল-ইখলাস","ইয়াসিন"], c: 0, e: "আল-ফাতিহা অর্থ 'উন্মোচনকারী', ৭ আয়াত।" },
        { q: "কুরআনে মোট কয়টি সূরা আছে?", o: ["114","100","125","99"], c: 0, e: "মোট ১১৪টি সূরা, ৮৬টি মাক্কী, ২৮টি মাদানী।" },
        { q: "আয়াতুল কুরসি কোন সূরায় আছে?", o: ["সূরা বাকারা","সূরা ইখলাস","সূরা ফাতিহা","সূরা ইয়াসিন"], c: 0, e: "সূরা বাকারার ২৫৫ নম্বর আয়াত।" },
        { q: "ইসলামের ৫টি স্তম্ভের মধ্যে প্রথমটি কি?", o: ["কালিমা","সালাত","জাকাত","রোজা"], c: 0, e: "কালিমা শাহাদাত হলো ইসলামের প্রথম স্তম্ভ।" }
      ];
      
      state.quizState = {
        questions: questions,
        current: 0,
        score: 0,
        total: questions.length
      };
      
      askQuizQuestion();
    }

    function askQuizQuestion() {
      if (!state.quizState) return;
      
      if (state.quizState.current >= state.quizState.total) {
        showQuizResult();
        return;
      }
      
      var q = state.quizState.questions[state.quizState.current];
      var html = '<div class="quiz-card">';
      html += '<div class="quiz-progress">🧠 প্রশ্ন ' + (state.quizState.current + 1) + '/' + state.quizState.total + '</div>';
      html += '<div class="question">' + q.q + '</div>';
      q.o.forEach(function(opt, i) {
        var letter = String.fromCharCode(65 + i);
        html += '<button class="option-btn" onclick="window.answerQuizOption(' + i + ')">' + letter + '. ' + opt + '</button>';
      });
      html += '</div>';
      addBotMessage(html, 'normal', true);
    }

    function answerQuizOptionImpl(selected) {
      if (!state.quizState) return;
      
      var q = state.quizState.questions[state.quizState.current];
      var correct = selected === q.c;
      
      if (correct) {
        state.quizState.score++;
        addBotMessage('✅ সঠিক উত্তর! 🎉<br><br>' + q.e, 'success');
      } else {
        addBotMessage('❌ ভুল উত্তর! সঠিক: ' + q.o[q.c] + '<br><br>' + q.e, 'error');
      }
      
      state.quizState.current++;
      setTimeout(askQuizQuestion, 2000);
    }

    function showQuizResult() {
      if (!state.quizState) return;
      
      var pct = Math.round((state.quizState.score / state.quizState.total) * 100);
      var msg = pct >= 80 ? '🎉 অসাধারণ!' : pct >= 60 ? '👍 ভালো!' : '📚 আরও পড়ুন!';
      
      var html = '<div class="quiz-card">';
      html += '<div class="result">📊 কুইজ রেজাল্ট</div>';
      html += '<div style="text-align:center;padding:0.15rem 0;">স্কোর: ' + state.quizState.score + '/' + state.quizState.total + '</div>';
      html += '<div style="text-align:center;padding:0.15rem 0;">পার্সেন্টেজ: ' + pct + '%</div>';
      html += '<div style="text-align:center;padding:0.15rem 0;">' + msg + '</div>';
      html += '<button onclick="window.startQuiz()" style="display:block;width:100%;padding:0.3rem;background:var(--gold-gradient);border:none;border-radius:var(--rounded);cursor:pointer;font-weight:600;font-family:var(--font-ui);color:var(--dark);font-size:0.8rem;">🔄 আবার চেষ্টা করুন</button>';
      html += '</div>';
      html += '<div class="home-btn-container"><button class="home-btn" onclick="window.goHome()">🏠 হোমে যান</button></div>';
      addBotMessage(html, 'normal', true);
      
      state.quizState = null;
    }

    window.answerQuizOption = answerQuizOptionImpl;
    window.startQuiz = startQuiz;

