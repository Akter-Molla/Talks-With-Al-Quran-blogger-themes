    // ==================== QUERY PROCESSING ====================
    function processQuery(query) {
      if (state.isLoading) return;
      
      var trimmed = query.trim();
      if (!trimmed) {
        addBotMessage('❌ অনুগ্রহ করে একটি প্রশ্ন লিখুন।', 'error');
        return;
      }

      addUserMessage(trimmed);
      dom.input.value = '';
      dom.input.focus();

      showTyping();
      state.isLoading = true;

      setTimeout(function() {
        removeTyping();
        state.isLoading = false;

        try {
          var normalized = convertNumbers(trimmed);
          var lowerQuery = trimmed.toLowerCase();
          
          if (/^(\d+)[:\.\/,](\d+)$/.test(normalized) || /^সূরা\s*(\d+)\s*আয়াত\s*(\d+)$/i.test(normalized)) {
            handleSurahAya(normalized);
          } else if (lowerQuery.indexOf('হাদিস') !== -1 || lowerQuery.indexOf('hadith') !== -1 || lowerQuery.indexOf('হাদীস') !== -1) {
            showRandomHadith();
          } else if (lowerQuery.indexOf('ব্লগ') !== -1 || lowerQuery.indexOf('blog') !== -1 || lowerQuery.indexOf('পোস্ট') !== -1) {
            showBlogPosts();
          } else if (lowerQuery.indexOf('বই') !== -1 || lowerQuery.indexOf('book') !== -1 || lowerQuery.indexOf('পিডিএফ') !== -1 || lowerQuery.indexOf('pdf') !== -1) {
            showBookCorner();
          } else if (lowerQuery.indexOf('সালাত') !== -1 || lowerQuery.indexOf('নামাজ') !== -1 || lowerQuery.indexOf('ওয়াক্ত') !== -1 || lowerQuery.indexOf('prayer') !== -1) {
            showPrayerTimes();
          } else if (lowerQuery.indexOf('কুইজ') !== -1 || lowerQuery.indexOf('quiz') !== -1 || lowerQuery.indexOf('প্রশ্ন') !== -1) {
            startQuiz();
          } else if (lowerQuery.indexOf('জ্ঞান') !== -1 || lowerQuery.indexOf('knowledge') !== -1 || lowerQuery.indexOf('শিখা') !== -1) {
            showKnowledgeBase();
          } else if (lowerQuery.indexOf('গাইড') !== -1 || lowerQuery.indexOf('guide') !== -1 || lowerQuery.indexOf('সাহায্য') !== -1 || lowerQuery.indexOf('help') !== -1) {
            showGuide();
          } else if (lowerQuery.indexOf('হোম') !== -1 || lowerQuery.indexOf('home') !== -1 || lowerQuery.indexOf('মেনু') !== -1) {
            goHome();
          } else if (trimmed.length >= 2) {
            handleKeywordSearch(trimmed);
          } else if (/সালাম|assalam|hello|hi|হ্যালো|নমস্কার|আদাব/i.test(trimmed)) {
            handleGreeting();
          } else {
            addBotMessage('🤔 "' + trimmed + '" - আমি এই প্রশ্নের উত্তর দিতে পারছি না।\n\n"হোম" লিখে মেনু দেখুন বা "গাইড" লিখে সাহায্য নিন।', 'info');
          }
        } catch (error) {
          console.error('Query error:', error);
          addBotMessage('❌ প্রক্রিয়াকরণে সমস্যা হয়েছে। আবার চেষ্টা করুন।', 'error');
        }
      }, 800);
    }

    // ==================== SURAH AYA HANDLER ====================
    function handleSurahAya(query) {
      var match = query.match(/^(\d+)[:\.\/,](\d+)$/) || 
                   query.match(/^সূরা\s*(\d+)\s*আয়াত\s*(\d+)$/i);
      
      if (match) {
        var sura = match[1];
        var aya = match[2];
        var result = state.quranData.find(function(a) { return a.sura === sura && a.aya === aya; });
        
        if (result) {
          state.currentAya = result;
          state.currentAyaIndex = state.quranData.indexOf(result);
          displayAyaResult(result);
          
          if (state.audioSettings.autoPlay) {
            setTimeout(function() { playAudio(sura, aya); }, 1000);
          }
        } else {
          addBotMessage('❌ সূরা ' + sura + ', আয়াত ' + aya + ' পাওয়া যায়নি।', 'error');
        }
      }
    }

    // ==================== KEYWORD SEARCH ====================
    function handleKeywordSearch(query) {
      var words = query.toLowerCase().split(/\s+/);
      var results = [];
      
      state.quranData.forEach(function(aya) {
        var text = aya.text.toLowerCase();
        var matchCount = 0;
        var highlighted = aya.text;
        
        words.forEach(function(word) {
          var regex = new RegExp(word, 'gi');
          var matches = text.match(regex);
          if (matches) {
            matchCount += matches.length;
            highlighted = highlighted.replace(regex, function(m) { return '<span class="search-highlight">' + m + '</span>'; });
          }
        });
        
        if (matchCount > 0) {
          results.push({ sura: aya.sura, aya: aya.aya, text: aya.text, matchCount: matchCount, highlighted: highlighted });
        }
      });
      
      results.sort(function(a, b) { return b.matchCount - a.matchCount; });
      var top = results.slice(0, 8);
      state.currentSearchResults = top;
      
      if (top.length === 0) {
        addBotMessage('❌ "' + query + '" এর জন্য কোন ফলাফল পাওয়া যায়নি।', 'error');
        return;
      }
      
      var html = '<strong>"' + query + '" এর জন্য ' + top.length + 'টি আয়াত পাওয়া গেছে</strong><br><br>';
      top.forEach(function(r, i) {
        html += '<div class="search-result-item"><div class="search-result-sura">' + (i+1) + '. সূরা ' + r.sura + ', আয়াত ' + r.aya + ' (' + r.matchCount + 'টি মিল)</div><div class="search-result-text">' + r.highlighted + '</div><button onclick="window.selectAyaFromSearch(' + i + ')" style="margin-top:4px;background:var(--gold);color:#000;border:none;padding:3px 10px;border-radius:5px;cursor:pointer;font-weight:600;font-size:0.75rem;">নির্বাচন</button></div>';
      });
      
      addBotMessage(html, 'normal', true);
    }

    window.selectAyaFromSearch = function(index) {
      var result = state.currentSearchResults[index];
      if (result) {
        var aya = state.quranData.find(function(a) { return a.sura === result.sura && a.aya === result.aya; });
        if (aya) {
          state.currentAya = aya;
          state.currentAyaIndex = state.quranData.indexOf(aya);
          displayAyaResult(aya);
        }
      }
    };

    // ==================== DISPLAY AYA RESULT ====================
    function displayAyaResult(aya) {
      var arabic = state.arabicData.find(function(a) { return a.sura === aya.sura && a.VerseIDAr === aya.aya; });
      var currentIndex = state.currentAyaIndex !== -1 ? state.currentAyaIndex : 0;
      
      var html = '<strong>সূরা ' + aya.sura + ', আয়াত ' + aya.aya + ' (সূরা ' + getSurahName(parseInt(aya.sura)) + ')</strong>';
      
      if (arabic && arabic.ayat) {
        html += '<div class="arabic-text" style="font-family:var(--font-arabic);font-size:var(--arabic-font-size);text-align:right;direction:rtl;padding:0.6rem;background:var(--light-green);border-radius:var(--rounded);margin:0.3rem 0;line-height:2.2;">' + arabic.ayat + '</div>';
      }
      
      html += '<div style="padding:0.4rem 0.6rem;background:#f8f9fa;border-radius:var(--rounded);border-left:4px solid var(--primary);margin:0.3rem 0;">' + aya.text + '</div>';
      
      html += '<div class="ayat-navigation">';
      html += '<button class="ayat-nav-btn" onclick="window.navigateAyat(-1)" ' + (currentIndex <= 0 ? 'disabled' : '') + '>◀ আগের</button>';
      html += '<button class="ayat-nav-btn gold" onclick="window.navigateAyat(1)" ' + (currentIndex >= state.quranData.length - 1 ? 'disabled' : '') + '>পরবর্তী ▶</button>';
      html += '</div>';
      
      html += '<div style="display:flex;gap:0.25rem;flex-wrap:wrap;margin-top:0.3rem;justify-content:center;">';
      html += '<button onclick="window.showTafsir(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--primary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.7rem;">📖 তাফসীর</button>';
      html += '<button onclick="window.playAudio(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--secondary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.7rem;">🎧 শুনুন</button>';
      html += '<button onclick="window.copyAya(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--gold);color:#000;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.7rem;">📋 কপি</button>';
      html += '</div>';
      
      html += '<div class="home-btn-container"><button class="home-btn" onclick="window.goHome()">🏠 হোমে যান</button></div>';
      
      addBotMessage(html, 'normal', true);
    }

    window.navigateAyat = function(direction) {
      var currentIndex = state.currentAyaIndex;
      if (currentIndex === -1) {
        if (state.currentAya) {
          currentIndex = state.quranData.indexOf(state.currentAya);
        }
        if (currentIndex === -1) {
          addBotMessage('❌ নেভিগেট করার জন্য কোনো আয়াত নির্বাচিত নেই।', 'error');
          return;
        }
      }
      
      var newIndex = currentIndex + direction;
      if (newIndex < 0 || newIndex >= state.quranData.length) {
        addBotMessage('❌ এই দিকে আর কোনো আয়াত নেই।', 'info');
        return;
      }
      
      state.currentAyaIndex = newIndex;
      state.currentAya = state.quranData[newIndex];
      displayAyaResult(state.currentAya);
    };

    // ==================== TAFSIR ====================
    function showTafsirModal(sura, aya) {
