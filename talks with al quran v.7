<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  
  <!-- Theme Information -->
  <meta content='Al Quran Pro - Islamic Chatbot Theme' name='theme-name'/>
  <meta content='Akter Molla' name='theme-author'/>
  <meta content='5.0' name='theme-version'/>
  
  <!-- Fonts -->
  <link href='https://fonts.maateen.me/kalpurush/font.css' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Lateef:wght@400;700&amp;display=swap' rel='stylesheet'/>
  
  <!-- PDF.js for PDF Preview -->
  <script src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js'/>
  <link href='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf-viewer.min.css' rel='stylesheet'/>
  
  <b:skin><![CDATA[
  /* ============================================
     CSS VARIABLES
     ============================================ */
  :root {
    --primary: #1a472a;
    --primary-light: #2d7a4a;
    --primary-dark: #0f2e1a;
    --secondary: #2d5a27;
    --accent: #8e6e53;
    --gold: #c19a3f;
    --gold-light: #d4b15f;
    --gold-gradient: linear-gradient(135deg, #c19a3f, #e8c96a);
    --light-green: #e8f5e8;
    --white: #ffffff;
    --dark: #1a1a1a;
    --text: #2c3e2c;
    --text-light: #5a6b5a;
    --light-bg: #f8fbf8;
    --gray-light: #f5f5f5;
    --gray-medium: #e0e0e0;
    --gray-dark: #757575;
    
    --bengali-font-size: 18px;
    --arabic-font-size: 20px;
    --ui-font-size: 16px;
    
    --font-bengali: 'Kalpurush', 'Hind Siliguri', sans-serif;
    --font-arabic: 'Amiri', 'Scheherazade New', serif;
    --font-ui: 'Hind Siliguri', sans-serif;
    
    --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
    --shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.12);
    --shadow-large: 0 16px 48px rgba(0, 0, 0, 0.15);
    --shadow-glow: 0 0 40px rgba(193, 154, 63, 0.2);
    
    --rounded: 12px;
    --rounded-lg: 20px;
    --rounded-xl: 28px;
    --rounded-full: 50px;
    
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    --transition-slow: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    --transition-bounce: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    
    --header-gradient: linear-gradient(135deg, #1a472a, #2d7a4a);
  }

  /* Dark Mode */
  [data-theme="dark"] {
    --primary: #3a9a5f;
    --primary-light: #4ab070;
    --primary-dark: #1a3a2a;
    --secondary: #4a8a5f;
    --accent: #b8957a;
    --gold: #e8c96a;
    --gold-light: #f0d97a;
    --light-green: #1a2a1a;
    --white: #1e1e1e;
    --dark: #f0f0f0;
    --text: #e0e0e0;
    --text-light: #b0b0b0;
    --light-bg: #121212;
    --gray-light: #2a2a2a;
    --gray-medium: #3a3a3a;
    --gray-dark: #a0a0a0;
    --shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    --shadow-hover: 0 8px 32px rgba(0, 0, 0, 0.4);
    --shadow-large: 0 16px 48px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 40px rgba(232, 201, 106, 0.08);
  }

  /* ============================================
     RESET & BASE
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-bengali);
    color: var(--text);
    background: var(--light-bg);
    line-height: 1.8;
    overflow: hidden;
    font-size: var(--bengali-font-size);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.4s ease, color 0.4s ease;
    height: 100vh;
    width: 100vw;
  }

  ::-webkit-scrollbar {
    width: 5px;
    height: 5px;
  }
  ::-webkit-scrollbar-track {
    background: var(--gray-light);
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--gold-gradient);
    border-radius: 10px;
  }

  /* ============================================
     FULL PAGE CHATBOT
     ============================================ */
  .chatbot-fullpage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    background: var(--white);
    z-index: 1000;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
  }

  .chatbot-header-premium {
    background: var(--header-gradient);
    padding: 0.4rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    min-height: 50px;
    flex-shrink: 0;
    position: relative;
    z-index: 10;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.12);
  }

  .chatbot-header-premium::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-gradient);
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--white);
  }

  .header-brand .brand-icon {
    font-size: 1.3rem;
  }

  .header-brand .brand-text {
    font-size: 1rem;
    font-weight: 700;
  }

  .header-brand .brand-text span {
    color: var(--gold-light);
  }

  .header-controls {
    display: flex;
    gap: 0.2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .control-btn {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--white);
    padding: 0.2rem 0.5rem;
    border-radius: var(--rounded-full);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.65rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    backdrop-filter: blur(8px);
    font-family: var(--font-ui);
  }

  .control-btn:hover {
    background: rgba(255,255,255,0.25);
    transform: translateY(-1px);
  }

  .control-btn.active {
    background: var(--gold-gradient);
    color: var(--dark);
    border-color: var(--gold);
  }

  /* Digital Clock */
  .digital-clock {
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    background: rgba(255,255,255,0.1);
    padding: 0.15rem 0.5rem;
    border-radius: var(--rounded-full);
    border: 1px solid rgba(255,255,255,0.15);
    font-family: 'Courier New', monospace;
    min-width: 80px;
    text-align: center;
  }

  .digital-clock .clock-time {
    font-size: 0.85rem;
  }

  .digital-clock .clock-am-pm {
    font-size: 0.6rem;
    opacity: 0.8;
  }

  .chat-body-main {
    flex: 1;
    overflow-y: auto;
    padding: 0.6rem 1rem;
    background: var(--light-bg);
    scroll-behavior: smooth;
    min-height: 0;
  }

  .chat-body-main::-webkit-scrollbar {
    width: 5px;
  }
  .chat-body-main::-webkit-scrollbar-track {
    background: var(--gray-light);
  }
  .chat-body-main::-webkit-scrollbar-thumb {
    background: var(--gold-gradient);
    border-radius: 10px;
  }

  /* Welcome Section */
  .welcome-section {
    text-align: center;
    padding: 0.5rem 0 1rem;
    animation: fadeInUp 0.6s ease;
  }

  .welcome-section .welcome-icon {
    font-size: 3.5rem;
    margin-bottom: 0.3rem;
    display: inline-block;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .welcome-section h1 {
    font-size: 2.2rem;
    color: var(--primary);
    margin-bottom: 0.15rem;
    font-weight: 700;
  }

  .welcome-section h1 span {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .welcome-section p {
    font-size: 1.1rem;
    color: var(--text-light);
    max-width: 500px;
    margin: 0 auto 0.15rem;
  }

  .welcome-section .feature-badge {
    display: inline-block;
    background: var(--gold-gradient);
    color: var(--dark);
    padding: 0.15rem 0.8rem;
    border-radius: var(--rounded-full);
    font-size: 0.8rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .welcome-section .data-status {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-top: 0.3rem;
    min-height: 1rem;
    transition: opacity 0.4s ease;
  }

  .welcome-section .data-status.error {
    color: #c62828;
    font-weight: 600;
  }

  .welcome-section .data-status.hidden {
    opacity: 0;
  }

  .quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.4rem;
    max-width: 850px;
    margin: 0.8rem auto 0;
  }

  .quick-action-premium {
    background: var(--white);
    border: 2px solid var(--gray-medium);
    padding: 0.5rem 0.6rem;
    border-radius: var(--rounded);
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.75rem;
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    box-shadow: var(--shadow-sm);
  }

  .quick-action-premium:hover {
    border-color: var(--primary);
    background: rgba(26, 71, 42, 0.05);
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .quick-action-premium .qa-icon {
    font-size: 1rem;
  }

  .quick-action-premium.primary {
    border-color: var(--gold);
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .quick-action-premium.primary:hover {
    box-shadow: 0 4px 15px rgba(193, 154, 63, 0.3);
  }

  /* Messages */
  .message {
    margin-bottom: 0.6rem;
    padding: 0.5rem 0.8rem;
    border-radius: 1rem;
    max-width: 92%;
    word-wrap: break-word;
    line-height: 1.7;
    position: relative;
    animation: messageSlide 0.3s ease;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  @keyframes messageSlide {
    from {
      opacity: 0;
      transform: translateY(15px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .message:hover {
    box-shadow: var(--shadow);
  }

  .message.user {
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    margin-left: auto;
    border-bottom-right-radius: 0.3rem;
    color: #0d47a1;
    border: 1px solid #90caf9;
  }

  [data-theme="dark"] .message.user {
    background: linear-gradient(135deg, #1a2a4a, #0d1a3a);
    color: #90caf9;
    border-color: #1a3a5a;
  }

  .message.bot {
    background: linear-gradient(135deg, var(--light-green), #e8f5e8);
    margin-right: auto;
    border-bottom-left-radius: 0.3rem;
    color: var(--text);
    border: 1px solid #c8e6c9;
  }

  [data-theme="dark"] .message.bot {
    background: linear-gradient(135deg, #1a2a1a, #0d1a0d);
    border-color: #2a4a2a;
  }

  .message.bot.error {
    background: linear-gradient(135deg, #ffebee, #ffcdd2);
    border-color: #ef9a9a;
    color: #c62828;
  }

  .message.bot.success {
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    border-color: #81c784;
    color: #2e7d32;
  }

  .message.bot.info {
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    border-color: #64b5f6;
    color: #0d47a1;
  }

  .message-timestamp {
    font-size: 0.5rem;
    color: var(--gray-dark);
    margin-top: 0.15rem;
    opacity: 0.6;
  }

  /* ============================================
     BOOK CORNER - PDF GRID
     ============================================ */
  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.8rem;
    margin: 0.5rem 0;
  }

  .book-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.8rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    border: 2px solid var(--gray-light);
    text-align: center;
    cursor: pointer;
  }

  .book-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--gold);
  }

  .book-card .book-icon {
    font-size: 2.5rem;
    margin-bottom: 0.3rem;
    display: block;
  }

  .book-card .book-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.2rem;
    line-height: 1.3;
  }

  .book-card .book-author {
    font-size: 0.7rem;
    color: var(--gray-dark);
    margin-bottom: 0.3rem;
  }

  .book-card .book-actions {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .book-card .book-btn {
    padding: 0.2rem 0.6rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    transition: var(--transition);
  }

  .book-card .book-btn.preview {
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .book-card .book-btn.preview:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .book-card .book-btn.download {
    background: var(--primary);
    color: var(--white);
  }

  .book-card .book-btn.download:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  /* ============================================
     PDF VIEWER MODAL
     ============================================ */
  .pdf-viewer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(10px);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .pdf-viewer-overlay.active {
    display: flex;
    animation: fadeIn 0.3s ease;
  }

  .pdf-viewer-content {
    background: var(--white);
    border-radius: var(--rounded-xl);
    width: 95%;
    max-width: 1000px;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-large);
    animation: scaleIn 0.3s ease;
    overflow: hidden;
  }

  .pdf-viewer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1.2rem;
    background: var(--header-gradient);
    color: white;
    flex-shrink: 0;
  }

  .pdf-viewer-header h3 {
    color: white;
    font-size: 1rem;
    margin: 0;
    flex: 1;
    margin-right: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdf-viewer-header .viewer-controls {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .pdf-viewer-header .viewer-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.3rem 0.6rem;
    border-radius: var(--rounded);
    transition: var(--transition);
    font-size: 0.8rem;
    font-family: var(--font-ui);
  }

  .pdf-viewer-header .viewer-btn:hover {
    background: rgba(255,255,255,0.3);
  }

  .pdf-viewer-header .viewer-btn.close {
    font-size: 1.2rem;
    padding: 0.1rem 0.5rem;
  }

  .pdf-viewer-header .viewer-btn.close:hover {
    background: rgba(255,0,0,0.3);
  }

  .pdf-viewer-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
    background: #f0f0f0;
    min-height: 300px;
    max-height: 70vh;
    position: relative;
  }

  .pdf-viewer-body canvas {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    box-shadow: var(--shadow);
    border-radius: var(--rounded-sm);
  }

  .pdf-viewer-body .pdf-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 200px;
    font-size: 1.1rem;
    color: var(--gray-dark);
    flex-direction: column;
    gap: 0.5rem;
  }

  .pdf-viewer-body .pdf-loading .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--gray-light);
    border-top: 4px solid var(--gold);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .pdf-viewer-footer {
    padding: 0.5rem 1rem;
    background: var(--gray-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    flex-shrink: 0;
  }

  .pdf-viewer-footer .page-info {
    font-size: 0.8rem;
    color: var(--gray-dark);
  }

  .pdf-viewer-footer .page-controls {
    display: flex;
    gap: 0.3rem;
  }

  .pdf-viewer-footer .page-btn {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--gray-medium);
    border-radius: var(--rounded);
    background: var(--white);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    transition: var(--transition);
  }

  .pdf-viewer-footer .page-btn:hover:not(:disabled) {
    background: var(--primary);
    color: var(--white);
    border-color: var(--primary);
  }

  .pdf-viewer-footer .page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* ============================================
     OTHER CARDS
     ============================================ */
  .tool-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.8rem 1rem;
    margin: 0.4rem 0;
    border-bottom: 3px solid var(--gold);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .tool-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .tool-card .tool-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 0.2rem;
  }

  .tool-card .tool-content {
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--text);
  }

  .hadith-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem 0.8rem;
    margin: 0.4rem 0;
    border-right: 4px solid var(--gold);
    box-shadow: var(--shadow-sm);
  }

  .hadith-card .hadith-text {
    font-size: 0.9rem;
    line-height: 1.8;
    font-style: italic;
    color: var(--text);
  }

  .hadith-card .hadith-translation {
    margin: 0.15rem 0;
    font-size: 0.8rem;
  }

  .hadith-card .hadith-source {
    font-size: 0.65rem;
    color: var(--gray-dark);
    margin-top: 0.15rem;
  }

  .hadith-card .hadith-number {
    font-size: 0.6rem;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .knowledge-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem 0.8rem;
    margin: 0.4rem 0;
    border-bottom: 3px solid var(--gold);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .knowledge-card:hover {
    box-shadow: var(--shadow-hover);
  }

  .knowledge-card .kb-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary);
  }

  .knowledge-card .kb-content {
    font-size: 0.8rem;
    line-height: 1.8;
    color: var(--text);
    margin-top: 0.15rem;
  }

  .knowledge-card .kb-source {
    font-size: 0.6rem;
    color: var(--gray-dark);
    margin-top: 0.15rem;
  }

  .knowledge-card .kb-number {
    font-size: 0.6rem;
    color: var(--gold);
    font-weight: 600;
  }

  .knowledge-nav {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
    justify-content: center;
  }

  .knowledge-nav-btn {
    padding: 0.25rem 0.7rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    transition: var(--transition);
    background: var(--primary);
    color: var(--white);
  }

  .knowledge-nav-btn:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  .knowledge-nav-btn.gold {
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .knowledge-nav-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none !important;
  }

  .prayer-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem 0.8rem;
    margin: 0.4rem 0;
    box-shadow: var(--shadow-sm);
  }

  .prayer-card .prayer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem;
  }

  .prayer-card .prayer-item {
    display: flex;
    justify-content: space-between;
    padding: 0.1rem 0.25rem;
    border-bottom: 1px solid var(--gray-light);
  }

  .prayer-card .prayer-item .name {
    font-weight: 600;
    color: var(--primary);
    font-size: 0.8rem;
  }

  .prayer-card .prayer-item .time {
    color: var(--text-light);
    font-size: 0.8rem;
  }

  .quiz-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem 0.8rem;
    margin: 0.4rem 0;
    box-shadow: var(--shadow-sm);
  }

  .quiz-card .question {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.3rem;
  }

  .quiz-card .option-btn {
    display: block;
    width: 100%;
    padding: 0.3rem 0.5rem;
    margin: 0.1rem 0;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded);
    background: var(--white);
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    text-align: left;
  }

  .quiz-card .option-btn:hover {
    border-color: var(--primary);
    background: rgba(26, 71, 42, 0.05);
  }

  .quiz-card .option-btn.correct {
    border-color: #4caf50;
    background: #e8f5e9;
  }

  .quiz-card .option-btn.wrong {
    border-color: #f44336;
    background: #ffebee;
  }

  .quiz-card .result {
    text-align: center;
    padding: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .quiz-progress {
    font-size: 0.7rem;
    color: var(--gray-dark);
    text-align: center;
    margin-bottom: 0.3rem;
  }

  .typing-indicator {
    display: flex;
    gap: 0.25rem;
    padding: 0.3rem 0.5rem;
    background: var(--gray-light);
    border-radius: var(--rounded);
    align-items: center;
    margin-bottom: 0.5rem;
    max-width: 50px;
  }

  .typing-indicator span {
    width: 5px;
    height: 5px;
    background: var(--primary);
    border-radius: 50%;
    animation: typingBounce 1.4s infinite;
  }

  .typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typingBounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30% { transform: translateY(-6px); opacity: 1; }
  }

  .chat-input-area {
    padding: 0.4rem 1rem;
    background: var(--white);
    border-top: 1px solid var(--gray-medium);
    display: flex;
    gap: 0.3rem;
    align-items: center;
    flex-wrap: wrap;
    flex-shrink: 0;
    min-height: 48px;
  }

  .chat-input-area .input-wrapper {
    flex: 1;
    position: relative;
    min-width: 80px;
  }

  .chat-input-area input {
    width: 100%;
    padding: 0.4rem 0.7rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded-full);
    outline: none;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    background: var(--white);
    color: var(--text);
    transition: var(--transition);
  }

  .chat-input-area input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(26, 71, 42, 0.08);
  }

  .chat-input-area input:disabled {
    background: var(--gray-light);
    cursor: not-allowed;
  }

  .chat-input-area .input-actions {
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .input-btn {
    padding: 0.3rem 0.6rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    transition: var(--transition);
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    min-height: 30px;
  }

  .input-btn.send {
    background: var(--gold-gradient);
    color: var(--dark);
    box-shadow: 0 3px 12px rgba(193, 154, 63, 0.25);
  }

  .input-btn.send:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(193, 154, 63, 0.35);
  }

  .input-btn.secondary {
    background: var(--primary);
    color: var(--white);
  }

  .input-btn.secondary:hover:not(:disabled) {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  .input-btn.outline {
    background: transparent;
    border: 1px solid var(--gray-medium);
    color: var(--text);
  }

  .input-btn.outline:hover:not(:disabled) {
    border-color: var(--primary);
    background: rgba(26, 71, 42, 0.05);
    transform: translateY(-2px);
  }

  .input-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  /* Search Highlight */
  .search-highlight {
    background: var(--gold);
    color: var(--dark);
    padding: 0.05rem 0.2rem;
    border-radius: 3px;
    font-weight: 600;
  }

  .search-result-item {
    background: var(--white);
    padding: 0.4rem 0.6rem;
    margin: 0.25rem 0;
    border-radius: var(--rounded);
    border-left: 3px solid var(--gold);
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .search-result-item:hover {
    box-shadow: var(--shadow);
    transform: translateX(3px);
  }

  .search-result-sura {
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.05rem;
    font-size: 0.8rem;
  }

  .search-result-text {
    color: var(--text);
    line-height: 1.6;
    font-size: 0.8rem;
  }

  /* ============================================
     TAFSIR MODAL
     ============================================ */
  .tafsir-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 1.2rem;
  }

  .tafsir-modal-overlay.active {
    display: flex;
    animation: fadeIn 0.3s ease;
  }

  .tafsir-modal-content {
    background: var(--white);
    border-radius: var(--rounded-xl);
    max-width: 700px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-large);
    animation: scaleIn 0.3s ease;
    overflow: hidden;
  }

  .tafsir-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1rem;
    background: var(--header-gradient);
    color: white;
  }

  .tafsir-modal-header h3 {
    color: white;
    font-size: 0.95rem;
    margin: 0;
  }

  .tafsir-modal-header .close-modal {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    cursor: pointer;
    font-size: 1rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--rounded);
    transition: var(--transition);
  }

  .tafsir-modal-header .close-modal:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }

  .tafsir-modal-body {
    padding: 0.8rem;
    overflow-y: auto;
    flex: 1;
    line-height: 1.8;
    color: var(--text);
  }

  .tafsir-modal-body .verse-arabic {
    font-size: 1.1rem;
    text-align: right;
    padding: 0.6rem;
    background: var(--light-green);
    border-radius: var(--rounded);
    border-right: 4px solid var(--gold);
    font-family: var(--font-arabic);
    direction: rtl;
    line-height: 2;
    margin-bottom: 0.6rem;
  }

  .tafsir-modal-body .verse-translation {
    padding: 0.4rem 0.6rem;
    background: #f8f9fa;
    border-radius: var(--rounded);
    border-left: 4px solid var(--primary);
    margin-bottom: 0.6rem;
  }

  .tafsir-modal-body .tafsir-text {
    padding: 0.6rem;
    background: #fffde7;
    border-radius: var(--rounded);
    border-left: 4px solid var(--gold);
    line-height: 1.8;
  }

  .tafsir-modal-body .tafsir-source {
    margin-top: 0.6rem;
    font-style: italic;
    color: var(--gray-dark);
    font-size: 0.7rem;
    border-top: 1px solid var(--gray-medium);
    padding-top: 0.6rem;
  }

  /* ============================================
     SETTINGS PANEL
     ============================================ */
  .settings-panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9998;
    justify-content: flex-end;
    animation: fadeIn 0.3s ease;
  }

  .settings-panel-overlay.active {
    display: flex;
  }

  .settings-panel-content {
    background: var(--white);
    width: 400px;
    max-width: 92vw;
    height: 100vh;
    padding: 1.2rem;
    overflow-y: auto;
    animation: slideInRight 0.3s ease;
  }

  @keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  .settings-panel-content .settings-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--gray-medium);
  }

  .settings-panel-content .settings-header h2 {
    font-size: 1.2rem;
    color: var(--primary);
    margin: 0;
  }

  .settings-panel-content .settings-header .close-settings {
    background: none;
    border: none;
    font-size: 1.3rem;
    cursor: pointer;
    color: var(--gray-dark);
    transition: var(--transition);
    padding: 0.2rem;
  }

  .settings-panel-content .settings-header .close-settings:hover {
    color: var(--primary);
    transform: rotate(90deg);
  }

  .settings-panel-content .setting-group {
    margin-bottom: 1rem;
  }

  .settings-panel-content .setting-group label {
    display: block;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 0.15rem;
    font-size: 0.9rem;
  }

  .settings-panel-content .setting-group .range-container {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .settings-panel-content .setting-group input[type="range"] {
    flex: 1;
    height: 5px;
    -webkit-appearance: none;
    appearance: none;
    background: var(--gray-medium);
    border-radius: 3px;
    outline: none;
    transition: var(--transition);
  }

  .settings-panel-content .setting-group input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--gold-gradient);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
  }

  .settings-panel-content .setting-group input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.1);
  }

  .settings-panel-content .setting-group .range-value {
    min-width: 40px;
    text-align: center;
    font-weight: 700;
    color: var(--primary);
    font-size: 0.95rem;
    background: var(--light-green);
    padding: 0.1rem 0.4rem;
    border-radius: var(--rounded);
  }

  .settings-panel-content .setting-group .range-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.6rem;
    color: var(--gray-dark);
    margin-top: 0.05rem;
  }

  .settings-panel-content .setting-group select {
    width: 100%;
    padding: 0.35rem 0.5rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    transition: var(--transition);
    background: var(--white);
    color: var(--text);
  }

  .settings-panel-content .setting-group select:focus {
    border-color: var(--primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(26, 71, 42, 0.08);
  }

  .settings-panel-content .setting-group .setting-desc {
    font-size: 0.65rem;
    color: var(--gray-dark);
    margin-top: 0.1rem;
    line-height: 1.4;
  }

  .settings-panel-content .setting-group .checkbox-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .settings-panel-content .setting-group .checkbox-group input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--primary);
    cursor: pointer;
  }

  .settings-panel-content .setting-group .checkbox-group label {
    margin-bottom: 0;
    cursor: pointer;
  }

  .settings-panel-content .btn-reset {
    width: 100%;
    padding: 0.5rem;
    background: var(--primary);
    color: var(--white);
    border: none;
    border-radius: var(--rounded);
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    cursor: pointer;
    transition: var(--transition);
  }

  .settings-panel-content .btn-reset:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  /* ============================================
     SURA LIST PANEL
     ============================================ */
  .sura-panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(8px);
    z-index: 9998;
    justify-content: flex-start;
    animation: fadeIn 0.3s ease;
  }

  .sura-panel-overlay.active {
    display: flex;
  }

  .sura-panel-content {
    background: var(--white);
    width: 350px;
    max-width: 90vw;
    height: 100vh;
    padding: 1rem;
    overflow-y: auto;
    animation: slideInLeft 0.3s ease;
  }

  @keyframes slideInLeft {
    from { transform: translateX(-100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }

  .sura-panel-content .sura-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--gray-medium);
  }

  .sura-panel-content .sura-header h2 {
    font-size: 1.1rem;
    color: var(--primary);
    margin: 0;
  }

  .sura-panel-content .sura-header .close-sura {
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--gray-dark);
    transition: var(--transition);
    padding: 0.2rem;
  }

  .sura-panel-content .sura-header .close-sura:hover {
    color: var(--primary);
    transform: rotate(90deg);
  }

  .sura-panel-content .sura-search {
    width: 100%;
    padding: 0.35rem 0.6rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded-full);
    font-family: var(--font-ui);
    font-size: 0.8rem;
    transition: var(--transition);
    background: var(--white);
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .sura-panel-content .sura-search:focus {
    border-color: var(--primary);
    outline: none;
    box-shadow: 0 0 0 3px rgba(26, 71, 42, 0.08);
  }

  .sura-panel-content .sura-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(55px, 1fr));
    gap: 0.25rem;
  }

  .sura-panel-content .sura-grid .sura-item {
    background: var(--light-green);
    border: 2px solid transparent;
    border-radius: var(--rounded);
    padding: 0.25rem 0.1rem;
    text-align: center;
    cursor: pointer;
    transition: var(--transition);
    font-weight: 600;
    color: var(--primary);
    font-size: 0.6rem;
    font-family: var(--font-ui);
  }

  .sura-panel-content .sura-grid .sura-item:hover {
    background: var(--primary);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .sura-panel-content .sura-grid .sura-item small {
    display: block;
    font-weight: 400;
    font-size: 0.45rem;
    opacity: 0.6;
    margin-top: 1px;
  }

  /* ============================================
     ANIMATIONS
     ============================================ */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes scaleIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ============================================
     RESPONSIVE DESIGN
     ============================================ */
  @media (max-width: 768px) {
    .chatbot-header-premium { padding: 0.3rem 0.6rem; min-height: 44px; }
    .header-brand .brand-text { font-size: 0.85rem; }
    .control-btn { font-size: 0.55rem; padding: 0.15rem 0.4rem; }
    .digital-clock { font-size: 0.6rem; min-width: 60px; padding: 0.1rem 0.3rem; }
    .digital-clock .clock-time { font-size: 0.7rem; }
    .chat-body-main { padding: 0.4rem 0.6rem; }
    .chat-input-area { padding: 0.3rem 0.6rem; min-height: 42px; }
    .input-btn { font-size: 0.65rem; padding: 0.25rem 0.5rem; min-height: 28px; }
    .welcome-section h1 { font-size: 1.6rem; }
    .welcome-section p { font-size: 0.9rem; }
    .quick-actions-grid { grid-template-columns: repeat(auto-fit, minmax(85px, 1fr)); gap: 0.25rem; }
    .quick-action-premium { padding: 0.3rem 0.4rem; font-size: 0.6rem; }
    .message { font-size: 0.8rem; padding: 0.4rem 0.6rem; max-width: 95%; }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); }
    .settings-panel-content { width: 100%; max-width: 100%; padding: 0.6rem; }
    .sura-panel-content { width: 100%; max-width: 100%; padding: 0.6rem; }
    .pdf-viewer-content { width: 98%; max-height: 95vh; }
  }

  @media (max-width: 480px) {
    .header-brand .brand-text { font-size: 0.7rem; }
    .header-brand .brand-icon { font-size: 1rem; }
    .control-btn { font-size: 0.5rem; padding: 0.1rem 0.3rem; }
    .digital-clock { font-size: 0.5rem; min-width: 50px; padding: 0.1rem 0.2rem; }
    .digital-clock .clock-time { font-size: 0.6rem; }
    .welcome-section h1 { font-size: 1.3rem; }
    .quick-actions-grid { grid-template-columns: 1fr 1fr; gap: 0.15rem; }
    .quick-action-premium { font-size: 0.55rem; padding: 0.2rem 0.3rem; }
    .input-btn { font-size: 0.6rem; padding: 0.2rem 0.4rem; min-height: 24px; }
    .book-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
    .settings-panel-content, .sura-panel-content { padding: 0.4rem; }
  }

  /* High Contrast Mode */
  @media (prefers-contrast: high) {
    :root {
      --primary: #000000;
      --gold: #ffd700;
      --text: #000000;
      --light-bg: #ffffff;
    }
    .chatbot-header-premium { border-bottom: 3px solid #000; }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    * {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  ]]></b:skin>
</head>

<body>
  <!-- ==================== REQUIRED BLOGGER SECTION ==================== -->
  <b:section class='main' id='main-section' maxwidgets='1' showaddelement='yes'>
    <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog' version='2' visible='true'>
