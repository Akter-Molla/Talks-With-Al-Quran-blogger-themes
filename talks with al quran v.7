      }, 2000);
    }

    function convertNumbers(input) {
      var map = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
      var output = input;
      for (var bn in map) {
        if (map.hasOwnProperty(bn)) {
          output = output.replace(new RegExp(bn, 'g'), map[bn]);
        }
      }
      return output;
    }

