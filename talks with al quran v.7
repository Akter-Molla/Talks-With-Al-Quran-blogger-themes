      var bengali = state.quranData.find(function(a) { return a.sura === sura && a.aya === aya; });
      
      var html = '';
      if (arabic && arabic.ayat) {
        html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
      }
      if (bengali && bengali.text) {
        html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
      }
      if (tafsir && tafsir.text) {
        html += '<div class="tafsir-text"><strong>তাফসীর:</strong><br>' + tafsir.text + '</div>';
      } else {
        html += '<div class="tafsir-text"><p>এই আয়াতের তাফসীর এখনও যোগ করা হয়নি।</p></div>';
      }
      html += '<div class="tafsir-source"><strong>উৎস:</strong> ইবনে কাসিরের তাফসীর</div>';
      
      dom.tafsirTitle.textContent = 'সূরা ' + sura + ', আয়াত ' + aya + ' - তাফসীর';
      dom.tafsirBody.innerHTML = html;
      dom.tafsirModal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeTafsirModal() {
      dom.tafsirModal.classList.remove('active');
      document.body.style.overflow = '';
    }

