    function copyAyaText(sura, aya) {
      var ayaData = state.quranData.find(function(a) { return a.sura === sura && a.aya === aya; });
      var arabic = state.arabicData.find(function(a) { return a.sura === sura && a.VerseIDAr === aya; });
      var text = 'সূরা ' + sura + ', আয়াত ' + aya + '\n\n';
      if (arabic && arabic.ayat) text += arabic.ayat + '\n\n';
      if (ayaData) text += ayaData.text;
      
      navigator.clipboard.writeText(text).then(function() {
        addBotMessage('✅ কপি করা হয়েছে!', 'success');
      }).catch(function() {
        addBotMessage('❌ কপি করতে সমস্যা হয়েছে।', 'error');
      });
    }

