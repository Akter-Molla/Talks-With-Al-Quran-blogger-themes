var shareCardData = null;

// শেয়ার কার্ড মডাল খোলা
function openShareCardModal(sura, aya) {
  // আয়াতের ডেটা সংগ্রহ
  var bengali = state.quranData.find(function(a) {
    return String(a.sura) === String(sura) && String(a.aya) === String(aya);
  });
  var arabic = state.arabicData.find(function(a) {
    return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
  });
  var english = state.englishData.find(function(a) {
    return String(a.sura) === String(sura) && String(a.aya) === String(aya);
  });
  var category = getCategoryForVerse(sura, aya);

  // ডেটা সেভ
  shareCardData = {
    sura: sura,
    aya: aya,
    bengali: bengali ? bengali.text : 'আয়াত পাওয়া যায়নি',
    arabic: arabic ? arabic.ayat : '',
    english: english ? english.text : '',
    category: category || '',
    suraName: getSurahName(parseInt(sura))
  };

  // কার্ডে ডেটা আপডেট
  document.getElementById('card-arabic-text').textContent = shareCardData.arabic || '—';
  document.getElementById('card-bengali-text').textContent = shareCardData.bengali;
  document.getElementById('card-english-text').textContent = shareCardData.english || '—';
  document.getElementById('card-reference-text').textContent = 'সূরা ' + sura + ', আয়াত ' + aya + ' — ' + shareCardData.suraName;

  // মডাল দেখান
  document.getElementById('share-card-modal').classList.add('active');
  document.body.style.overflow = 'hidden';
}

