}

// ===== কার্ড ইমেজ তৈরি ও ডাউনলোড =====
function downloadShareCard() {
  if (!shareCardData) return;
  
  var cardElement = document.getElementById('card-inner');
  
  // লোডিং ইন্ডিকেটর
  var btn = document.getElementById('download-card-btn');
  var originalText = btn.innerHTML;
  btn.innerHTML = '⏳ তৈরি হচ্ছে...';
  btn.disabled = true;

  // html2canvas ব্যবহার করে ইমেজ তৈরি
  html2canvas(cardElement, {
    scale: 2.5,
    useCORS: true,
    backgroundColor: '#0d2b1a',
    width: cardElement.scrollWidth,
    height: cardElement.scrollHeight,
    windowWidth: cardElement.scrollWidth,
    windowHeight: cardElement.scrollHeight,
    logging: false,
    onclone: function(document) {
      // ক্লোন করা ডকুমেন্টে স্টাইল ঠিক রাখা
    }
  }).then(function(canvas) {
    // ইমেজ ডাউনলোড
    var link = document.createElement('a');
    link.download = 'TalksWithAlQuran-Sura-' + shareCardData.sura + '-Aya-' + shareCardData.aya + '.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
    
    btn.innerHTML = originalText;
    btn.disabled = false;
  }).catch(function(err) {
    console.error('Card export error:', err);
    btn.innerHTML = '❌ ব্যর্থ';
    btn.disabled = false;
    setTimeout(function() {
      btn.innerHTML = originalText;
    }, 2000);
  });
}

