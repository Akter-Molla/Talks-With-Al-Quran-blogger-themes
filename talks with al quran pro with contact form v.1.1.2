function getSurahVerses(sura) {
  var list = state.quranData.filter(function(a) {
    return String(a.sura) === String(sura);
  });
  list.sort(function(a, b) { return parseInt(a.aya) - parseInt(b.aya); });
  return list;
}
function renderFullSurahView(sura) {
  if (!dom.qtDisplay) return;
  var verses = getSurahVerses(sura);
  if (verses.length === 0) {
    dom.qtDisplay.innerHTML = '<div class="qt-empty">এই সূরার ডেটা এখনো যোগ করা হয়নি।</div>';
    return;
  }
  var html = '<div>';
  html += '<h3 style="text-align:center;color:var(--primary);">' + sura + '. ' + getSurahName(parseInt(sura)) + '</h3>';
  html += '<div style="text-align:center;font-size:0.65rem;color:var(--gray-dark);margin-bottom:0.4rem;">মোট ' + verses.length + ' আয়াত</div>';
  html += '<div style="display:flex;gap:0.3rem;justify-content:center;flex-wrap:wrap;margin-bottom:0.6rem;">';
  html += '<button onclick="window.exitFullSurahMode()" style="background:var(--primary);color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.7rem;">🔙 একক আয়াত মোড</button>';
  html += '<button onclick="window.downloadSurahPDF(\'' + sura + '\')" style="background:#c0392b;color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.7rem;">📄 সম্পূর্ণ সূরা পিডিএফ</button>';
  html += '<button onclick="window.shareSurah(\'' + sura + '\')" style="background:#0d47a1;color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.7rem;">📤 শেয়ার</button>';
  html += '</div></div>';
  verses.forEach(function(v) {
    var arabic = state.arabicData.find(function(a) {
      return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(v.aya);
    });
    var category = getCategoryForVerse(sura, v.aya);
    html += '<div class="full-surah-verse" id="fs-aya-' + v.aya + '">';
    html += '<div class="fs-verse-header"><span class="fs-verse-num">' + v.aya + '</span>';
    if (category) html += formatCategoryDisplay(category);
    html += '<button class="fs-audio-btn" onclick="window.playAudio(\'' + sura + '\',\'' + v.aya + '\')">🎧</button>';
html += '</div>';
html += '<div style="text-align:right;margin-top:0.2rem;">' + shareCardBtn(sura, v.aya) + '</div>';
    if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
    html += '<div class="verse-translation">' + v.text + '</div>';
    html += '<div style="text-align:right;"><button class="fs-tafsir-link" onclick="window.showTafsir(\'' + sura + '\',\'' + v.aya + '\')">📖 তাফসীর দেখুন</button></div>';
    html += '</div>';
  });
  dom.qtDisplay.innerHTML = html;
  state.qtFullSurahMode = true;
}
