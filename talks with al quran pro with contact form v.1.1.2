var vkTargetInput = null; // কোন ইনপুট বক্সে বর্তমানে কিবোর্ড কাজ করছে তা মনে রাখে
window.vkInsertChar = function(ch) {
  var input = vkTargetInput || dom.chatInput;
  if (!input) return;
  var start = input.selectionStart != null ? input.selectionStart : input.value.length;
  var end = input.selectionEnd != null ? input.selectionEnd : input.value.length;
  input.value = input.value.substring(0, start) + ch + input.value.substring(end);
  var newPos = start + ch.length;
  input.focus();
  input.setSelectionRange(newPos, newPos);
};
function vkBackspace() {
  var input = vkTargetInput || dom.chatInput;
  if (!input) return;
  var start = input.selectionStart != null ? input.selectionStart : input.value.length;
  var end = input.selectionEnd != null ? input.selectionEnd : input.value.length;
  if (start === end && start > 0) {
    input.value = input.value.substring(0, start - 1) + input.value.substring(end);
    start = start - 1;
  } else {
    input.value = input.value.substring(0, start) + input.value.substring(end);
  }
  input.focus();
  input.setSelectionRange(start, start);
}

// সাধারণ (generic) ফাংশন — যেকোনো ইনপুট বক্সের সাথে ভার্চুয়াল কিবোর্ড জুড়ে দেয়
function openVirtualKeyboardFor(targetInput, anchorEl, toggleBtn) {
  var panel = document.getElementById('virtual-keyboard-panel');
  if (!panel || !targetInput || !anchorEl) return;
  var sameTarget = (vkTargetInput === targetInput);
  var wasActive = panel.classList.contains('active');

  // কিবোর্ড প্যানেলটিকে সঠিক ইনপুট বক্সের ঠিক পরে নিয়ে যাওয়া হচ্ছে
  anchorEl.insertAdjacentElement('afterend', panel);

  // সব টগল বাটন থেকে active ক্লাস সরানো হচ্ছে
  document.querySelectorAll('.input-btn.keyboard-toggle').forEach(function(b) {
    b.classList.remove('active');
  });

  if (sameTarget && wasActive) {
    // একই ইনপুটের কিবোর্ড দ্বিতীয়বার চাপ দিলে বন্ধ হয়ে যাবে
    panel.classList.remove('active');
    targetInput.removeAttribute('readonly');
    vkTargetInput = null;
    return;
  }

  vkTargetInput = targetInput;
  panel.classList.add('active');
  if (toggleBtn) toggleBtn.classList.add('active');
  renderVirtualKeyboard(vkCurrentLang);
  targetInput.setAttribute('readonly', 'readonly');
  targetInput.blur();
  setTimeout(function() {
    if (typeof scrollChatToBottom === 'function') scrollChatToBottom();
    panel.scrollIntoView({ behavior: 'smooth', block: 'end' });
  }, 150);
}
