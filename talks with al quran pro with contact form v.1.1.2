      var wealth = parseFloat(document.getElementById('zakat-wealth').value) || 0;
      var rate = parseFloat(document.getElementById('zakat-rate').value) || 2.5;
      var result = document.getElementById('zakat-amount-panel');
      
      if (wealth <= 0) {
        result.textContent = '⚠️ সঠিক সম্পদের পরিমাণ দিন';
        result.style.color = '#c62828';
        return;
      }
      if (wealth < 52500) {
        result.textContent = '⚠️ সম্পদ নিসাবের কম';
        result.style.color = '#f57c00';
        return;
      }
      var zakat = (wealth * rate) / 100;
      result.textContent = '💰 ' + zakat.toFixed(2) + ' টাকা';
      result.style.color = 'var(--primary)';
    };
    // TIMER - only works when timer tab is active
    function renderTimer() {
      if (!dom.timerContainer || state.currentTab !== 'timer') return;
      var html = '<div class="time-tracker-card">';
      html += '<div class="time-display" id="timer-display-panel">00:00:00</div>';
      html += '<div class="time-label">⏱️ পড়ার সময় ট্র্যাকার</div>';
      html += '<div class="time-controls">';
      html += '<button class="time-btn gold" onclick="window.toggleTimerPanel()" id="timer-toggle-panel">▶️ শুরু</button>';
      html += '</div>';
      html += '<div style="margin-top:0.2rem;font-size:0.6rem;color:var(--gray-dark);">মোট পড়ার সময়: <span id="total-reading-panel">' + formatTime(state.readingTotalTime) + '</span></div>';
      html += '</div>';
      dom.timerContainer.innerHTML = html;
    }
    window.toggleTimerPanel = function() {
      var btn = document.getElementById('timer-toggle-panel');
      var display = document.getElementById('timer-display-panel');
      if (!btn || !display) return;
      
      state.timerRunning = !state.timerRunning;
      
      if (state.timerRunning) {
        btn.textContent = '⏹️ থামুন';
        state.timerInterval = setInterval(function() {
          state.timerSeconds++;
          var h = String(Math.floor(state.timerSeconds / 3600)).padStart(2, '0');
          var m = String(Math.floor((state.timerSeconds % 3600) / 60)).padStart(2, '0');
          var s = String(state.timerSeconds % 60).padStart(2, '0');
          display.textContent = h + ':' + m + ':' + s;
        }, 1000);
      } else {
        btn.textContent = '▶️ শুরু';
        clearInterval(state.timerInterval);
        state.readingTotalTime += state.timerSeconds;
        var totalDisplay = document.getElementById('total-reading-panel');
        if (totalDisplay) totalDisplay.textContent = formatTime(state.readingTotalTime);
        state.timerSeconds = 0;
        display.textContent = '00:00:00';
      }
    };
    window.resetTimerPanel = function() {
      clearInterval(state.timerInterval);
      state.timerRunning = false;
      state.timerSeconds = 0;
      var btn = document.getElementById('timer-toggle-panel');
      var display = document.getElementById('timer-display-panel');
      if (btn) btn.textContent = '▶️ শুরু';
      if (display) display.textContent = '00:00:00';
      state.readingTotalTime = 0;
      var totalDisplay = document.getElementById('total-reading-panel');
      if (totalDisplay) totalDisplay.textContent = '0 মিনিট 0 সেকেন্ড';
    };
