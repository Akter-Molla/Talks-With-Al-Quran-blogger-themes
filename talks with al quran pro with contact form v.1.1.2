          state.fontSettings.bengaliSize = parseInt(settings.bengaliSize) || 18;
          state.fontSettings.arabicSize = parseInt(settings.arabicSize) || 24;
          state.fontSettings.englishSize = parseInt(settings.englishSize) || 16;
