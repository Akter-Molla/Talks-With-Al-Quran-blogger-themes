    html += '<div style="font-size:14px;">' + v.text + '</div>';
    html += '</div>';
  });
  html += '<p style="text-align:center;font-size:11px;color:#6a7a6a;margin-top:20px;">Talks With Al Quran — ' + SITE_URL + '</p></div>';
  exportHTMLToPDF(html, 'Sura-' + sura + '-' + getSurahName(parseInt(sura)) + '.pdf');
};
