  var html = '';
  if (isStandalone) {
    html += '✅ <strong>এই ডিভাইসে অ্যাপটি ইতিমধ্যে ইনস্টল করা আছে।</strong><br>অন্য একটি ফোন/পিসিতে ইনস্টল করতে নিচের QR কোডটি সেই ডিভাইস দিয়ে স্ক্যান করুন।<br><br>';
  }
  if (isIOS) {
    html += '📲 <strong>হোম স্ক্রিনে যোগ করতে (iPhone/iPad):</strong><br>১. নিচের শেয়ার (⬆️) বাটনে চাপুন<br>২. "Add to Home Screen" সিলেক্ট করুন<br>৩. "Add" চাপুন';
  } else if (isAndroid) {
    html += '📲 <strong>হোম স্ক্রিনে যোগ করতে (Android):</strong><br>১. ব্রাউজারের ⋮ (তিন ডট) মেনুতে চাপুন<br>২. "Add to Home screen" বা "Install app" সিলেক্ট করুন<br>৩. "Add"/"Install" চাপুন<br><br>অথবা নিচের বাটনে চাপুন 👇';
  } else {
    html += '📲 <strong>হোম স্ক্রিনে/ডেস্কটপে ইনস্টল করতে:</strong><br>১. ব্রাউজারের ঠিকানা বার বা মেনুর ⋮ (তিন ডট) বাটনে চাপুন<br>২. "Install app" বা "Install Talks With Al Quran" সিলেক্ট করুন<br>৩. "Install" চাপুন<br><br>মোবাইল থেকে সরাসরি ইনস্টল করতে উপরের QR কোডটি স্ক্যান করুন।';
