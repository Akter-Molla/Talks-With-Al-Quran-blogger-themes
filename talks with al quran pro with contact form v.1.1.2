// 13B. QURAN TEXT / WORD SEARCH
// ============================================================
function escapeRegex(str) {
  return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}
function highlightMatch(text, keyword) {
  try {
    var re = new RegExp('(' + escapeRegex(keyword) + ')', 'gi');
    return text.replace(re, '<span class="search-highlight">$1</span>');
  } catch (e) {
    return text;
  }
}
function searchQuranText(keyword) {
  var kw = keyword.trim();
  if (!kw) return [];
  var kwLower = kw.toLowerCase();
  var resultsMap = {};
  function addMatch(sura, aya, lang, text) {
    var key = sura + ':' + aya;
    if (!resultsMap[key]) {
      resultsMap[key] = { sura: sura, aya: aya, matches: [] };
    }
    resultsMap[key].matches.push({ lang: lang, text: text });
  }
  state.quranData.forEach(function(item) {
    if (item.text && item.text.toLowerCase().indexOf(kwLower) !== -1) {
      addMatch(item.sura, item.aya, 'বাংলা', item.text);
    }
  });
  state.englishData.forEach(function(item) {
    if (item.text && item.text.toLowerCase().indexOf(kwLower) !== -1) {
      addMatch(item.sura, item.aya, 'English', item.text);
    }
  });
  state.arabicData.forEach(function(item) {
    if (item.ayat && item.ayat.indexOf(kw) !== -1) {
      addMatch(item.sura, item.VerseIDAr, 'عربي', item.ayat);
    }
  });
  var results = Object.keys(resultsMap).map(function(k) { return resultsMap[k]; });
  results.sort(function(a, b) {
    var d = parseInt(a.sura) - parseInt(b.sura);
    return d !== 0 ? d : parseInt(a.aya) - parseInt(b.aya);
  });
  return results;
}
function renderWordSearchTab(keyword, results) {
  if (!dom.wordsearchResultsPanel) return;
  if (results.length === 0) {
    dom.wordsearchResultsPanel.innerHTML = '<div class="qt-empty">কোনো আয়াত পাওয়া যায়নি। অন্য বানান বা প্রতিশব্দ দিয়ে চেষ্টা করুন।</div>';
  } else {
    var html = '<div class="wordsearch-count">মোট ' + results.length + ' টি আয়াত পাওয়া গেছে</div>';
    results.forEach(function(r) {
      html += '<div class="wordsearch-item" onclick="window.selectAyaFromSearch(\'' + r.sura + '\',\'' + r.aya + '\')">';
      html += '<div class="ws-ref">সূরা ' + r.sura + ', আয়াত ' + r.aya + ' (' + getSurahName(parseInt(r.sura)) + ')</div>';
      r.matches.forEach(function(m) {
        var cls = m.lang === 'عربي' ? 'ws-text ws-text-ar' : 'ws-text';
        var preview = m.text.length > 140 ? m.text.substring(0, 140) + '...' : m.text;
        html += '<div class="' + cls + '"><span class="ws-lang-tag">' + m.lang + '</span> ' + highlightMatch(preview, keyword) + '</div>';
      });
      html += '</div>';
    });
    dom.wordsearchResultsPanel.innerHTML = html;
  }
}
window.renderWordSearchTab = renderWordSearchTab;
window.selectAyaFromSearch = function(sura, aya) {
  if (state.currentTab !== 'chat') switchTab('chat');
  selectAya(sura, aya);
};
function performWordSearch(keyword) {
  if (!state.dataLoaded) {
    addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
    return;
  }
  var results = searchQuranText(keyword);
  switchTab('wordsearch');
  if (dom.wordsearchInput) dom.wordsearchInput.value = keyword;
  renderWordSearchTab(keyword, results);
}
window.performWordSearch = performWordSearch;
