// ================= টাইপিং ইফেক্ট (welcome screen এর স্টাইলে) =================
function typeWriterEffect(element, content, isHTML, speed) {
  speed = speed || 15;
  var cursor = document.createElement('span');
  cursor.className = 'typing-cursor';
  if (!isHTML) {
    element.innerHTML = '';
    element.appendChild(cursor);
    var i = 0;
    (function typeChar() {
      if (i < content.length) {
       cursor.insertAdjacentText('beforebegin', content.charAt(i));
i++;
scrollChatToBottom();
setTimeout(typeChar, speed);
      } else {
        cursor.remove();
      }
    })();
    return;
  }
  var temp = document.createElement('div');
  temp.innerHTML = content;
  element.innerHTML = '';
  var queue = [];
  function buildQueue(sourceNode, targetParent) {
    sourceNode.childNodes.forEach(function (child) {
      if (child.nodeType === Node.TEXT_NODE) {
        var textNode = document.createTextNode('');
        targetParent.appendChild(textNode);
        queue.push({ node: textNode, full: child.textContent });
      } else if (child.nodeType === Node.ELEMENT_NODE) {
        var el = child.cloneNode(false);
        targetParent.appendChild(el);
        buildQueue(child, el);
      }
    });
  }
  buildQueue(temp, element);
  element.appendChild(cursor);
  var qi = 0, ci = 0;
  (function processQueue() {
    if (qi >= queue.length) {
      cursor.remove();
      return;
    }
    var task = queue[qi];
    if (ci < task.full.length) {
      task.node.textContent += task.full.charAt(ci);
ci++;
scrollChatToBottom();
setTimeout(processQueue, speed);
    } else {
      qi++;
      ci = 0;
      processQueue();
    }
  })();
}
