  keys.forEach(function(k) {
    var isObj = (typeof k === 'object' && k !== null);
    var ch = isObj ? k.ch : k;
    var disp = isObj ? (k.disp || k.ch) : k;
    var label = isObj ? (k.label || '') : '';
    var cls = isObj ? (k.cls || '') : '';
    var safe = ch.replace(/'/g, "\\'");
    html += '<button type="button" class="vk-key ' + cls + '" title="' + label + '" onclick="window.vkInsertChar(\'' + safe + '\')">' + disp + '</button>';
  });
  area.innerHTML = html;
  document.querySelectorAll('.vk-lang-btn').forEach(function(btn) {
    btn.classList.toggle('active', btn.getAttribute('data-lang') === lang);
  });
}
