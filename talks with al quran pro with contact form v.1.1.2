function shareCardToPlatform(platform) {
  if (!shareCardData) return;
  
  var cardElement = document.getElementById('card-inner');
  
  // বাটন খুঁজে বের করা
  var btn = document.querySelector('.share-action-btn[data-platform="' + platform + '"]');
  if (!btn) {
    btn = document.getElementById('share-wa-btn');
  }
  
  if (btn) {
    btn.innerHTML = '⏳ তৈরি হচ্ছে...';
    btn.disabled = true;
  }

  // html2canvas দিয়ে ইমেজ তৈরি
  html2canvas(cardElement, {
    scale: 2.5,
    useCORS: true,
    backgroundColor: '#0d2b1a',
    width: cardElement.scrollWidth,
    height: cardElement.scrollHeight,
    windowWidth: cardElement.scrollWidth,
    windowHeight: cardElement.scrollHeight,
    logging: false
  }).then(function(canvas) {
    
    // ইমেজ ডেটা URL তৈরি
    var imageDataURL = canvas.toDataURL('image/png');
    
    // ===== সব প্ল্যাটফর্মের জন্য আলাদা হ্যান্ডেল =====
    switch(platform) {
      
