  .book-card-panel .book-btn {
    padding: 0.12rem 0.45rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    transition: var(--transition);
  }
  .book-card-panel .book-btn.preview { background: var(--gold-gradient); color: var(--dark); }
  .book-card-panel .book-btn.preview:hover { transform: translateY(-2px); }
  .book-card-panel .book-btn.download { background: var(--primary); color: var(--white); }
  .book-card-panel .book-btn.download:hover { background: var(--primary-light); transform: translateY(-2px); }
  .book-category-filter {
