    background: var(--gold-gradient);
    color: var(--dark);
  }
  /* Quran-Tafsir Tab inside panel system */
  .qt-panel-controls {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
