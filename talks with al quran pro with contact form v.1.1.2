    function loadPDF(pdfUrl, title) {
      if (!pdfUrl || pdfUrl === '#') {
        if (state.currentTab === 'chat') addBotMessage('❌ এই বইয়ের PDF লিংক উপলব্ধ নেই।', 'error');
        return;
      }
      
      dom.pdfTitle.textContent = title || 'পিডিএফ বই';
      dom.pdfBody.innerHTML = '<div class="pdf-loading"><div class="spinner"/><span>পিডিএফ লোড হচ্ছে...</span></div>';
      dom.pdfViewer.classList.add('active');
      document.body.style.overflow = 'hidden';
      dom.pdfDownloadBtn.onclick = function() { window.open(pdfUrl, '_blank'); };
      
      var driveId = null;
      var idMatch = pdfUrl.match(/[\/?]id=([a-zA-Z0-9_-]+)/) || pdfUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (idMatch) driveId = idMatch[1];
      
      if (driveId) {
        var embedUrl = getDriveEmbedUrl(driveId);
        dom.pdfBody.innerHTML = '<iframe src="' + embedUrl + '" style="width:100%;height:100%;min-height:350px;border:none;border-radius:8px;" allowfullscreen></iframe>';
        dom.pdfPageInfo.textContent = '📄 Google Drive PDF Viewer';
        dom.pdfPrevBtn.disabled = true;
        dom.pdfNextBtn.disabled = true;
        return;
      }
      dom.pdfBody.innerHTML = '<iframe src="' + pdfUrl + '" style="width:100%;height:100%;min-height:350px;border:none;border-radius:8px;" allowfullscreen></iframe>';
      dom.pdfPageInfo.textContent = '📄 PDF Viewer';
      dom.pdfPrevBtn.disabled = true;
      dom.pdfNextBtn.disabled = true;
    }
    window.openPDF = function(url, title) {
      loadPDF(url, title);
    };
    function closePDFViewer() {
      dom.pdfViewer.classList.remove('active', 'fullscreen');
      document.body.style.overflow = '';
    }
    function togglePdfFullscreen() {
      dom.pdfViewer.classList.toggle('fullscreen');
    }
