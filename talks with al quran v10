    function loadPDF(pdfUrl, title, bookDataItem) {
      if (!pdfUrl || pdfUrl === '#') {
        addBotMessage('❌ এই বইয়ের PDF লিংক উপলব্ধ নেই।', 'error');
        return;
      }
      
      state.currentPdfUrl = pdfUrl;
      state.currentBookData = bookDataItem || null;
      dom.pdfTitle.textContent = title || 'পিডিএফ বই';
      
      dom.pdfBody.innerHTML = '<div class="pdf-loading"><div class="spinner"/><span>পিডিএফ লোড হচ্ছে...</span></div>';
      dom.pdfViewer.classList.add('active');
      document.body.style.overflow = 'hidden';
      state.readingStartTime = Date.now();

      dom.pdfDownloadBtn.onclick = function() { window.open(pdfUrl, '_blank'); };
      
      if (dom.pdfBuyBtn && bookDataItem && bookDataItem.buyLink && bookDataItem.buyLink !== '#') {
        dom.pdfBuyBtn.style.display = 'inline-block';
        dom.pdfBuyBtn.onclick = function() { window.open(bookDataItem.buyLink, '_blank'); };
      } else {
        dom.pdfBuyBtn.style.display = 'none';
      }

      dom.pdfShareBtn.onclick = function() {
        if (navigator.share) {
          navigator.share({
            title: title,
            text: '📚 ' + title + ' - ইসলামিক বই',
            url: pdfUrl
          });
        } else {
          navigator.clipboard.writeText(title + ' - ' + pdfUrl).then(function() {
            addBotMessage('✅ লিংক কপি করা হয়েছে!', 'success');
          });
        }
      };

      // Check for Google Drive ID
      var driveId = null;
      var idMatch = pdfUrl.match(/[\/?]id=([a-zA-Z0-9_-]+)/) || pdfUrl.match(/\/d\/([a-zA-Z0-9_-]+)/);
      if (idMatch) driveId = idMatch[1];
      
      if (driveId) {
        var embedUrl = getDriveEmbedUrl(driveId);
        dom.pdfBody.innerHTML = '<iframe src="' + embedUrl + '" style="width:100%;height:100%;min-height:500px;border:none;border-radius:8px;" allowfullscreen></iframe>';
        dom.pdfPageInfo.textContent = '📄 Google Drive PDF Viewer';
        dom.pdfPrevBtn.disabled = true;
        dom.pdfNextBtn.disabled = true;
        updateZoomLabel();
        return;
      }

      // Direct PDF link
      dom.pdfBody.innerHTML = '<iframe src="' + pdfUrl + '" style="width:100%;height:100%;min-height:500px;border:none;border-radius:8px;" allowfullscreen></iframe>';
      dom.pdfPageInfo.textContent = '📄 PDF Viewer';
      dom.pdfPrevBtn.disabled = true;
      dom.pdfNextBtn.disabled = true;
      updateZoomLabel();
    }

    function updateZoomLabel() {
      if (dom.pdfZoomLabel) {
        dom.pdfZoomLabel.textContent = Math.round(state.pdfScale * 100) + '%';
      }
    }

    function togglePdfFullscreen() {
      state.isPdfFullscreen = !state.isPdfFullscreen;
      dom.pdfViewer.classList.toggle('fullscreen', state.isPdfFullscreen);
    }

    function closePDFViewer() {
      if (state.readingStartTime) {
        var elapsed = Math.floor((Date.now() - state.readingStartTime) / 1000);
        if (elapsed > 10) {
          state.readingTotalTime += elapsed;
          addBotMessage('📚 আপনি ' + formatTime(elapsed) + ' পড়েছেন। মোট: ' + formatTime(state.readingTotalTime), 'info');
        }
        state.readingStartTime = null;
      }
      dom.pdfViewer.classList.remove('active', 'fullscreen');
      state.isPdfFullscreen = false;
      document.body.style.overflow = '';
      state.pdfDoc = null;
      state.pdfPageNum = 1;
      state.pdfTotalPages = 0;
      state.currentBookData = null;
    }

