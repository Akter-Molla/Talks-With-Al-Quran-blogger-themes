<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  <meta content='Al Quran Pro - Islamic Chatbot Theme' name='theme-name'/>
  <meta content='Akter Molla' name='theme-author'/>
  <meta content='7.0' name='theme-version'/>
  
  <!-- Fonts -->
  <link href='https://fonts.maateen.me/kalpurush/font.css' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;700&amp;display=swap' rel='stylesheet'/>
  <link href='https://fonts.googleapis.com/css2?family=Lateef:wght@400;700&amp;display=swap' rel='stylesheet'/>
  
  <b:skin><![CDATA[
  /* ============================================
     CSS VARIABLES
     ============================================ */
  :root {
    --primary: #0d2b1a;
    --primary-light: #1a4a2a;
    --primary-dark: #061a0e;
    --secondary: #2d5a27;
    --accent: #8e6e53;
    --gold: #d4af37;
    --gold-light: #f0d080;
    --gold-gradient: linear-gradient(135deg, #d4af37, #f0d080, #d4af37);
    --light-green: #e8f5e8;
    --white: #ffffff;
    --dark: #1a1a1a;
    --text: #1a3a1a;
    --text-light: #4a6a4a;
    --light-bg: #f5faf5;
    --gray-light: #f0f5f0;
    --gray-medium: #dce4dc;
    --gray-dark: #6a7a6a;
    --shadow-glow: 0 0 60px rgba(212, 175, 55, 0.15);
    
    --bengali-font-size: 17px;
    --arabic-font-size: 22px;
    --font-bengali: 'Kalpurush', 'Hind Siliguri', sans-serif;
    --font-arabic: 'Amiri', 'Scheherazade New', serif;
    --font-ui: 'Hind Siliguri', sans-serif;
    
    --shadow-sm: 0 2px 12px rgba(0, 0, 0, 0.06);
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
    --shadow-hover: 0 8px 40px rgba(0, 0, 0, 0.12);
    --shadow-large: 0 16px 60px rgba(0, 0, 0, 0.15);
    
    --rounded: 14px;
    --rounded-lg: 24px;
    --rounded-xl: 32px;
    --rounded-full: 50px;
    --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    --transition-slow: all 0.6s cubic-bezier(0.25, 0.8, 0.25, 1);
    --header-gradient: linear-gradient(135deg, #0d2b1a, #1a4a2a);
  }

  /* Dark Mode */
  [data-theme="dark"] {
    --primary: #3a9a5f;
    --primary-light: #4ab070;
    --primary-dark: #1a3a2a;
    --secondary: #4a8a5f;
    --accent: #b8957a;
    --gold: #e8c96a;
    --gold-light: #f0d97a;
    --light-green: #1a2a1a;
    --white: #1a1a1a;
    --dark: #f0f0f0;
    --text: #e0e8e0;
    --text-light: #a0b0a0;
    --light-bg: #121212;
    --gray-light: #2a2a2a;
    --gray-medium: #3a4a3a;
    --gray-dark: #8a9a8a;
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
    --shadow-hover: 0 8px 40px rgba(0, 0, 0, 0.5);
    --shadow-large: 0 16px 60px rgba(0, 0, 0, 0.6);
    --shadow-glow: 0 0 60px rgba(232, 201, 106, 0.06);
  }

  /* ============================================
     RESET & BASE
     ============================================ */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: var(--font-bengali);
    color: var(--text);
    background: var(--light-bg);
    line-height: 1.7;
    overflow: hidden;
    font-size: var(--bengali-font-size);
    transition: background-color 0.4s ease, color 0.4s ease;
    height: 100vh;
    width: 100vw;
  }

  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: var(--gray-light);
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb {
    background: var(--gold-gradient);
    border-radius: 10px;
  }

  /* ============================================
     FULL PAGE CHATBOT
     ============================================ */
  .chatbot-fullpage {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    background: var(--white);
    z-index: 1000;
    height: 100vh;
    width: 100vw;
    overflow: hidden;
  }

  /* ============================================
     HEADER
     ============================================ */
  .chatbot-header-premium {
    background: var(--header-gradient);
    padding: 0.5rem 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    min-height: 56px;
    flex-shrink: 0;
    position: relative;
    z-index: 10;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.15);
  }

  .chatbot-header-premium::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--gold-gradient);
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--white);
  }

  .header-brand .brand-icon {
    font-size: 1.6rem;
    animation: pulseGlow 3s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { filter: drop-shadow(0 0 5px rgba(212, 175, 55, 0.3)); }
    50% { filter: drop-shadow(0 0 20px rgba(212, 175, 55, 0.6)); }
  }

  .header-brand .brand-text {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .header-brand .brand-text span {
    color: var(--gold-light);
  }

  .header-controls {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .control-btn {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.08);
    color: var(--white);
    padding: 0.25rem 0.6rem;
    border-radius: var(--rounded-full);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.6rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    backdrop-filter: blur(8px);
    font-family: var(--font-ui);
  }

  .control-btn:hover {
    background: rgba(255,255,255,0.2);
    transform: translateY(-2px);
  }

  .control-btn.active {
    background: var(--gold-gradient);
    color: var(--dark);
    border-color: var(--gold);
  }

  /* Digital Clock */
  .digital-clock {
    color: var(--white);
    font-size: 0.7rem;
    font-weight: 600;
    background: rgba(255,255,255,0.08);
    padding: 0.15rem 0.6rem;
    border-radius: var(--rounded-full);
    border: 1px solid rgba(255,255,255,0.1);
    font-family: 'Courier New', monospace;
    min-width: 70px;
    text-align: center;
  }

  .digital-clock .clock-time {
    font-size: 0.85rem;
  }

  .digital-clock .clock-am-pm {
    font-size: 0.55rem;
    opacity: 0.7;
  }

  /* ============================================
     CHAT BODY
     ============================================ */
  .chat-body-main {
    flex: 1;
    overflow-y: auto;
    padding: 0.8rem 1.2rem;
    background: var(--light-bg);
    scroll-behavior: smooth;
    min-height: 0;
    background-image: radial-gradient(circle at 10% 20%, rgba(212, 175, 55, 0.03) 0%, transparent 50%);
  }

  /* ============================================
     WELCOME SECTION - EYE CATCHY
     ============================================ */
  .welcome-section {
    text-align: center;
    padding: 1rem 0 0.5rem;
    animation: fadeInUp 0.8s ease;
  }

  .welcome-section .welcome-icon {
    font-size: 4.5rem;
    margin-bottom: 0.3rem;
    display: inline-block;
    animation: floatIcon 4s ease-in-out infinite;
  }

  @keyframes floatIcon {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-12px) rotate(5deg); }
  }

  .welcome-section .welcome-glow {
    position: relative;
    display: inline-block;
  }

  .welcome-section .welcome-glow::before {
    content: '';
    position: absolute;
    top: -20px;
    left: -20px;
    right: -20px;
    bottom: -20px;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.15), transparent 70%);
    border-radius: 50%;
    z-index: -1;
    animation: glowPulse 3s ease-in-out infinite;
  }

  @keyframes glowPulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .welcome-section h1 {
    font-size: 2.4rem;
    color: var(--primary);
    margin-bottom: 0.1rem;
    font-weight: 700;
  }

  .welcome-section h1 span {
    background: var(--gold-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .welcome-section .welcome-sub {
    font-size: 1.1rem;
    color: var(--text-light);
    max-width: 550px;
    margin: 0.1rem auto;
  }

  .welcome-section .feature-badge {
    display: inline-block;
    background: var(--gold-gradient);
    color: var(--dark);
    padding: 0.2rem 1.2rem;
    border-radius: var(--rounded-full);
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 0.2rem;
    box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
  }

  .welcome-section .data-status {
    font-size: 0.75rem;
    color: var(--text-light);
    margin-top: 0.2rem;
    min-height: 1.2rem;
  }

  .welcome-section .data-status.error {
    color: #c62828;
    font-weight: 600;
  }

  .welcome-section .data-status.hidden {
    opacity: 0;
  }

  /* ============================================
     QUICK ACTIONS GRID
     ============================================ */
  .quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(85px, 1fr));
    gap: 0.4rem;
    max-width: 820px;
    margin: 0.8rem auto 0.3rem;
  }

  .quick-action-premium {
    background: var(--white);
    border: 2px solid var(--gray-medium);
    padding: 0.5rem 0.2rem;
    border-radius: var(--rounded);
    cursor: pointer;
    transition: var(--transition);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.55rem;
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    box-shadow: var(--shadow-sm);
    min-height: 60px;
  }

  .quick-action-premium .qa-icon {
    font-size: 1.4rem;
  }

  .quick-action-premium .qa-label {
    font-size: 0.5rem;
    line-height: 1.2;
  }

  .quick-action-premium:hover {
    border-color: var(--gold);
    background: rgba(212, 175, 55, 0.05);
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .quick-action-premium.primary {
    border-color: var(--gold);
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .quick-action-premium.primary:hover {
    box-shadow: 0 4px 25px rgba(212, 175, 55, 0.4);
  }

  /* ============================================
     MESSAGES
     ============================================ */
  .message {
    margin-bottom: 0.6rem;
    padding: 0.5rem 0.9rem;
    border-radius: 1rem;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.7;
    position: relative;
    animation: messageSlide 0.35s ease;
    font-size: 0.9rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  @keyframes messageSlide {
    from { opacity: 0; transform: translateY(18px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .message.user {
    background: linear-gradient(135deg, #e8f0fe, #d4e0fa);
    margin-left: auto;
    border-bottom-right-radius: 0.3rem;
    color: #0d47a1;
    border: 1px solid #bbdefb;
  }

  [data-theme="dark"] .message.user {
    background: linear-gradient(135deg, #1a2a4a, #0d1a3a);
    color: #90caf9;
    border-color: #1a3a5a;
  }

  .message.bot {
    background: linear-gradient(135deg, var(--light-green), #e8f5e8);
    margin-right: auto;
    border-bottom-left-radius: 0.3rem;
    color: var(--text);
    border: 1px solid #c8e6c9;
  }

  [data-theme="dark"] .message.bot {
    background: linear-gradient(135deg, #1a2a1a, #0d1a0d);
    border-color: #2a4a2a;
  }

  .message.bot.error {
    background: linear-gradient(135deg, #ffebee, #ffcdd2);
    border-color: #ef9a9a;
    color: #c62828;
  }

  .message.bot.success {
    background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
    border-color: #81c784;
    color: #2e7d32;
  }

  .message.bot.info {
    background: linear-gradient(135deg, #e3f2fd, #bbdefb);
    border-color: #64b5f6;
    color: #0d47a1;
  }

  .message-timestamp {
    font-size: 0.45rem;
    color: var(--gray-dark);
    margin-top: 0.1rem;
    opacity: 0.5;
  }

  /* ============================================
     BOOK CORNER
     ============================================ */
  .book-category-tabs {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin: 0.2rem 0 0.4rem;
    justify-content: center;
  }

  .book-category-tab {
    padding: 0.15rem 0.6rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded-full);
    background: var(--white);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.55rem;
    font-weight: 600;
    transition: var(--transition);
    color: var(--text);
  }

  .book-category-tab:hover {
    border-color: var(--primary);
    background: rgba(26, 71, 42, 0.05);
  }

  .book-category-tab.active {
    border-color: var(--gold);
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem;
    margin: 0.4rem 0;
  }

  .book-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.6rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    border: 2px solid var(--gray-light);
    text-align: center;
  }

  .book-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--gold);
  }

  .book-card .book-icon {
    font-size: 2rem;
    margin-bottom: 0.15rem;
    display: block;
  }

  .book-card .book-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1.2;
  }

  .book-card .book-author {
    font-size: 0.6rem;
    color: var(--gray-dark);
  }

  .book-card .book-price {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--gold);
    margin: 0.1rem 0;
  }

  .book-card .book-desc {
    font-size: 0.55rem;
    color: var(--text-light);
    margin: 0.1rem 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-card .book-actions {
    display: flex;
    gap: 0.2rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.2rem;
  }

  .book-card .book-btn {
    padding: 0.15rem 0.5rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    transition: var(--transition);
  }

  .book-card .book-btn.preview {
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .book-card .book-btn.preview:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .book-card .book-btn.download {
    background: var(--primary);
    color: var(--white);
  }

  .book-card .book-btn.download:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }

  .book-card .book-btn.buy {
    background: #2196F3;
    color: var(--white);
  }

  .book-card .book-btn.buy:hover {
    background: #1976D2;
    transform: translateY(-2px);
  }

  .book-card .book-btn.share {
    background: #4CAF50;
    color: var(--white);
  }

  .book-card .book-btn.share:hover {
    background: #388E3C;
    transform: translateY(-2px);
  }

  .book-card .book-badge {
    display: inline-block;
    font-size: 0.4rem;
    background: var(--gold-gradient);
    color: var(--dark);
    padding: 0.05rem 0.4rem;
    border-radius: var(--rounded-full);
    font-weight: 700;
    margin-bottom: 0.1rem;
  }

  /* ============================================
     PDF VIEWER MODAL
     ============================================ */
  .pdf-viewer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    z-index: 10000;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .pdf-viewer-overlay.active {
    display: flex !important;
    animation: fadeIn 0.3s ease;
  }

  .pdf-viewer-overlay.fullscreen {
    padding: 0;
  }

  .pdf-viewer-overlay.fullscreen .pdf-viewer-content {
    width: 100vw !important;
    height: 100vh !important;
    max-width: 100vw !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
  }

  .pdf-viewer-content {
    background: var(--white);
    border-radius: var(--rounded-xl);
    width: 95%;
    max-width: 1100px;
    max-height: 94vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-large);
    animation: scaleIn 0.3s ease;
    overflow: hidden;
  }

  .pdf-viewer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6rem 1.2rem;
    background: var(--header-gradient);
    color: white;
    flex-shrink: 0;
  }

  .pdf-viewer-header h3 {
    color: white;
    font-size: 0.95rem;
    margin: 0;
    flex: 1;
    margin-right: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pdf-viewer-header .viewer-controls {
    display: flex;
    gap: 0.3rem;
    align-items: center;
  }

  .pdf-viewer-header .viewer-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    border-radius: var(--rounded);
    transition: var(--transition);
    font-size: 0.7rem;
    font-family: var(--font-ui);
  }

  .pdf-viewer-header .viewer-btn:hover {
    background: rgba(255,255,255,0.3);
  }

  .pdf-viewer-header .viewer-btn.close {
    font-size: 1rem;
    padding: 0.05rem 0.45rem;
  }

  .pdf-viewer-header .viewer-btn.close:hover {
    background: rgba(255, 0, 0, 0.3);
  }

  .pdf-viewer-header .viewer-btn.active {
    background: var(--gold-gradient);
    color: var(--dark);
  }

  .pdf-viewer-body {
    flex: 1;
    overflow-y: auto;
    padding: 0.5rem;
    background: #f0f0f0;
    min-height: 350px;
    max-height: 70vh;
    position: relative;
  }

  .pdf-viewer-body canvas {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
    box-shadow: var(--shadow);
    border-radius: var(--rounded-sm);
  }

  .pdf-viewer-body iframe {
    width: 100%;
    height: 100%;
    min-height: 500px;
    border: none;
    border-radius: 8px;
  }

  .pdf-viewer-body .pdf-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 300px;
    font-size: 1rem;
    color: var(--gray-dark);
    flex-direction: column;
    gap: 0.5rem;
  }

  .pdf-viewer-body .pdf-loading .spinner {
    width: 40px;
    height: 40px;
    border: 4px solid var(--gray-light);
    border-top: 4px solid var(--gold);
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .pdf-viewer-body .pdf-error {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 300px;
    font-size: 1rem;
    color: #c62828;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
    padding: 1rem;
  }

  .pdf-viewer-body .pdf-error .error-icon {
    font-size: 3rem;
  }

  .pdf-viewer-footer {
    padding: 0.4rem 1rem;
    background: var(--gray-light);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem;
    flex-shrink: 0;
  }

  .pdf-viewer-footer .page-info {
