    window.toggleTimer = function() {
      var btn = document.getElementById('timer-toggle-btn');
      var display = document.getElementById('timer-display');
      if (!btn || !display) return;
      
      state.timerRunning = !state.timerRunning;
      
      if (state.timerRunning) {
        btn.textContent = '⏹️ থামুন';
        state.timerInterval = setInterval(function() {
          state.timerSeconds++;
          var h = String(Math.floor(state.timerSeconds / 3600)).padStart(2, '0');
          var m = String(Math.floor((state.timerSeconds % 3600) / 60)).padStart(2, '0');
          var s = String(state.timerSeconds % 60).padStart(2, '0');
          display.textContent = h + ':' + m + ':' + s;
        }, 1000);
        addBotMessage('⏱️ সময় গণনা শুরু হয়েছে!', 'info');
      } else {
        btn.textContent = '▶️ শুরু';
        clearInterval(state.timerInterval);
        state.readingTotalTime += state.timerSeconds;
        var totalDisplay = document.getElementById('total-reading-time');
        if (totalDisplay) totalDisplay.textContent = formatTime(state.readingTotalTime);
        addBotMessage('⏱️ থামানো হয়েছে। পড়েছেন: ' + formatTime(state.timerSeconds), 'info');
        state.timerSeconds = 0;
        display.textContent = '00:00:00';
      }
    };

    window.resetTimer = function() {
      clearInterval(state.timerInterval);
      state.timerRunning = false;
      state.timerSeconds = 0;
      var btn = document.getElementById('timer-toggle-btn');
      var display = document.getElementById('timer-display');
      if (btn) btn.textContent = '▶️ শুরু';
      if (display) display.textContent = '00:00:00';
      state.readingTotalTime = 0;
      var totalDisplay = document.getElementById('total-reading-time');
