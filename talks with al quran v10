      {q:"জিবরাইল (আ.) কে কি বলা হয়?", o:["রূহুল কুদুস","মালিকুল মাওত","ইসরাফিল","মিকাইল"], c:0}
    ];

    function startQuiz() {
      state.quizState = {
        questions: QUIZ_QUESTIONS.slice(0, 5),
        current: 0,
        score: 0,
        total: 5
      };
      askQuizQuestion();
    }

    function askQuizQuestion() {
      if (!state.quizState || state.quizState.current >= state.quizState.total) {
        if (state.quizState) showQuizResult();
        return;
      }
      
      var q = state.quizState.questions[state.quizState.current];
      var html = '<div class="quiz-card">';
      html += '<div class="quiz-progress">🧠 প্রশ্ন ' + (state.quizState.current + 1) + '/' + state.quizState.total + '</div>';
      html += '<div class="question">' + q.q + '</div>';
      
      q.o.forEach(function(opt, i) {
        var letter = String.fromCharCode(65 + i);
        html += '<button class="option-btn" onclick="window.answerQuizOption(' + i + ')">' + letter + '. ' + opt + '</button>';
      });
      
      html += '</div>';
      addBotMessage(html, 'normal', true);
    }

    window.answerQuizOption = function(selected) {
      if (!state.quizState) return;
      
      var q = state.quizState.questions[state.quizState.current];
      var correct = selected === q.c;
      
      if (correct) {
        state.quizState.score++;
        addBotMessage('✅ সঠিক উত্তর! 🎉', 'success');
      } else {
        addBotMessage('❌ ভুল উত্তর! সঠিক: ' + q.o[q.c], 'error');
      }
      
      state.quizState.current++;
      setTimeout(askQuizQuestion, 1500);
    };

    function showQuizResult() {
      if (!state.quizState) return;
      
      var pct = Math.round((state.quizState.score / state.quizState.total) * 100);
      var msg = pct >= 80 ? '🎉 অসাধারণ!' : pct >= 60 ? '👍 ভালো!' : '📚 আরও পড়ুন!';
      
      var html = '<div class="quiz-card">';
      html += '<div class="result">📊 কুইজ রেজাল্ট</div>';
      html += '<div style="text-align:center;padding:0.1rem 0;">স্কোর: ' + state.quizState.score + '/' + state.quizState.total + '</div>';
      html += '<div style="text-align:center;padding:0.1rem 0;">পার্সেন্টেজ: ' + pct + '%</div>';
      html += '<div style="text-align:center;padding:0.1rem 0;">' + msg + '</div>';
      html += '<button onclick="window.startQuiz()" style="display:block;width:100%;padding:0.25rem;background:var(--gold-gradient);border:none;border-radius:var(--rounded);cursor:pointer;font-weight:600;font-family:var(--font-ui);color:var(--dark);font-size:0.7rem;">🔄 আবার চেষ্টা করুন</button>';
      html += '</div>';
      html += '<div class="home-btn-container"><button class="home-btn" onclick="window.goHome()">🏠 হোমে যান</button></div>';
      addBotMessage(html, 'normal', true);
      
      state.quizState = null;
    }

    // ============================================================
    // 15. QUERY PROCESSING
    // ============================================================
    function processQuery(query) {
      if (state.isLoading) return;
      var trimmed = query.trim();
      if (!trimmed) {
        addBotMessage('❌ অনুগ্রহ করে একটি প্রশ্ন লিখুন।', 'error');
        return;
      }

      addUserMessage(trimmed);
      dom.input.value = '';
      dom.input.focus();

      showTyping();
      state.isLoading = true;

      setTimeout(function() {
        removeTyping();
        state.isLoading = false;

        try {
          var lower = trimmed.toLowerCase();

          // Check for book command
          if (handleBookCommand(trimmed)) return;

          // Command Map - Bangla & English
          var commandMap = {
            'হোম': goHome, 'home': goHome, 'মেনু': goHome, 'menu': goHome,
            'হোমে যাও': goHome, 'go home': goHome,
            'সাহায্য': showHelp, 'help': showHelp, 'গাইড': showHelp, 'guide': showHelp,
            'বই': showBookCorner, 'book': showBookCorner, 'পিডিএফ': showBookCorner, 'pdf': showBookCorner,
            'বই সেকশন': showBookCorner, 'বই পড়': showBookCorner, 'বই পড়': showBookCorner,
            'যাকাত': showZakatCalculator, 'zakat': showZakatCalculator,
            'টাইমার': showTimer, 'timer': showTimer, 'সময়': showTimer,
            'পড়ার সময়': showTimer, 'reading time': showTimer,
            'নামাজ': showPrayerTimes, 'সালাত': showPrayerTimes, 'prayer': showPrayerTimes,
            'ওয়াক্ত': showPrayerTimes, 'সময়সূচী': showPrayerTimes,
            'হাদিস': showRandomHadith, 'hadith': showRandomHadith, 'হাদীস': showRandomHadith,
            'ব্লগ': showBlogPosts, 'blog': showBlogPosts, 'পোস্ট': showBlogPosts, 'post': showBlogPosts,
            'কুইজ': startQuiz, 'quiz': startQuiz, 'প্রশ্ন': startQuiz,
            'জ্ঞান': showKnowledgeBase, 'knowledge': showKnowledgeBase,
            'আয়াত': showPopularAyat, 'popular': showPopularAyat, 'জনপ্রিয়': showPopularAyat
          };

          for (var cmd in commandMap) {
            if (lower.indexOf(cmd) !== -1) {
              commandMap[cmd]();
              return;
            }
          }

          // Surah:Ayah patterns
          var surahAyahMatch = null;
          
          // Format: 2:255 or 2.255 or 2/255
          var colonMatch = trimmed.match(/^(\d+)[:\.\/,](\d+)$/);
          if (colonMatch) surahAyahMatch = colonMatch;
          
          // Format: সূরা ২ আয়াত ২৫৫
          if (!surahAyahMatch) {
            var bengaliMatch = trimmed.match(/সূরা\s*(\d+)\s*আয়াত\s*(\d+)/i);
            if (bengaliMatch) surahAyahMatch = bengaliMatch;
          }
          
          // Format: Surah 2 Ayah 255
          if (!surahAyahMatch) {
            var englishMatch = trimmed.match(/surah\s*(\d+)\s*ayah\s*(\d+)/i);
            if (englishMatch) surahAyahMatch = englishMatch;
          }
          
          // Format: Just a number (treat as surah:1)
          if (!surahAyahMatch) {
            var singleNum = trimmed.match(/^(\d+)$/);
            if (singleNum && parseInt(singleNum[1]) <= 114 && parseInt(singleNum[1]) >= 1) {
              surahAyahMatch = [null, singleNum[1], '1'];
            }
          }
          
          if (surahAyahMatch) {
            var sura = surahAyahMatch[1];
            var aya = surahAyahMatch[2];
            selectAya(sura, aya);
            return;
          }

          // Keyword search (minimum 2 characters)
          if (trimmed.length >= 2) {
            handleKeywordSearch(trimmed);
          } else if (/সালাম|assalam|hello|hi|হ্যালো/.test(lower)) {
            addBotMessage('ওয়া আলাইকুম আসসালাম! "সাহায্য" লিখে সাহায্য নিন।', 'info');
          } else {
            addBotMessage('🤔 "' + trimmed + '" - আমি এই প্রশ্নের উত্তর দিতে পারছি না।\n\n"সাহায্য" লিখে সাহায্য নিন।', 'info');
          }
        } catch (error) {
          console.error('Query error:', error);
          addBotMessage('❌ প্রক্রিয়াকরণে সমস্যা হয়েছে।', 'error');
        }
      }, 600);
    }

    // ============================================================
    // 16. KEYWORD SEARCH
    // ============================================================
    function handleKeywordSearch(query) {
      var words = query.toLowerCase().split(/\s+/);
      var results = [];
      
      state.quranData.forEach(function(aya) {
        var text = aya.text.toLowerCase();
        var matchCount = 0;
        var highlighted = aya.text;
        
        words.forEach(function(word) {
          var regex = new RegExp(word, 'gi');
          var matches = text.match(regex);
          if (matches) {
            matchCount += matches.length;
            highlighted = highlighted.replace(regex, function(m) {
              return '<span class="search-highlight">' + m + '</span>';
            });
          }
        });
        
        if (matchCount > 0) {
          results.push({
            sura: aya.sura,
            aya: aya.aya,
            text: aya.text,
            matchCount: matchCount,
            highlighted: highlighted
          });
        }
      });
      
      results.sort(function(a, b) { return b.matchCount - a.matchCount; });
      var top = results.slice(0, 6);
      state.currentSearchResults = top;
      
      if (top.length === 0) {
        addBotMessage('❌ "' + query + '" এর জন্য কোন ফলাফল পাওয়া যায়নি।', 'error');
        return;
      }
      
      var html = '<strong>"' + query + '" এর জন্য ' + top.length + 'টি আয়াত পাওয়া গেছে</strong><br><br>';
      
      top.forEach(function(r, i) {
        html += '<div class="search-result-item">';
        html += '<div class="search-result-sura">' + (i+1) + '. সূরা ' + r.sura + ', আয়াত ' + r.aya + ' (' + r.matchCount + 'টি মিল)</div>';
        html += '<div class="search-result-text">' + r.highlighted + '</div>';
        html += '<button onclick="window.selectAyaFromSearch(' + i + ')" style="margin-top:3px;background:var(--gold);color:#000;border:none;padding:2px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-size:0.65rem;">নির্বাচন</button>';
        html += '</div>';
      });
      
      addBotMessage(html, 'normal', true);
    }

    window.selectAyaFromSearch = function(index) {
      var result = state.currentSearchResults[index];
      if (result) {
        selectAya(result.sura, result.aya);
      }
    };

