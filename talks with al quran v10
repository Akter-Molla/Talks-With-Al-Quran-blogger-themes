        saveSettings();
      });
      
      document.getElementById('arabic-font-size').addEventListener('input', function() {
        document.getElementById('arabic-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      document.getElementById('audio-speed').addEventListener('input', function() {
        document.getElementById('audio-speed-value').textContent = this.value + 'x';
        saveSettings();
      });

      document.querySelectorAll('#bengali-font-family, #arabic-font-family, #auto-play-audio').forEach(function(el) {
        el.addEventListener('change', saveSettings);
      });

      document.getElementById('reset-settings').addEventListener('click', resetSettings);

      // Tafsir modal
      dom.closeTafsir.addEventListener('click', closeTafsirModal);
      dom.tafsirModal.addEventListener('click', function(e) {
        if (e.target === dom.tafsirModal) closeTafsirModal();
      });

      // PDF Viewer
      dom.pdfCloseBtn.addEventListener('click', closePDFViewer);
      dom.pdfPrevBtn.addEventListener('click', function() {
        if (state.pdfDoc && state.pdfPageNum > 1) {
          state.pdfPageNum--;
          renderPDFPage();
        }
      });
      dom.pdfNextBtn.addEventListener('click', function() {
        if (state.pdfDoc && state.pdfPageNum < state.pdfTotalPages) {
          state.pdfPageNum++;
          renderPDFPage();
        }
      });
      dom.pdfFullscreenBtn.addEventListener('click', function(e) {
        e.preventDefault();
        togglePdfFullscreen();
      });
      dom.pdfZoomInBtn.addEventListener('click', function() {
        state.pdfScale = Math.min(3.0, state.pdfScale + 0.2);
        if (state.pdfDoc) renderPDFPage();
      });
      dom.pdfZoomOutBtn.addEventListener('click', function() {
        state.pdfScale = Math.max(0.5, state.pdfScale - 0.2);
        if (state.pdfDoc) renderPDFPage();
      });
      dom.pdfBuyBtn.style.display = 'none';
      dom.pdfViewer.addEventListener('click', function(e) {
        if (e.target === dom.pdfViewer && !state.isPdfFullscreen) {
          closePDFViewer();
        }
      });

      // Keyboard shortcuts
      document.addEventListener('keydown', function(e) {
        if (dom.pdfViewer.classList.contains('active')) {
          if (e.key === 'f' || e.key === 'F') {
            e.preventDefault();
            togglePdfFullscreen();
          }
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            if (state.pdfDoc && state.pdfPageNum > 1) {
              state.pdfPageNum--;
              renderPDFPage();
            }
          }
          if (e.key === 'ArrowRight') {
            e.preventDefault();
            if (state.pdfDoc && state.pdfPageNum < state.pdfTotalPages) {
              state.pdfPageNum++;
              renderPDFPage();
            }
          }
          if (e.key === 'Escape') {
            if (state.isPdfFullscreen) {
              togglePdfFullscreen();
            } else {
              closePDFViewer();
            }
          }
        }
        
        if (e.key === 'Escape') {
          closeTafsirModal();
          closeSuraPanel();
          closeSettingsPanel();
        }
      });

      dom.input.focus();
      console.log('🤖 কুরআন বট ৭.০ লোড হয়েছে!');
      console.log('📚 মোট বই:', state.allBooks.length);
      console.log('📖 মোট আয়াত:', state.quranData.length);
      console.log('📜 মোট হাদিস:', state.hadithData.length);
    }

    function renderPDFPage() {
      // Placeholder for PDF.js rendering - not needed for Google Drive embed
    }

    // ============================================================
    // 23. START APPLICATION
    // ============================================================
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
