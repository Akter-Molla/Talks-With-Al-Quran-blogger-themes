    function handleBookCommand(query) {
      var bookPatterns = [
        /বই[\s]*(পড়|পড়|খুল|দেখ|শো|read|open|show|খোলো|দেখাও|পড়ো)[\s]*(.+)/i,
        /পিডিএফ[\s]*(পড়|পড়|খুল|দেখ|শো|read|open|show|খোলো|দেখাও|পড়ো)[\s]*(.+)/i,
        /(পড়|পড়|খুল|দেখ|শো|read|open|show|খোলো|দেখাও|পড়ো)[\s]*(বই|পিডিএফ|pdf|book)[\s]*(.+)/i,
        /বই[\s]*(.+)/i,
        /book[\s]*(.+)/i,
        /pdf[\s]*(.+)/i
      ];
      
      var bookName = null;
      for (var i = 0; i < bookPatterns.length; i++) {
        var match = query.match(bookPatterns[i]);
        if (match) {
          bookName = match[match.length - 1];
          break;
        }
      }
      
      if (!bookName) {
        var cleaned = query.replace(/বই|পিডিএফ|pdf|book|পড়|পড়|খুল|দেখ|শো|read|open|show|দেখা|পড়া|খোলো|দেখাও|পড়ো/gi, '').trim();
        if (cleaned.length > 1) bookName = cleaned;
      }
      
      if (bookName && bookName.length > 1) {
        var book = findBookByName(bookName);
        if (book) {
          var viewUrl = book.driveId ? getDriveViewUrl(book.driveId) : null;
          if (viewUrl) {
            addBotMessage('📖 "' + book.title + '" বইটি খোলা হচ্ছে...', 'info');
            loadPDF(viewUrl, book.title, book);
            return true;
          } else {
            addBotMessage('❌ "' + book.title + '" বইটির PDF লিংক উপলব্ধ নেই।', 'error');
            return true;
          }
        } else {
          addBotMessage('❌ "' + bookName + '" নামে কোনো বই পাওয়া যায়নি। "বই" লিখে সব বই দেখুন।', 'error');
          return true;
        }
      }
      return false;
    }

