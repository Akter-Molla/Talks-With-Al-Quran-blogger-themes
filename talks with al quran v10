    function findBookByName(name) {
      if (!state.allBooks || state.allBooks.length === 0) return null;
      var searchName = name.toLowerCase().trim();
      searchName = searchName.replace(/বই|পড়|পড়|read|book|খুল|দেখ|show|পিডিএফ|pdf|খোলো|দেখাও|পড়ো/gi, '').trim();
      
      for (var i = 0; i < state.allBooks.length; i++) {
        var book = state.allBooks[i];
        var titleMatch = book.title && book.title.toLowerCase().indexOf(searchName) !== -1;
        var titleEnMatch = book.titleEn && book.titleEn.toLowerCase().indexOf(searchName) !== -1;
        if (titleMatch || titleEnMatch) return book;
      }
      
      return null;
    }

