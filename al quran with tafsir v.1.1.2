    function copyAyaText(sura, aya) {
      var ayaData = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
      });
      var english = state.englishData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var category = getCategoryForVerse(sura, aya);
      
      var text = 'সূরা ' + sura + ', আয়াত ' + aya + '\n';
      if (category) text += 'বিষয়: ' + category + '\n\n';
      if (arabic && arabic.ayat) text += arabic.ayat + '\n\n';
      if (ayaData) text += ayaData.text + '\n\n';
      if (english) text += english.text;
      
      navigator.clipboard.writeText(text).then(function() {
        if (state.currentTab === 'chat') addBotMessage('✅ কপি করা হয়েছে!', 'success');
      }).catch(function() {
        if (state.currentTab === 'chat') addBotMessage('❌ কপি করতে সমস্যা হয়েছে।', 'error');
      });
    }

    window.copyAya = copyAyaText;

    // ============================================================
    // 13. CHAT QUERY PROCESSING
    // ============================================================
    function processQuery(query) {
      if (state.isLoading) return;
      var trimmed = query.trim();
      if (!trimmed) {
        addBotMessage('❌ অনুগ্রহ করে একটি প্রশ্ন লিখুন।', 'error');
        return;
      }

      if (!state.dataLoaded) {
        addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
        return;
      }

      addUserMessage(trimmed);
      dom.chatInput.value = '';
      dom.chatInput.focus();

      showTyping();
      state.isLoading = true;

      setTimeout(function() {
        removeTyping();
        state.isLoading = false;

        try {
          var lower = trimmed.toLowerCase();

          // Surah:Ayah patterns
          var surahAyahMatch = null;
          var colonMatch = trimmed.match(/^(\d+)[:\.\*\/,]\s*(\d+)$/);
          if (colonMatch) surahAyahMatch = colonMatch;
          
          if (!surahAyahMatch) {
            var bengaliMatch = trimmed.match(/সূরা\s*(\d+)\s*আয়াত\s*(\d+)/i);
            if (bengaliMatch) surahAyahMatch = bengaliMatch;
          }
          
          if (!surahAyahMatch) {
            var bengaliTextMatch = trimmed.match(/সূরা\s*([০-৯]+)\s*আয়াত\s*([০-৯]+)/i);
            if (bengaliTextMatch) {
              var bnMap = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
              var sura = bengaliTextMatch[1].replace(/[০-৯]/g, function(m) { return bnMap[m] || m; });
              var aya = bengaliTextMatch[2].replace(/[০-৯]/g, function(m) { return bnMap[m] || m; });
              surahAyahMatch = [null, sura, aya];
            }
          }
          
          if (surahAyahMatch) {
            var sura = surahAyahMatch[1];
            var aya = surahAyahMatch[2];
            selectAya(sura, aya);
            return;
          }

          // Command map - switch to appropriate tab
          if (lower.indexOf('হোম') !== -1 || lower.indexOf('home') !== -1) {
            switchTab('chat');
            clearChat();
            return;
          }
          if (lower.indexOf('কুরআন') !== -1 || lower.indexOf('quran') !== -1) {
            switchTab('quran');
            return;
          }
          if (lower.indexOf('ব্লগ') !== -1 || lower.indexOf('blog') !== -1) {
            switchTab('blog');
            renderBlogPosts();
            return;
          }
          if (lower.indexOf('বই') !== -1 || lower.indexOf('book') !== -1 || lower.indexOf('পিডিএফ') !== -1) {
            switchTab('books');
            renderBooks();
            return;
          }
          if (lower.indexOf('হাদিস') !== -1 || lower.indexOf('hadith') !== -1) {
            switchTab('hadith');
            renderHadith();
            return;
          }
          if (lower.indexOf('নামাজ') !== -1 || lower.indexOf('সালাত') !== -1 || lower.indexOf('সময়') !== -1) {
            switchTab('prayer');
            renderPrayer();
            return;
          }
          if (lower.indexOf('যাকাত') !== -1 || lower.indexOf('zakat') !== -1) {
            switchTab('zakat');
            renderZakat();
            return;
          }
          if (lower.indexOf('টাইমার') !== -1 || lower.indexOf('timer') !== -1) {
            switchTab('timer');
            renderTimer();
            return;
          }
          if (lower.indexOf('কুইজ') !== -1 || lower.indexOf('quiz') !== -1) {
            switchTab('quiz');
            startQuizPanel();
            return;
          }
          if (lower.indexOf('জ্ঞান') !== -1 || lower.indexOf('knowledge') !== -1) {
            switchTab('knowledge');
            renderKnowledge();
            return;
          }
          if (lower.indexOf('সাহায্য') !== -1 || lower.indexOf('help') !== -1) {
            switchTab('help');
            renderHelp();
            return;
          }

          addBotMessage('🤔 আমি এই প্রশ্নের উত্তর দিতে পারছি না। "সাহায্য" লিখে সাহায্য নিন।', 'info');
        } catch (error) {
          console.error('Query error:', error);
          addBotMessage('❌ প্রক্রিয়াকরণে সমস্যা হয়েছে।', 'error');
        }
      }, 500);
    }

    function selectAya(sura, aya) {
      if (!state.dataLoaded || state.quranData.length === 0) {
        addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
        return;
      }
      var result = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      
      if (result) {
        state.currentAya = result;
        state.currentAyaIndex = state.quranData.indexOf(result);
        displayAyaResult(result);
      } else {
        addBotMessage('❌ সূরা ' + sura + ', আয়াত ' + aya + ' পাওয়া যায়নি।', 'error');
      }
    }

    function displayAyaResult(aya) {
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(aya.sura) && String(a.VerseIDAr) === String(aya.aya);
      });
      
      var english = state.englishData.find(function(a) {
        return String(a.sura) === String(aya.sura) && String(a.aya) === String(aya.aya);
      });

      var category = getCategoryForVerse(aya.sura, aya.aya);
      
      var html = '<strong>সূরা ' + aya.sura + ', আয়াত ' + aya.aya + ' (সূরা ' + getSurahName(parseInt(aya.sura)) + ')</strong>';
      if (category) html += '<br>' + formatCategoryDisplay(category);
      if (arabic && arabic.ayat) html += '<div class="arabic-text">' + arabic.ayat + '</div>';
      html += '<div style="padding:0.3rem 0.5rem;background:#f8f9fa;border-radius:var(--rounded);border-left:4px solid var(--primary);margin:0.2rem 0;">' + aya.text + '</div>';
      if (english && english.text) {
        html += '<div style="padding:0.3rem 0.5rem;background:#fff8e1;border-radius:var(--rounded);border-left:4px solid var(--gold);margin:0.2rem 0;font-style:italic;font-size:0.9rem;color:var(--text-light);">🇬🇧 ' + english.text + '</div>';
      }
      
      html += '<div style="display:flex;gap:0.2rem;flex-wrap:wrap;margin-top:0.2rem;justify-content:center;">';
      html += '<button onclick="window.showTafsir(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--primary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">📖 তাফসীর</button>';
      html += '<button onclick="window.playAudio(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--secondary);color:#fff;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">🎧 শুনুন</button>';
      html += '<button onclick="window.copyAya(\'' + aya.sura + '\',\'' + aya.aya + '\')" style="background:var(--gold);color:#000;border:none;padding:3px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-family:var(--font-ui);font-size:0.6rem;">📋 কপি</button>';
      html += '</div>';
      
      addBotMessage(html, 'normal', true);
    }

