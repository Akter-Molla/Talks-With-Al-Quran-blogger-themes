    // ============================================================
    // 5. CHAT MESSAGE FUNCTIONS (only for chat tab)
    // ============================================================
    function addChatMessage(text, isUser, type, isHTML) {
      isUser = isUser || false;
      type = type || 'normal';
      isHTML = isHTML || false;
      
      var div = document.createElement('div');
      div.className = 'message ' + (isUser ? 'user' : 'bot');
      if (!isUser && type !== 'normal') {
        div.classList.add(type);
      }
      
      if (isHTML) {
        div.innerHTML = text + '<div class="message-timestamp">' + getTimestamp() + '</div>';
      } else {
        div.textContent = text;
        div.innerHTML += '<div class="message-timestamp">' + getTimestamp() + '</div>';
      }
      
      dom.chatMessages.appendChild(div);
      dom.chatMessages.scrollTop = dom.chatMessages.scrollHeight;
      return div;
    }

    function addUserMessage(text) {
      return addChatMessage(text, true);
    }

    function addBotMessage(text, type, isHTML) {
      type = type || 'normal';
      isHTML = isHTML || false;
      return addChatMessage(text, false, type, isHTML);
    }

    function showTyping() {
      var div = document.createElement('div');
      div.id = 'typing-indicator';
      div.className = 'typing-indicator';
      div.innerHTML = '<span></span><span></span><span></span>';
      dom.chatMessages.appendChild(div);
      dom.chatMessages.scrollTop = dom.chatMessages.scrollHeight;
    }

    function removeTyping() {
      var el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    function clearChat() {
      dom.chatMessages.innerHTML = '';
    }

    // ============================================================
    // 6. TAB SWITCHING - ONLY ACTIVE TAB WORKS
    // ============================================================
    function switchTab(tabId) {
      // Don't switch if already on this tab
      if (state.currentTab === tabId) return;
      
      // Update tab buttons
      dom.tabButtons.forEach(function(btn) {
        btn.classList.toggle('active', btn.getAttribute('data-tab') === tabId);
      });
      
      // Update panels
      Object.keys(dom.tabPanels).forEach(function(key) {
        var panel = dom.tabPanels[key];
        if (panel) {
          panel.classList.toggle('active', key === tabId);
        }
      });
      
      // Show/hide chat input area (only show in chat tab)
      if (dom.chatInputArea) {
        dom.chatInputArea.style.display = tabId === 'chat' ? 'flex' : 'none';
      }
      
      state.currentTab = tabId;
      
      // Render content when switching to certain tabs (only if data is loaded)
      if (state.dataLoaded) {
        if (tabId === 'blog') renderBlogPosts();
        if (tabId === 'books') renderBooks();
        if (tabId === 'hadith') renderHadith();
        if (tabId === 'prayer') renderPrayer();
        if (tabId === 'zakat') renderZakat();
        if (tabId === 'timer') renderTimer();
        if (tabId === 'quiz') renderQuiz();
        if (tabId === 'knowledge') renderKnowledge();
        if (tabId === 'help') renderHelp();
        if (tabId === 'quran') renderQtContent();
      }
    }

