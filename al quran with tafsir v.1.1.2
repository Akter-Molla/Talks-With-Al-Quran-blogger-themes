      {q:"শেষ নবীর নাম কি?", o:["হযরত মুহাম্মদ (সা.)","হযরত ঈসা (আ.)","হযরত মূসা (আ.)","হযরত ইব্রাহিম (আ.)"], c:0}
    ];

    var QUIZ_CONFIG = {
      questionsPerQuiz: 5,
      answerDelay: 1400,
      showProgressBar: true,
      shuffleQuestions: true,
      shuffleOptions: true
    };

    function shuffleArray(arr) {
      var a = arr.slice();
      for (var i = a.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = a[i];
        a[i] = a[j];
        a[j] = tmp;
      }
      return a;
    }

    function pickRandomQuizSet(count) {
      var pool = shuffleArray(QUIZ_QUESTIONS);
      var picked = pool.slice(0, Math.min(count, pool.length));
      return picked.map(function(item) {
        var correctText = item.o[item.c];
        var shuffledOptions = QUIZ_CONFIG.shuffleOptions ? shuffleArray(item.o) : item.o.slice();
        var newCorrectIndex = shuffledOptions.indexOf(correctText);
        return { q: item.q, o: shuffledOptions, c: newCorrectIndex };
      });
    }

    function renderQuiz() {
      if (!dom.quizContainer || state.currentTab !== 'quiz') return;
      if (state.quizState && state.quizState.current < state.quizState.total) {
        renderQuizQuestion();
        return;
      }
      dom.quizContainer.innerHTML = '<div style="text-align:center;padding:2rem 0;color:var(--gray-dark);">🧠 "নতুন কুইজ" বাটনে ক্লিক করুন</div>';
    }

    function renderQuizQuestion() {
      if (!state.quizState || state.quizState.current >= state.quizState.total) {
        showQuizResultPanel();
        return;
      }
      
      state.quizState.answered = false;
      var q = state.quizState.questions[state.quizState.current];
      var current = state.quizState.current + 1;
      var total = state.quizState.total;
      var percentage = Math.round((current / total) * 100);
      
      var html = '<div class="quiz-card">';
      html += '<div class="quiz-progress">🧠 প্রশ্ন ' + current + '/' + total + '</div>';
      if (QUIZ_CONFIG.showProgressBar) {
        html += '<div style="width:100%;height:6px;background:rgba(128,128,128,.2);border-radius:20px;overflow:hidden;margin:8px 0 14px;">';
        html += '<div style="width:' + percentage + '%;height:100%;background:var(--gold-gradient);transition:width .3s ease;"></div>';
        html += '</div>';
      }
      html += '<div class="question">' + q.q + '</div>';
      q.o.forEach(function(opt, i) {
        var letter = String.fromCharCode(65 + i);
        html += '<button class="option-btn quiz-option-panel" data-option="' + i + '" onclick="window.answerQuizPanel(' + i + ')">';
        html += '<span style="font-weight:700;margin-right:6px;">' + letter + '.</span>' + opt + '</button>';
      });
      html += '<div style="text-align:center;margin-top:10px;font-size:.72rem;opacity:.75;">স্কোর: ' + state.quizState.score + '/' + state.quizState.current + '</div>';
      html += '</div>';
      dom.quizContainer.innerHTML = html;
    }

    window.answerQuizPanel = function(selected) {
      if (!state.quizState || state.quizState.answered || state.currentTab !== 'quiz') return;
      state.quizState.answered = true;
      
      var q = state.quizState.questions[state.quizState.current];
      var correct = selected === q.c;
      
      var buttons = document.querySelectorAll('.quiz-option-panel');
      buttons.forEach(function(btn) {
        btn.disabled = true;
        btn.style.cursor = 'default';
        var index = parseInt(btn.getAttribute('data-option'), 10);
        if (index === q.c) {
          btn.style.background = 'rgba(34,197,94,.20)';
          btn.style.borderColor = '#22c55e';
          btn.style.color = '#22c55e';
        }
        if (!correct && index === selected) {
          btn.style.background = 'rgba(239,68,68,.20)';
          btn.style.borderColor = '#ef4444';
          btn.style.color = '#ef4444';
        }
      });
      
      if (correct) {
        state.quizState.score++;
        state.quizState.correctAnswers++;
      } else {
        state.quizState.wrongAnswers++;
      }
      
      state.quizState.current++;
      setTimeout(renderQuizQuestion, QUIZ_CONFIG.answerDelay);
    };

    function showQuizResultPanel() {
      if (!state.quizState) return;
      var score = state.quizState.score;
      var total = state.quizState.total;
      var pct = total > 0 ? Math.round((score / total) * 100) : 0;
      
      var msg = '', emoji = '';
      if (pct === 100) { emoji = '🏆'; msg = 'মাশাআল্লাহ! অসাধারণ!'; }
      else if (pct >= 80) { emoji = '🎉'; msg = 'অসাধারণ! আপনার ইসলামিক জ্ঞান খুব ভালো।'; }
      else if (pct >= 60) { emoji = '👍'; msg = 'খুব ভালো! আরও একটু অনুশীলন করুন।'; }
      else if (pct >= 40) { emoji = '📚'; msg = 'ভালো চেষ্টা! আরও পড়াশোনা করলে স্কোর বাড়বে।'; }
      else { emoji = '🌱'; msg = 'হাল ছাড়বেন না। নিয়মিত পড়ুন ও আবার চেষ্টা করুন।'; }
      
      var html = '<div class="quiz-card">';
      html += '<div class="result">📊 কুইজ রেজাল্ট</div>';
      html += '<div style="text-align:center;font-size:1.4rem;font-weight:800;padding:10px 0;">' + score + '/' + total + '</div>';
      html += '<div style="text-align:center;font-size:1rem;margin-bottom:8px;">📈 সঠিক উত্তর: ' + pct + '%</div>';
      html += '<div style="display:flex;justify-content:space-around;text-align:center;margin:10px 0;">';
      html += '<div>✅<br><b>' + state.quizState.correctAnswers + '</b><br><small>সঠিক</small></div>';
      html += '<div>❌<br><b>' + state.quizState.wrongAnswers + '</b><br><small>ভুল</small></div>';
      html += '</div>';
      html += '<div style="text-align:center;padding:10px 0;font-weight:600;">' + emoji + ' ' + msg + '</div>';
      html += '<button onclick="window.startQuizPanel()" style="display:block;width:100%;padding:.55rem;background:var(--gold-gradient);border:none;border-radius:var(--rounded);cursor:pointer;font-weight:700;font-family:var(--font-ui);color:var(--dark);font-size:.78rem;">🔄 আবার চেষ্টা করুন</button>';
      html += '</div>';
      dom.quizContainer.innerHTML = html;
    }

