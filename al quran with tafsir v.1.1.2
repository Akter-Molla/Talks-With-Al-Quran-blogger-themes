  .pdf-viewer-content .pdf-viewer-footer .page-btn {
    padding: 0.08rem 0.35rem;
    border: 1px solid var(--gray-medium);
    border-radius: var(--rounded);
    background: var(--white);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    transition: var(--transition);
  }
  .pdf-viewer-content .pdf-viewer-footer .page-btn:hover:not(:disabled) { background: var(--primary); color: var(--white); border-color: var(--primary); }
  .pdf-viewer-content .pdf-viewer-footer .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .pdf-viewer-content .pdf-viewer-footer .zoom-controls { display: flex; gap: 0.15rem; align-items: center; }
  .pdf-viewer-content .pdf-viewer-footer .zoom-controls .zoom-label { font-size: 0.5rem; color: var(--gray-dark); min-width: 28px; text-align: center; }
  .pdf-viewer-content .pdf-viewer-footer .zoom-controls .zoom-btn {
    padding: 0.05rem 0.25rem;
    border: 1px solid var(--gray-medium);
    border-radius: var(--rounded);
    background: var(--white);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    transition: var(--transition);
  }
  .pdf-viewer-content .pdf-viewer-footer .zoom-controls .zoom-btn:hover { background: var(--primary); color: var(--white); border-color: var(--primary); }
  .pdf-viewer-content .pdf-viewer-header .viewer-btn {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    cursor: pointer;
    padding: 0.1rem 0.35rem;
    border-radius: var(--rounded);
    transition: var(--transition);
    font-size: 0.55rem;
    font-family: var(--font-ui);
  }
  .pdf-viewer-content .pdf-viewer-header .viewer-btn:hover { background: rgba(255,255,255,0.3); }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes scaleIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }
  @keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

  @media (max-width: 768px) {
    .chatbot-header-premium { padding: 0.25rem 0.5rem; min-height: 40px; }
