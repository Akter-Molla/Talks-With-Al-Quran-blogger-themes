  .home-btn:hover { background: var(--primary-light); transform: translateY(-3px); box-shadow: var(--shadow); }

  /* Modal styles */
  .tafsir-modal-overlay, .pdf-viewer-overlay, .settings-panel-overlay, .sura-panel-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }
  .tafsir-modal-overlay.active, .pdf-viewer-overlay.active, .settings-panel-overlay.active, .sura-panel-overlay.active {
    display: flex;
    animation: fadeIn 0.3s ease;
  }
  .tafsir-modal-content, .pdf-viewer-content, .settings-panel-content, .sura-panel-content {
    background: var(--white);
    border-radius: var(--rounded);
    max-width: 1000px;
    width: 100%;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-large);
    animation: scaleIn 0.3s ease;
    overflow: hidden;
  }
  .tafsir-modal-header, .pdf-viewer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem 0.8rem;
    background: var(--header-gradient);
    color: white;
    flex-shrink: 0;
  }
  .tafsir-modal-header h3, .pdf-viewer-header h3 {
    color: white;
    font-size: 0.85rem;
    margin: 0;
  }
  .tafsir-modal-header .close-modal, .pdf-viewer-header .viewer-btn.close {
    background: rgba(255,255,255,0.15);
    border: none;
    color: white;
    cursor: pointer;
    font-size: 0.85rem;
    padding: 0.05rem 0.35rem;
    border-radius: var(--rounded);
    transition: var(--transition);
  }
  .tafsir-modal-header .close-modal:hover, .pdf-viewer-header .viewer-btn.close:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }
  .tafsir-modal-body, .pdf-viewer-body {
    padding: 0.6rem;
    overflow-y: auto;
    flex: 1;
    line-height: 1.8;
    color: var(--text);
  }

  .settings-panel-content, .sura-panel-content {
    max-width: 800px;
    width: 100%;
    height: 100vh;
    padding: 0.8rem;
    overflow-y: auto;
    animation: slideInRight 0.3s ease;
    border-radius: 0;
  }
  @keyframes slideInRight { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  .settings-panel-content .settings-header, .sura-panel-content .sura-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--gray-medium);
  }
  .settings-panel-content .settings-header h2, .sura-panel-content .sura-header h2 {
    font-size: 0.95rem;
    color: var(--primary);
    margin: 0;
  }
  .settings-panel-content .settings-header .close-settings, .sura-panel-content .sura-header .close-sura {
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    color: var(--gray-dark);
    transition: var(--transition);
    padding: 0.05rem;
  }
  .settings-panel-content .settings-header .close-settings:hover, .sura-panel-content .sura-header .close-sura:hover {
    color: var(--primary);
    transform: rotate(90deg);
  }
  .settings-panel-content .setting-group { margin-bottom: 0.5rem; }
  .settings-panel-content .setting-group label { display: block; font-weight: 600; color: var(--primary); margin-bottom: 0.05rem; font-size: 0.7rem; }
  .settings-panel-content .setting-group .range-container { display: flex; align-items: center; gap: 0.4rem; }
  .settings-panel-content .setting-group input[type="range"] { flex: 1; height: 4px; -webkit-appearance: none; appearance: none; background: var(--gray-medium); border-radius: 3px; outline: none; }
  .settings-panel-content .setting-group input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 12px; height: 12px; border-radius: 50%; background: var(--gold-gradient); cursor: pointer; }
  .settings-panel-content .setting-group .range-value { min-width: 30px; text-align: center; font-weight: 700; color: var(--primary); font-size: 0.75rem; background: var(--light-green); padding: 0.05rem 0.25rem; border-radius: var(--rounded); }
  .settings-panel-content .setting-group select { width: 100%; padding: 0.2rem 0.35rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded); font-family: var(--font-ui); font-size: 0.7rem; background: var(--white); color: var(--text); }
  .settings-panel-content .setting-group select:focus { border-color: var(--primary); outline: none; }
