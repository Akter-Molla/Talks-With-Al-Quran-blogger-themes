  .settings-panel-content .setting-group .checkbox-group label { margin-bottom: 0; cursor: pointer; font-size: 0.7rem; }
  .settings-panel-content .btn-reset { width: 100%; padding: 0.25rem; background: var(--primary); color: var(--white); border: none; border-radius: var(--rounded); font-weight: 600; font-family: var(--font-ui); font-size: 0.7rem; cursor: pointer; transition: var(--transition); }
  .settings-panel-content .btn-reset:hover { background: var(--primary-light); transform: translateY(-2px); }

  .sura-panel-content .sura-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); gap: 0.15rem; }
  .sura-panel-content .sura-grid .sura-item { background: var(--light-green);font-size: 6rem; border: 2px solid transparent; border-radius: var(--rounded); padding: 0.1rem 0.05rem; text-align: center; cursor: pointer; transition: var(--transition); font-weight: 600; color: var(--primary); font-size: 0.45rem; font-family: var(--font-ui); }
  .sura-panel-content .sura-grid .sura-item:hover { background: var(--primary); color: var(--white); transform: translateY(-2px); }
  .sura-panel-content .sura-search { width: 100%; padding: 0.2rem 0.4rem; border: 2px solid var(--gray-medium); border-radius: var(--rounded-full); font-family: var(--font-ui); font-size: 0.65rem; background: var(--white); color: var(--text); margin-bottom: 0.3rem; }
  .sura-panel-content .sura-search:focus { border-color: var(--primary); outline: none; }

  .pdf-viewer-content { max-width: 1100px; max-height: 94vh; }
  .pdf-viewer-content .pdf-viewer-body iframe { width: 100%; height: 100%; min-height: 350px; border: none; border-radius: 8px; }
