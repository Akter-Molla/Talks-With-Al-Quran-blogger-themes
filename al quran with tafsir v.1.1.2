    overflow-y: auto;
    padding-bottom: 0.3rem;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.3rem;
    margin-bottom: 0.4rem;
    border-bottom: 2px solid var(--gold);
    flex-shrink: 0;
  }
  .panel-header h2 {
    font-size: 1.1rem;
    color: var(--primary);
    margin: 0;
    font-weight: 800;
  }
  .panel-header .panel-actions {
    display: flex;
    gap: 0.3rem;
  }
  .panel-header .panel-action-btn {
    padding: 0.1rem 0.5rem;
    border: none;
    border-radius: var(--rounded-full);
    background: var(--primary);
    color: var(--white);
    font-size: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--font-ui);
    transition: var(--transition);
  }
  .panel-header .panel-action-btn:hover {
    background: var(--primary-light);
    transform: translateY(-2px);
  }
  .panel-header .panel-action-btn.gold {
    background: var(--gold-gradient);
    color: var(--dark);
  }

  /* Chat Panel - keeps message area */
  .chat-messages-area {
    flex: 1;
    overflow-y: auto;
    padding: 0.2rem 0.1rem;
    min-height: 100px;
  }

  /* Welcome inside chat panel */
  .welcome-section-compact {
    text-align: center;
    padding: 0.6rem 0.2rem;
  }
  .welcome-section-compact h1 { font-size: 3rem; color: var(--primary); margin-bottom: 0.1rem; }
  .welcome-section-compact h1 span { background: var(--gold-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .welcome-section-compact .welcome-sub { font-size: 2rem; color: var(--text-light); }

  /* Quick feature grid inside chat panel */
  .quick-feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: 0.3rem;
    max-width: 1280px;
    margin: 0.4rem auto;
  }
  .quick-feature-grid .qf-btn {
    background: var(--white);
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded);
    padding: 0.3rem 0.1rem;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 1rem;
    color: var(--text);
    box-shadow: var(--shadow-sm);
  }
  .quick-feature-grid .qf-btn:hover {
    border-color: var(--gold);
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }
  .quick-feature-grid .qf-btn .qf-icon { font-size: 1.1rem; display: block; margin-bottom: 0.1rem; }
  .quick-feature-grid .qf-btn.primary { border-color: var(--gold); background: var(--gold-gradient); color: var(--dark); }

  /* Blog Panel Styles */
  .blog-post-card {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.4rem;
    margin: 0.25rem 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    border-left: 3px solid var(--gold);
  }
  .blog-post-card .post-title {
    font-weight: 700;
    color: var(--primary);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .blog-post-card .post-summary {
    font-size: 0.7rem;
    color: var(--text-light);
    margin: 0.05rem 0;
  }
  .blog-post-card .post-content {
    font-size: 0.7rem;
    margin: 0.1rem 0;
  }
  .blog-post-card .post-meta {
    font-size: 0.5rem;
    color: var(--gray-dark);
  }
  .blog-search-box {
    display: flex;
    gap: 0.3rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }
  .blog-search-box input {
    flex: 1;
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded-full);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    background: var(--white);
    color: var(--text);
    min-width: 80px;
  }
  .blog-search-box input:focus {
    border-color: var(--gold);
    outline: none;
  }
  .blog-search-box button {
    padding: 0.2rem 0.6rem;
    border: none;
    border-radius: var(--rounded-full);
    background: var(--gold-gradient);
    color: var(--dark);
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.65rem;
    transition: var(--transition);
  }
  .blog-search-box button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  /* Book Panel Styles */
  .book-grid-panel {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.4rem;
    margin: 0.2rem 0;
  }
  .book-card-panel {
    background: var(--white);
    border-radius: var(--rounded);
    padding: 0.4rem;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
    border: 2px solid var(--gray-light);
    text-align: center;
  }
  .book-card-panel:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
    border-color: var(--gold);
  }
  .book-card-panel .book-icon { font-size: 1.6rem; display: block; }
  .book-card-panel .book-title { font-size: 0.65rem; font-weight: 700; color: var(--primary); }
  .book-card-panel .book-author { font-size: 0.5rem; color: var(--gray-dark); }
  .book-card-panel .book-actions { display: flex; gap: 0.15rem; justify-content: center; margin-top: 0.1rem; flex-wrap: wrap; }
  .book-card-panel .book-btn {
    padding: 0.08rem 0.35rem;
    border: none;
    border-radius: var(--rounded-full);
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-ui);
    font-size: 0.45rem;
    transition: var(--transition);
  }
  .book-card-panel .book-btn.preview { background: var(--gold-gradient); color: var(--dark); }
  .book-card-panel .book-btn.preview:hover { transform: translateY(-2px); }
  .book-card-panel .book-btn.download { background: var(--primary); color: var(--white); }
  .book-card-panel .book-btn.download:hover { background: var(--primary-light); transform: translateY(-2px); }

  .book-category-filter {
    display: flex;
    gap: 0.2rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .book-category-filter .cat-btn {
    padding: 0.1rem 0.5rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded-full);
    background: var(--white);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.5rem;
    font-weight: 600;
    transition: var(--transition);
    color: var(--text);
  }
  .book-category-filter .cat-btn:hover {
    border-color: var(--primary);
    background: rgba(26,71,42,0.05);
  }
  .book-category-filter .cat-btn.active {
    border-color: var(--gold);
    background: var(--gold-gradient);
    color: var(--dark);
  }

  /* Quran-Tafsir Tab inside panel system */
  .qt-panel-controls {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
    background: var(--white);
    padding: 0.4rem;
    border-radius: var(--rounded);
    box-shadow: var(--shadow-sm);
  }
  .qt-panel-controls select,
  .qt-panel-controls input {
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--gray-medium);
    border-radius: var(--rounded);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    background: var(--white);
    color: var(--text);
    flex: 1;
    min-width: 70px;
  }
  .qt-panel-controls select:focus,
  .qt-panel-controls input:focus {
    border-color: var(--gold);
    outline: none;
  }
  .qt-panel-controls button {
    padding: 0.25rem 0.8rem;
    border: none;
    border-radius: var(--rounded-full);
    background: var(--gold-gradient);
    color: var(--dark);
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 0.75rem;
    transition: var(--transition);
  }
  .qt-panel-controls button:hover {
    transform: translateY(-2px);
