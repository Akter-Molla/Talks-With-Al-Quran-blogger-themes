    box-shadow: var(--shadow-sm);
  }
  @keyframes messageSlide { from { opacity: 0; transform: translateY(20px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
  .message.user {
    background: linear-gradient(135deg, #e8f0fe, #d4e0fa);
    margin-left: auto;
    border-bottom-right-radius: 0.3rem;
    color: #0d47a1;
    border: 1px solid #bbdefb;
  }
  [data-theme="dark"] .message.user { background: linear-gradient(135deg, #1a2a4a, #0d1a3a); color: #90caf9; border-color: #1a3a5a; }
  .message.bot {
    background: linear-gradient(135deg, var(--light-green), #e8f5e8);
