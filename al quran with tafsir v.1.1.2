  }
  .chat-input-area input:focus { border-color: var(--gold); box-shadow: 0 0 0 4px rgba(212,175,55,0.15); }

  .input-btn {
    padding: 0.2rem 0.5rem; border: none; border-radius: var(--rounded-full); cursor: pointer; transition: var(--transition); font-weight: 600; font-family: var(--font-ui); font-size: 0.65rem; display: flex; align-items: center; gap: 0.1rem; min-height: 28px;
  }
  .input-btn.send { background: var(--gold-gradient); color: var(--dark); box-shadow: 0 3px 15px rgba(212,175,55,0.3); }
  .input-btn.send:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 6px 25px rgba(212,175,55,0.4); }
  .input-btn.secondary { background: var(--primary); color: var(--white); }
  .input-btn.secondary:hover:not(:disabled) { background: var(--primary-light); transform: translateY(-3px); }
  .input-btn.outline { background: transparent; border: 1px solid var(--gray-medium); color: var(--text); }
  .input-btn.outline:hover:not(:disabled) { border-color: var(--primary); background: rgba(26,71,42,0.05); transform: translateY(-3px); }

  /* Message styles */
  .message {
