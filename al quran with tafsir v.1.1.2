    // ============================================================
    // 19. QUICK ACTION HANDLER - switches to appropriate tab
    // ============================================================
    function handleQuickAction(action) {
      if (!state.dataLoaded) {
        if (state.currentTab === 'chat') addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
        return;
      }
      
      // All quick actions now switch to the appropriate tab first
      switch(action) {
        case 'quran':
          switchTab('quran');
          break;
        case 'popular':
          // Show popular ayat in chat
          if (state.currentTab !== 'chat') switchTab('chat');
          var popular = [
            {sura:'1', aya:'1', name:'সূরা ফাতিহা'},
            {sura:'2', aya:'255', name:'আয়াতুল কুরসি'},
            {sura:'36', aya:'1', name:'সূরা ইয়াসিন'},
            {sura:'112', aya:'1', name:'সূরা ইখলাস'},
            {sura:'55', aya:'1', name:'সূরা রহমান'}
          ];
          var html = '<strong>⭐ জনপ্রিয় আয়াত</strong><br><br>';
          popular.forEach(function(p, i) {
            var cat = getCategoryForVerse(p.sura, p.aya) || '';
            html += '<button onclick="window.selectAya(\'' + p.sura + '\',\'' + p.aya + '\')" style="display:block;width:100%;margin:2px 0;padding:4px 8px;border:2px solid var(--primary);border-radius:8px;cursor:pointer;background:var(--white);text-align:left;font-family:var(--font-ui);font-weight:600;font-size:0.7rem;">' + (i+1) + '. ' + p.name + '<br><small style="color:var(--gray-dark);font-weight:400;">সূরা ' + p.sura + ', আয়াত ' + p.aya + (cat ? ' | ' + cat : '') + '</small></button>';
          });
          addBotMessage(html, 'normal', true);
          break;
        case 'sura':
          openSuraPanel();
          break;
        case 'prayer':
          switchTab('prayer');
          renderPrayer();
          break;
        case 'hadith':
          switchTab('hadith');
          renderHadith();
          break;
        case 'blog':
          switchTab('blog');
          renderBlogPosts();
          break;
        case 'books':
          switchTab('books');
          renderBooks();
          break;
        case 'zakat':
          switchTab('zakat');
          renderZakat();
          break;
        case 'timer':
          switchTab('timer');
          renderTimer();
          break;
        case 'quiz':
          switchTab('quiz');
          startQuizPanel();
          break;
        case 'knowledge':
          switchTab('knowledge');
          renderKnowledge();
          break;
        case 'help':
          switchTab('help');
          renderHelp();
          break;
        default:
          if (state.currentTab === 'chat') addBotMessage('❓ অজ্ঞাত কমান্ড', 'error');
      }
    }

    // ============================================================
    // 20. INIT
    // ============================================================
    window.goHome = function() { switchTab('chat'); clearChat(); };
    window.selectAya = selectAya;
    window.handleQuickAction = handleQuickAction;
    window.playAudio = playAudio;
    window.copyAya = copyAyaText;
    window.openPDF = openPDF;
    window.showTafsir = showTafsir;
    window.toggleBlogPost = toggleBlogPost;
    window.filterBooksPanel = filterBooksPanel;
    window.startQuizPanel = startQuizPanel;
    window.navKnowledgePanel = navKnowledgePanel;
    window.calculateZakatPanel = calculateZakatPanel;
    window.toggleTimerPanel = toggleTimerPanel;
    window.resetTimerPanel = resetTimerPanel;
    window.answerQuizPanel = answerQuizPanel;

    function init() {
      // Clock
      updateClock();
      setInterval(updateClock, 1000);
      
      // Load data
      loadDataFromGithub();
      
      // Settings & Theme
      loadSettings();
      loadTheme();
      
      // Sura list
      loadSuraList();
      
      // Quran tab
      populateQtSuraSelect();

      // ===== TAB SWITCHING =====
      dom.tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
          var tabId = this.getAttribute('data-tab');
          switchTab(tabId);
        });
      });

      // ===== CHAT EVENTS =====
      dom.sendBtn.addEventListener('click', function() {
        processQuery(dom.chatInput.value);
      });

      dom.chatInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          processQuery(dom.chatInput.value);
        }
      });

      dom.clearBtn.addEventListener('click', function() {
        clearChat();
        dom.chatInput.focus();
      });

      dom.tafsirBtn.addEventListener('click', function() {
        if (state.currentAya) {
          showTafsirModal(state.currentAya.sura, state.currentAya.aya);
        } else {
          addBotMessage('⚠️ প্রথমে একটি আয়াত নির্বাচন করুন।', 'error');
        }
      });

      // ===== HEADER BUTTONS =====
      dom.homeBtn.addEventListener('click', function() { switchTab('chat'); clearChat(); });
      dom.aboutBtn.addEventListener('click', openAboutModal);
      dom.closeAbout.addEventListener('click', closeAboutModal);
      dom.aboutModal.addEventListener('click', function(e) {
        if (e.target === dom.aboutModal) closeAboutModal();
      });

      dom.voiceBtn.addEventListener('click', toggleVoice);
      dom.themeToggle.addEventListener('click', toggleTheme);

      dom.suraPanelBtn.addEventListener('click', openSuraPanel);
      dom.closeSura.addEventListener('click', closeSuraPanel);
      dom.suraSearch.addEventListener('input', function(e) {
        filterSuraList(e.target.value);
      });

      dom.settingsPanelBtn.addEventListener('click', openSettingsPanel);
      dom.closeSettings.addEventListener('click', closeSettingsPanel);

      dom.quranTafsirBtn.addEventListener('click', function() { switchTab('quran'); });

      // ===== QURAN TAB =====
      dom.qtTabQuran.addEventListener('click', function() { setQtMode('quran'); });
      dom.qtTabTafsir.addEventListener('click', function() { setQtMode('tafsir'); });
      dom.qtGoBtn.addEventListener('click', qtGoToInput);
      dom.qtAyaInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); qtGoToInput(); }
      });
      dom.qtPrevBtn.addEventListener('click', function() { qtNavigate(-1); });
      dom.qtNextBtn.addEventListener('click', function() { qtNavigate(1); });
      dom.qtBackChat.addEventListener('click', function() { switchTab('chat'); });

      // ===== BLOG TAB =====
      dom.blogSearchBtn.addEventListener('click', function() {
        renderBlogPosts(dom.blogSearchInput.value);
      });
      dom.blogSearchInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          renderBlogPosts(dom.blogSearchInput.value);
        }
      });
      dom.blogRefreshBtn.addEventListener('click', function() {
        dom.blogSearchInput.value = '';
        renderBlogPosts();
      });

      // ===== BOOKS TAB =====
      dom.bookRefreshBtn.addEventListener('click', renderBooks);

      // ===== HADITH TAB =====
      dom.hadithRandomBtn.addEventListener('click', function() {
        var hadith = state.hadithData[Math.floor(Math.random() * state.hadithData.length)];
        renderHadith(hadith);
      });

      // ===== TIMER TAB =====
      dom.timerResetBtn.addEventListener('click', function() {
        if (state.timerRunning) {
          clearInterval(state.timerInterval);
          state.timerRunning = false;
        }
        state.timerSeconds = 0;
        state.readingTotalTime = 0;
        renderTimer();
      });

      // ===== QUIZ TAB =====
      dom.quizStartBtn.addEventListener('click', startQuizPanel);

      // ===== KNOWLEDGE TAB =====
      dom.knowledgePrevBtn.addEventListener('click', function() { navKnowledgePanel(-1); });
      dom.knowledgeNextBtn.addEventListener('click', function() { navKnowledgePanel(1); });

      // ===== SETTINGS =====
      document.getElementById('bengali-font-size').addEventListener('input', function() {
        document.getElementById('bengali-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      document.getElementById('arabic-font-size').addEventListener('input', function() {
        document.getElementById('arabic-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      document.getElementById('audio-speed').addEventListener('input', function() {
        document.getElementById('audio-speed-value').textContent = this.value + 'x';
        saveSettings();
      });

      document.querySelectorAll('#bengali-font-family, #arabic-font-family, #auto-play-audio').forEach(function(el) {
        el.addEventListener('change', saveSettings);
      });

      document.getElementById('reset-settings').addEventListener('click', resetSettings);

      // ===== MODALS =====
      dom.closeTafsir.addEventListener('click', closeTafsirModal);
      dom.tafsirModal.addEventListener('click', function(e) {
        if (e.target === dom.tafsirModal) closeTafsirModal();
      });

      dom.pdfCloseBtn.addEventListener('click', closePDFViewer);
      dom.pdfFullscreenBtn.addEventListener('click', function(e) {
        e.preventDefault();
        togglePdfFullscreen();
      });
      dom.pdfBuyBtn.style.display = 'none';
      dom.pdfViewer.addEventListener('click', function(e) {
        if (e.target === dom.pdfViewer) closePDFViewer();
      });

      // ===== ESC KEY =====
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeTafsirModal();
          closeSuraPanel();
          closeSettingsPanel();
          closePDFViewer();
          closeAboutModal();
        }
      });

      // ===== QUICK ACTION BUTTONS IN CHAT =====
      document.querySelectorAll('.qf-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var action = this.getAttribute('data-action');
          if (action) {
            handleQuickAction(action);
          }
        });
      });

      dom.chatMessages.addEventListener('click', function(e) {
        var target = e.target.closest('.qf-btn');
        if (target) {
          var action = target.getAttribute('data-action');
          if (action) handleQuickAction(action);
        }
      });

      dom.chatInput.focus();
      console.log('🤖 কুরআন বট ১০.৪ (ট্যাব সিস্টেম - শুধু একটিভ ট্যাব) লোড হয়েছে!');
    }

    // ============================================================
    // 21. START
    // ============================================================
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
  //]]>
  </script>
  <script type='text/javascript'>
//<![CDATA[
  const welcomeHeadingHTML = 'আসসালামু <span>আলাইকুম</span>';
  const welcomeSubText = 'কথা বলুন আল কোরআনের সাথে — Talks With Al Quran\n\nআল কোরআনের আয়াত, বাংলা অনুবাদ, আরবি পাঠ ও তাফসীর সম্পর্কে সহজে জানার একটি অনলাইন প্ল্যাটফর্ম। Talks With Al Quran-এর মাধ্যমে কুরআনের বিভিন্ন বিষয় অনুসন্ধান করুন এবং আয়াতের অর্থ ও ব্যাখ্যা সম্পর্কে জানুন।';

  let textIndex = 0;

  function startTypingEffect() {
    const headingEl = document.getElementById('welcome-heading');
    const subEl = document.getElementById('welcome-sub');

    if (!headingEl || !subEl) return;

    // ১. প্রথমে হেডিং সেট করা
    headingEl.innerHTML = welcomeHeadingHTML;

    // ২. টাইপিং কার্সর তৈরি
    const cursor = document.createElement('span');
    cursor.className = 'typing-cursor';
    subEl.appendChild(cursor);

    // ৩. সাব-টেক্সট লেটার বাই লেটার টাইপ হওয়া
    function typeParagraph() {
      if (textIndex < welcomeSubText.length) {
        cursor.insertAdjacentText('beforebegin', welcomeSubText.charAt(textIndex));
        textIndex++;
        setTimeout(typeParagraph, 100); // টাইপিং স্পিড (মিলিসেকেন্ড)
      } else {
        cursor.remove(); // টাইপিং শেষ হলে কার্সর রিমুভ হবে
      }
    }

    setTimeout(typeParagraph, 400);
  }

  // পেজ লোড হলে কল হবে
  document.addEventListener('DOMContentLoaded', startTypingEffect);
//]]>
</script>
</body>
