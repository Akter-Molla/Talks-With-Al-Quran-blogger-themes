    .quick-feature-grid { grid-template-columns: repeat(auto-fit, minmax(65px, 1fr)); gap: 0.2rem; }
    .quick-feature-grid .qf-btn { font-size: 0.45rem; padding: 0.2rem 0.05rem; }
    .quick-feature-grid .qf-btn .qf-icon { font-size: 0.9rem; }
