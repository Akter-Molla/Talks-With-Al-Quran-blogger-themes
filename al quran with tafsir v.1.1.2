    function setDataStatus(text, isError) {
      if (!dom.dataStatus) return;
      dom.dataStatus.textContent = text || '';
      dom.dataStatus.classList.toggle('error', !!isError);
      dom.dataStatus.classList.remove('hidden');
    }

    function loadDataFromGithub() {
      setDataStatus('🔄 কুরআন ডেটা লোড হচ্ছে (GitHub)...', false);
      state.dataLoaded = false;

      Promise.all([
        fetch(GITHUB_QURAN_SOURCES.bengali).then(function(r) { if (!r.ok) throw new Error('বাংলা অনুবাদ লোড ব্যর্থ'); return r.json(); }),
        fetch(GITHUB_QURAN_SOURCES.arabic).then(function(r) { if (!r.ok) throw new Error('আরবি টেক্সট লোড ব্যর্থ'); return r.json(); }),
        fetch(GITHUB_QURAN_SOURCES.tafsir).then(function(r) { if (!r.ok) throw new Error('তাফসীর লোড ব্যর্থ'); return r.json(); }),
        fetch(GITHUB_QURAN_SOURCES.english).then(function(r) { if (!r.ok) throw new Error('ইংরেজি অনুবাদ লোড ব্যর্থ'); return r.json(); }),
        fetch(GITHUB_QURAN_SOURCES.catName).then(function(r) { if (!r.ok) throw new Error('ক্যাটাগরি নাম লোড ব্যর্থ'); return r.json(); }),
        fetch(GITHUB_QURAN_SOURCES.catMapping).then(function(r) { if (!r.ok) throw new Error('ক্যাটাগরি ম্যাপিং লোড ব্যর্থ'); return r.json(); })
      ]).then(function(results) {
        var bnData = results[0];
        var arData = results[1];
        var tafsirRaw = results[2];
        var enData = results[3];
        var catNameData = results[4];
        var catMappingData = results[5];

        if (Array.isArray(bnData) && bnData.length > 0) {
          state.quranData = bnData.map(function(item) {
            return { sura: String(item.sura), aya: String(item.aya), text: item.text };
          });
        } else {
          state.quranData = FALLBACK_QURAN;
        }

        if (Array.isArray(arData) && arData.length > 0) {
          state.arabicData = arData.map(function(item) {
            return { sura: String(item.sura), VerseIDAr: String(item.VerseIDAr), ayat: item.ayat };
          });
        } else {
          state.arabicData = FALLBACK_ARABIC;
        }

        if (Array.isArray(enData) && enData.length > 0) {
          state.englishData = enData.map(function(item) {
            return { sura: String(item.sura), aya: String(item.aya), text: item.text };
          });
        } else {
          state.englishData = FALLBACK_ENGLISH;
        }

        if (tafsirRaw && typeof tafsirRaw === 'object') {
          var flatTafsir = {};
          Object.keys(tafsirRaw).forEach(function(key) {
            var val = tafsirRaw[key];
            if (val && typeof val === 'object' && val.text) {
              flatTafsir[key] = val.text;
            } else if (typeof val === 'string') {
              flatTafsir[key] = val;
            }
          });
          state.tafsirData = flatTafsir;
        } else {
          state.tafsirData = FALLBACK_TAFSIR;
        }

        if (Array.isArray(catNameData) && catNameData.length > 0) {
          state.categoryNames = {};
          catNameData.forEach(function(item) {
            if (item.id && item.name) {
              state.categoryNames[String(item.id)] = item.name;
            }
          });
        }

        state.verseCategories = {};
        if (Array.isArray(catMappingData) && catMappingData.length > 0) {
          catMappingData.forEach(function(item) {
            if (item.cat && item.sura && item.aya) {
              var key = String(item.sura) + ':' + String(item.aya);
              var catId = String(item.cat);
              var catName = state.categoryNames[catId] || 'বিষয় ' + catId;
              if (!state.verseCategories[key]) {
                state.verseCategories[key] = catName;
              }
            }
          });
        }

        state.dataLoaded = true;
        setDataStatus('✅ ডেটা লোড সম্পূর্ণ - ' + state.quranData.length + ' আয়াত', false);
        setTimeout(function() {
          if (dom.dataStatus) dom.dataStatus.classList.add('hidden');
        }, 3000);

        loadBlogPostsAndBooks();
      }).catch(function(err) {
        console.error('GitHub load error:', err);
        state.quranData = FALLBACK_QURAN;
        state.arabicData = FALLBACK_ARABIC;
        state.englishData = FALLBACK_ENGLISH;
        state.tafsirData = FALLBACK_TAFSIR;
        state.dataLoaded = true;
        setDataStatus('⚠️ GitHub থেকে লোড ব্যর্থ, ফলব্যাক ডেটা ব্যবহার করা হচ্ছে', true);
        setTimeout(function() {
          if (dom.dataStatus) dom.dataStatus.classList.add('hidden');
        }, 4000);
        loadBlogPostsAndBooks();
      });
    }

    function loadBlogPostsAndBooks() {
      var feedUrl = window.location.origin + '/feeds/posts/default?alt=json&max-results=10';
      fetch(feedUrl)
        .then(function(response) {
          if (!response.ok) throw new Error('Blog feed not available');
          return response.json();
        })
        .then(function(data) {
          if (data && data.feed && data.feed.entry) {
            state.blogPosts = data.feed.entry.map(function(entry) {
              var content = entry.content ? entry.content.$t || '' : '';
              var summary = entry.summary ? entry.summary.$t || '' : '';
              content = content.replace(/<[^>]*>/g, '').trim();
              summary = summary.replace(/<[^>]*>/g, '').trim() || content.substring(0, 200) + '...';
              return {
                title: entry.title.$t || '',
                content: content,
                summary: summary,
                published: entry.published ? entry.published.$t || '' : '',
                link: entry.link ? entry.link.find(function(l) { return l.rel === 'alternate'; })?.href || '' : '',
                author: entry.author ? entry.author[0]?.name?.$t || '' : '',
                id: entry.id ? entry.id.$t || '' : 'post-' + Math.random().toString(36).substr(2, 9)
              };
            });
          }
        })
        .catch(function() {
          state.blogPosts = [
            {id:'p1', title:'কুরআনের গুরুত্ব ও ফযিলত', content:'কুরআন হলো মানবজাতির জন্য আল্লাহর সর্বশেষ কিতাব।', summary:'কুরআন হলো মানবজাতির জন্য আল্লাহর সর্বশেষ কিতাব।', published:new Date().toISOString(), link:'#', author:'Admin'},
            {id:'p2', title:'নামাজের গুরুত্ব ও সঠিক পদ্ধতি', content:'নামাজ ইসলামের দ্বিতীয় স্তম্ভ। এটি মুমিনের মিরাজ।', summary:'নামাজ ইসলামের দ্বিতীয় স্তম্ভ।', published:new Date().toISOString(), link:'#', author:'Admin'}
          ];
        });

      var bookFeedUrl = window.location.origin + '/feeds/posts/default/-/book?alt=json&max-results=20';
      fetch(bookFeedUrl)
        .then(function(response) {
          if (!response.ok) throw new Error('Book feed not available');
          return response.json();
        })
        .then(function(data) {
          if (data && data.feed && data.feed.entry) {
            var blogBooks = data.feed.entry.map(function(entry) {
              var content = entry.content ? entry.content.$t || '' : '';
              var summary = entry.summary ? entry.summary.$t || '' : '';
              content = content.replace(/<[^>]*>/g, '').trim();
              summary = summary.replace(/<[^>]*>/g, '').trim() || content.substring(0, 150) + '...';
              var driveId = null;
              var driveMatch = content.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
              if (driveMatch) driveId = driveMatch[1];
              var category = 'বই';
              if (entry.category && entry.category.length > 0) {
                var labels = entry.category.map(function(c) { return c.term; });
                var bookLabel = labels.find(function(l) { return l.toLowerCase() !== 'book'; });
                if (bookLabel) category = bookLabel;
              }
              return {
                id: entry.id ? entry.id.$t || '' : 'book-' + Math.random().toString(36).substr(2, 9),
                title: entry.title.$t || 'নামহীন বই',
                author: 'ব্লগার',
                icon: '📖',
                driveId: driveId,
                description: summary,
                category: category,
                price: 'ফ্রী',
                isBloggerBook: true,
                link: entry.link ? entry.link.find(function(l) { return l.rel === 'alternate'; })?.href || '' : ''
              };
            });
            state.books = BOOKS.concat(blogBooks);
          }
        })
        .catch(function() {
          state.books = BOOKS;
        });
    }

    // ============================================================
    // 8. QURAN-TAFSIR TAB FUNCTIONS
    // ============================================================
    function populateQtSuraSelect() {
      if (!dom.qtSuraSelect) return;
      var html = '';
      for (var i = 1; i <= 114; i++) {
        html += '<option value="' + i + '">' + i + '. ' + getSurahName(i) + '</option>';
      }
      dom.qtSuraSelect.innerHTML = html;
      dom.qtSuraSelect.value = state.qtSura;
    }

    function setQtMode(mode) {
      state.qtMode = mode;
      if (dom.qtTabQuran) dom.qtTabQuran.classList.toggle('active', mode === 'quran');
      if (dom.qtTabTafsir) dom.qtTabTafsir.classList.toggle('active', mode === 'tafsir');
      renderQtContent();
    }

    function renderQtContent() {
      if (!dom.qtDisplay) return;
      var sura = state.qtSura;
      var aya = state.qtAya;

      var bengali = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
      });
      var english = state.englishData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var category = getCategoryForVerse(sura, aya);

      if (!bengali && !arabic && !english) {
        dom.qtDisplay.innerHTML = '<div class="qt-empty">এই আয়াতের ডেটা এখনো যোগ করা হয়নি। অন্য সূরা বা আয়াত নম্বর চেষ্টা করুন।</div>';
        return;
      }

      var html = '<strong>সূরা ' + sura + ', আয়াত ' + aya + ' (' + getSurahName(parseInt(sura)) + ')</strong>';
      if (category) html += '<br>' + formatCategoryDisplay(category);

      if (state.qtMode === 'quran') {
        if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
        if (bengali) html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
        if (english) html += '<div class="verse-translation" style="border-left-color:var(--gold);background:#fff8e1;"><strong>ইংরেজি অনুবাদ:</strong><br>' + english.text + '</div>';
        html += '<div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-top:0.3rem;">';
        html += '<button onclick="window.playAudio(\'' + sura + '\',\'' + aya + '\')" style="background:var(--primary);color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.75rem;">🎧 তিলাওয়াত শুনুন</button>';
        html += '<button onclick="window.copyAya(\'' + sura + '\',\'' + aya + '\')" style="background:var(--gold);color:#000;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.75rem;">📋 কপি করুন</button>';
        html += '</div>';
      } else {
        var key = sura + ':' + aya;
        var tafsir = state.tafsirData[key];
        if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
        if (bengali) html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
        if (english) html += '<div class="verse-translation" style="border-left-color:var(--gold);background:#fff8e1;"><strong>ইংরেজি অনুবাদ:</strong><br>' + english.text + '</div>';
        if (tafsir) {
          html += '<div class="tafsir-text"><strong>তাফসীর:</strong><br>' + tafsir + '</div>';
        } else {
          html += '<div class="tafsir-text"><p>এই আয়াতের তাফসীর এখনও যোগ করা হয়নি।</p></div>';
        }
        html += '<div class="tafsir-source"><strong>উৎস:</strong> ইবনে কাসিরের তাফসীর</div>';
      }

      dom.qtDisplay.innerHTML = html;
    }

    function qtGoToInput() {
      var sura = dom.qtSuraSelect ? dom.qtSuraSelect.value : '1';
      var aya = dom.qtAyaInput ? (dom.qtAyaInput.value || '1') : '1';
      state.qtSura = sura;
      state.qtAya = aya;
      renderQtContent();
    }

    function qtNavigate(direction) {
      var currentIndex = state.quranData.findIndex(function(a) {
        return String(a.sura) === String(state.qtSura) && String(a.aya) === String(state.qtAya);
      });

      if (currentIndex === -1) {
        var newAya = parseInt(state.qtAya) + direction;
        if (newAya < 1) newAya = 1;
        state.qtAya = String(newAya);
      } else {
        var newIndex = currentIndex + direction;
        if (newIndex < 0 || newIndex >= state.quranData.length) return;
        state.qtSura = state.quranData[newIndex].sura;
        state.qtAya = state.quranData[newIndex].aya;
      }

      if (dom.qtSuraSelect) dom.qtSuraSelect.value = state.qtSura;
      if (dom.qtAyaInput) dom.qtAyaInput.value = state.qtAya;
      renderQtContent();
    }

    // ============================================================
    // 9. TAB RENDER FUNCTIONS
    // ============================================================
    
    // BLOG - only works when blog tab is active
    function renderBlogPosts(filter) {
      if (!dom.blogContainer || state.currentTab !== 'blog') return;
      var posts = state.blogPosts;
      if (filter) {
        var f = filter.toLowerCase();
        posts = posts.filter(function(p) {
          return p.title.toLowerCase().indexOf(f) !== -1 ||
                 p.content.toLowerCase().indexOf(f) !== -1 ||
                 p.summary.toLowerCase().indexOf(f) !== -1;
        });
      }
      
      if (posts.length === 0) {
        dom.blogContainer.innerHTML = '<div style="text-align:center;color:var(--gray-dark);padding:1rem;">📝 কোনো পোস্ট পাওয়া যায়নি</div>';
        return;
      }
      
      var html = '';
      posts.slice(0, 10).forEach(function(post, i) {
        var pid = post.id || 'post-' + i;
        var expanded = state.expandedPosts[pid] || false;
        html += '<div class="blog-post-card">';
        html += '<div class="post-title" onclick="window.toggleBlogPost(\'' + pid + '\')">' + (i+1) + '. ' + post.title + '</div>';
        if (!expanded) html += '<div class="post-summary">' + (post.summary || post.content.substring(0, 150) + '...') + '</div>';
        if (expanded && post.content) html += '<div class="post-content">' + post.content + '</div>';
        html += '<div class="post-meta">📅 ' + (post.published ? new Date(post.published).toLocaleDateString('bn-BD') : '') + ' | ✍️ ' + post.author + '</div>';
        html += '<div style="display:flex;gap:0.2rem;flex-wrap:wrap;margin-top:0.1rem;">';
        if (!expanded && post.content && post.content.length > 100) {
          html += '<button class="book-btn preview" onclick="window.toggleBlogPost(\'' + pid + '\')">📖 পড়ুন</button>';
        } else if (expanded) {
          html += '<button class="book-btn download" onclick="window.toggleBlogPost(\'' + pid + '\')">⬆️ সংক্ষেপ</button>';
        }
        if (post.link && post.link !== '#') {
          html += '<button class="book-btn download" onclick="window.open(\'' + post.link + '\',\'_blank\')">🔗 লিংক</button>';
        }
        html += '</div></div>';
      });
      dom.blogContainer.innerHTML = html;
    }

    window.toggleBlogPost = function(pid) {
      state.expandedPosts[pid] = !state.expandedPosts[pid];
      renderBlogPosts(dom.blogSearchInput ? dom.blogSearchInput.value : '');
    };

    // BOOKS - only works when books tab is active
    function renderBooks() {
      if (!dom.bookGrid || state.currentTab !== 'books') return;
      var books = state.books;
      var categories = ['সব', ...new Set(books.map(function(b) { return b.category || 'বই'; }))];
      
      var filterHtml = '';
      categories.forEach(function(cat) {
        var active = cat === state.activeCategory ? ' active' : '';
        filterHtml += '<button class="cat-btn' + active + '" onclick="window.filterBooksPanel(\'' + cat + '\')">' + cat + '</button>';
      });
      dom.bookCategoryFilter.innerHTML = filterHtml;
      
      var filtered = state.activeCategory === 'সব' ? books : books.filter(function(b) { return (b.category || 'বই') === state.activeCategory; });
      
      if (filtered.length === 0) {
        dom.bookGrid.innerHTML = '<div style="text-align:center;color:var(--gray-dark);padding:1rem;">📚 কোনো বই পাওয়া যায়নি</div>';
        return;
      }
      
      var html = '';
      filtered.forEach(function(book) {
        var viewUrl = book.driveId ? getDriveViewUrl(book.driveId) : null;
        var icon = book.icon || '📖';
        html += '<div class="book-card-panel">';
        if (book.isBloggerBook) html += '<span style="font-size:0.4rem;background:var(--gold-gradient);color:var(--dark);padding:0.05rem 0.4rem;border-radius:var(--rounded-full);font-weight:700;">📝 ব্লগার</span>';
        html += '<span class="book-icon">' + icon + '</span>';
        html += '<div class="book-title">' + book.title + '</div>';
        html += '<div class="book-author">✍️ ' + book.author + '</div>';
        html += '<div style="font-size:0.6rem;color:var(--gold);font-weight:700;">' + book.price + '</div>';
        html += '<div class="book-actions">';
        if (viewUrl) {
          html += '<button class="book-btn preview" onclick="window.openPDF(\'' + viewUrl + '\', \'' + book.title + '\')">📖 পড়ুন</button>';
        } else {
          html += '<span style="font-size:0.45rem;color:var(--gray-dark);">🔗 লিংক নেই</span>';
        }
        if (book.link) {
          html += '<a class="book-btn download" href="' + book.link + '" target="_blank">🔗 পোস্ট</a>';
        }
        html += '</div></div>';
      });
      dom.bookGrid.innerHTML = html;
    }

    window.filterBooksPanel = function(category) {
      state.activeCategory = category;
      renderBooks();
    };

    // HADITH - only works when hadith tab is active
    function renderHadith(hadith) {
      if (!dom.hadithContainer || state.currentTab !== 'hadith') return;
      if (!hadith) {
        hadith = state.hadithData[Math.floor(Math.random() * state.hadithData.length)];
      }
      var html = '<div class="hadith-card">';
      html += '<div class="hadith-number">📜 হাদিস</div>';
      html += '<div class="hadith-text">' + hadith.text + '</div>';
      html += '<div class="hadith-translation"><strong>অনুবাদ:</strong> ' + hadith.translation + '</div>';
      html += '<div class="hadith-source">📚 ' + hadith.source + ' | 🗣️ ' + hadith.narrator + '</div>';
      html += '</div>';
      dom.hadithContainer.innerHTML = html;
    }

    // PRAYER - only works when prayer tab is active
    function renderPrayer() {
      if (!dom.prayerContainer || state.currentTab !== 'prayer') return;
      var times = { fajr: '০৪:৩০ AM', sunrise: '০৬:০০ AM', dhuhr: '১২:১৫ PM', asr: '০৪:০০ PM', maghrib: '০৬:৩০ PM', isha: '০৮:০০ PM' };
      var html = '<div class="prayer-card"><strong>🕌 আজকের সালাতের সময়সূচী (ঢাকা)</strong><div class="prayer-grid">';
      var items = { 'ফজর': times.fajr, 'সূর্যোদয়': times.sunrise, 'জোহর': times.dhuhr, 'আসর': times.asr, 'মাগরিব': times.maghrib, 'ইশা': times.isha };
      for (var key in items) {
        html += '<div class="prayer-item"><span class="name">' + key + '</span><span class="time">' + items[key] + '</span></div>';
      }
      html += '</div></div>';
      dom.prayerContainer.innerHTML = html;
    }

    // ZAKAT - only works when zakat tab is active
    function renderZakat() {
      if (!dom.zakatContainer || state.currentTab !== 'zakat') return;
      var html = '<div class="zakat-card">';
      html += '<div class="zakat-title">💰 যাকাত ক্যালকুলেটর</div>';
      html += '<div class="zakat-input-group">';
      html += '<label>মোট সম্পদের পরিমাণ (টাকা):</label>';
      html += '<input type="number" id="zakat-wealth" value="100000"/>';
      html += '</div>';
      html += '<div class="zakat-input-group">';
      html += '<label>যাকাতের হার (%):</label>';
      html += '<input type="number" id="zakat-rate" value="2.5" step="0.1"/>';
      html += '</div>';
      html += '<button class="zakat-btn" onclick="window.calculateZakatPanel()">🧮 যাকাত গণনা করুন</button>';
      html += '<div class="zakat-result"><div>আপনার যাকাতের পরিমাণ:</div><div class="amount" id="zakat-amount-panel">প্রয়োজনীয় ইনপুট দিন</div></div>';
      html += '<div style="margin-top:0.2rem;font-size:0.55rem;color:var(--gray-dark);">⚠️ নিসাব: ৫২,৫০০ টাকা</div>';
      html += '</div>';
      dom.zakatContainer.innerHTML = html;
    }

    window.calculateZakatPanel = function() {
      var wealth = parseFloat(document.getElementById('zakat-wealth').value) || 0;
      var rate = parseFloat(document.getElementById('zakat-rate').value) || 2.5;
      var result = document.getElementById('zakat-amount-panel');
      
      if (wealth <= 0) {
        result.textContent = '⚠️ সঠিক সম্পদের পরিমাণ দিন';
        result.style.color = '#c62828';
        return;
      }
      if (wealth < 52500) {
        result.textContent = '⚠️ সম্পদ নিসাবের কম';
        result.style.color = '#f57c00';
        return;
      }
      var zakat = (wealth * rate) / 100;
      result.textContent = '💰 ' + zakat.toFixed(2) + ' টাকা';
      result.style.color = 'var(--primary)';
    };

