    border: 1px solid rgba(255,255,255,0.08);
    color: var(--white);
    padding: 0.25rem 0.6rem;
    border-radius: var(--rounded-full);
    cursor: pointer;
    transition: var(--transition);
    font-size: 0.6rem;
    font-weight: 600;
