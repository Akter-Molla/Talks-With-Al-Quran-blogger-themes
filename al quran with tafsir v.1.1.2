    // ============================================================
    // 16. VOICE
    // ============================================================
    function initVoice() {
      if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
        if (state.currentTab === 'chat') addBotMessage('❌ আপনার ব্রাউজার ভয়েস সাপোর্ট করে না।', 'error');
        return;
      }
      
      var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      state.recognition = new SR();
      state.recognition.lang = 'bn-BD';
      state.recognition.continuous = false;
      state.recognition.interimResults = false;
      
      state.recognition.onstart = function() {
        state.isVoiceActive = true;
        dom.voiceBtn.innerHTML = '🔴 রেকর্ডিং';
        if (state.currentTab === 'chat') addBotMessage('🎤 কথা বলুন...', 'info');
      };
      
      state.recognition.onresult = function(e) {
        var text = e.results[0][0].transcript;
        dom.chatInput.value = text;
        processQuery(text);
      };
      
      state.recognition.onerror = function(e) {
        if (state.currentTab === 'chat') addBotMessage('❌ ভয়েস ত্রুটি: ' + e.error, 'error');
        state.isVoiceActive = false;
        dom.voiceBtn.innerHTML = '🎤 ভয়েস';
      };
      
      state.recognition.onend = function() {
        state.isVoiceActive = false;
        dom.voiceBtn.innerHTML = '🎤 ভয়েস';
      };
    }

    function toggleVoice() {
      if (!state.recognition) initVoice();
      if (!state.recognition) return;
      
      if (state.isVoiceActive) {
        state.recognition.stop();
      } else {
        try {
          state.recognition.start();
        } catch(e) {
          if (state.currentTab === 'chat') addBotMessage('❌ মাইক্রোফোন এক্সেস সমস্যা।', 'error');
        }
      }
    }

