// 19. QUERY PROCESSING (FIXED)
// ============================================================
function processQuery(query) {
  if (state.isLoading) return;
  var trimmed = query.trim();
  if (!trimmed) {
    addBotMessage('❌ অনুগ্রহ করে একটি প্রশ্ন লিখুন।', 'error');
    return;
  }

  if (!state.dataLoaded) {
    addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
    return;
  }

  addUserMessage(trimmed);
  dom.input.value = '';
  dom.input.focus();

  showTyping();
  state.isLoading = true;

  setTimeout(function() {
    removeTyping();
    state.isLoading = false;

    try {
      var lower = trimmed.toLowerCase();

      // ============================================================
      // FIRST: Check for Category/Subject Questions
      // ============================================================
      var categoryKeywords = ['শিরক', 'ঈমান', 'তাওহিদ', 'নামাজ', 'সালাত', 'রোজা', 'সিয়াম', 'জাকাত', 'হজ', 'হজ্জ', 
                              'ইবাদত', 'আল্লাহ', 'রাসূল', 'নবী', 'মুহাম্মদ', 'কুরআন', 'আয়াত', 'সূরা', 
                              'জান্নাত', 'জাহান্নাম', 'ফেরেশতা', 'জিন', 'শয়তান', 'ইসলাম', 'মুসলিম', 
                              'ঈমান', 'আখিরাত', 'কিয়ামত', 'প্রার্থনা', 'দুআ', 'সুপারিশ', 'মৃত্যু', 
                              'পুনরুত্থান', 'হাশর', 'মুনাফিক', 'কাফির', 'মুশরিক', 'তওবা', 'ইস্তিগফার', 
                              'ধৈর্য', 'সবর', 'শুকর', 'তাকওয়া', 'খোদাভীতি', 'ভালোবাসা', 'দয়া', 'করুণা', 
                              'ক্ষমা', 'গুনাহ', 'পাপ', 'সওয়াব', 'নেকি', 'শান্তি', 'সালাম'];
      
      var isCategoryQuestion = false;
      var matchedCategory = null;
      
      // Check if the question contains any category keyword
      for (var i = 0; i < categoryKeywords.length; i++) {
        var keyword = categoryKeywords[i];
        if (lower.indexOf(keyword) !== -1) {
          isCategoryQuestion = true;
          matchedCategory = keyword;
          break;
        }
      }
      
      // Also check for question patterns like "সম্পর্কে কি বলা হয়েছে", "কোন আয়াতে", "আয়াত আছে", etc.
      var questionPatterns = [/সম্পর্কে/, /কি বলা হয়েছে/, /কোন আয়াত/, /আয়াত আছে/, /বলেছে/, /অনুযায়ী/, /বিষয়ে/];
      for (var j = 0; j < questionPatterns.length; j++) {
        if (questionPatterns[j].test(lower)) {
          isCategoryQuestion = true;
          break;
        }
      }
      
      // If it's a category question, handle it specially
      if (isCategoryQuestion) {
        // Extract the search term - remove common Bangla words
        var searchText = trimmed;
        searchText = searchText.replace(/সম্পর্কে|কি|বলা|হয়েছে|কোন|আয়াত|আছে|বলেছে|অনুযায়ী|বিষয়ে|দেখান|খুঁজুন/gi, '').trim();
        
        // If we have a search term, search for ayats
        if (searchText.length > 1) {
          handleCategorySearch(searchText);
        } else if (matchedCategory && matchedCategory.length > 1) {
          handleCategorySearch(matchedCategory);
        } else {
          // If no specific category found, show all categories
          showAllCategories();
        }
        return;
      }

      // ============================================================
      // SECOND: Check for Book Command
      // ============================================================
      // Only check for book commands if the query explicitly mentions "বই" or "pdf"
      // and doesn't look like a category question
      var isBookQuery = /বই|পিডিএফ|pdf|book/.test(lower) && !/কোন আয়াত|সম্পর্কে|বলেছে/.test(lower);
      if (isBookQuery && handleBookCommand(trimmed)) {
        return;
      }

      // ============================================================
      // THIRD: Command Map
      // ============================================================
      var commandMap = {
        'হোম': goHome, 'home': goHome, 'মেনু': goHome, 'menu': goHome,
        'হোমে যাও': goHome, 'go home': goHome,
        'সাহায্য': showHelp, 'help': showHelp, 'গাইড': showHelp, 'guide': showHelp,
        'বই': showBookCorner, 'book': showBookCorner, 'পিডিএফ': showBookCorner, 'pdf': showBookCorner,
        'যাকাত': showZakatCalculator, 'zakat': showZakatCalculator,
        'টাইমার': showTimer, 'timer': showTimer, 'সময়': showTimer,
        'নামাজ': showPrayerTimes, 'সালাত': showPrayerTimes, 'prayer': showPrayerTimes,
        'ওয়াক্ত': showPrayerTimes, 'সময়সূচী': showPrayerTimes,
        'হাদিস': showRandomHadith, 'hadith': showRandomHadith, 'হাদীস': showRandomHadith,
        'ব্লগ': showBlogPosts, 'blog': showBlogPosts, 'পোস্ট': showBlogPosts, 'post': showBlogPosts,
        'কুইজ': startQuiz, 'quiz': startQuiz, 'প্রশ্ন': startQuiz,
        'জ্ঞান': showKnowledgeBase, 'knowledge': showKnowledgeBase,
        'আয়াত': showPopularAyat, 'popular': showPopularAyat, 'জনপ্রিয়': showPopularAyat
      };

      for (var cmd in commandMap) {
        if (lower.indexOf(cmd) !== -1) {
          commandMap[cmd]();
          return;
        }
      }

      // Surah:Ayah patterns - support multiple formats
      var surahAyahMatch = null;
      
      var colonMatch = trimmed.match(/^(\d+)[:\.\*\/,]\s*(\d+)$/);
      if (colonMatch) surahAyahMatch = colonMatch;
      
      if (!surahAyahMatch) {
        var bengaliMatch = trimmed.match(/সূরা\s*(\d+)\s*আয়াত\s*(\d+)/i);
        if (bengaliMatch) surahAyahMatch = bengaliMatch;
      }
      
      if (!surahAyahMatch) {
        var bengaliNumMatch = trimmed.match(/^(\d+)[:\.\*\/,]\s*(\d+)$/);
        if (bengaliNumMatch) surahAyahMatch = bengaliNumMatch;
      }
      
      if (!surahAyahMatch) {
        var bengaliTextMatch = trimmed.match(/সূরা\s*([০-৯]+)\s*আয়াত\s*([০-৯]+)/i);
        if (bengaliTextMatch) {
          var bnMap = {'০':'0','১':'1','২':'2','৩':'3','৪':'4','৫':'5','৬':'6','৭':'7','৮':'8','৯':'9'};
          var sura = bengaliTextMatch[1].replace(/[০-৯]/g, function(m) { return bnMap[m] || m; });
          var aya = bengaliTextMatch[2].replace(/[০-৯]/g, function(m) { return bnMap[m] || m; });
          surahAyahMatch = [null, sura, aya];
        }
      }
      
      if (surahAyahMatch) {
        var sura = surahAyahMatch[1];
        var aya = surahAyahMatch[2];
        selectAya(sura, aya);
        return;
      }

      // Keyword search
      if (trimmed.length >= 2) {
        handleKeywordSearch(trimmed);
      } else if (/সালাম|assalam|hello|hi|হ্যালো/.test(lower)) {
        addBotMessage('ওয়া আলাইকুম আসসালাম! "সাহায্য" লিখে সাহায্য নিন।', 'info');
      } else {
        addBotMessage('🤔 "' + trimmed + '" - আমি এই প্রশ্নের উত্তর দিতে পারছি না।\n\n"সাহায্য" লিখে সাহায্য নিন।', 'info');
      }
    } catch (error) {
      console.error('Query error:', error);
      addBotMessage('❌ প্রক্রিয়াকরণে সমস্যা হয়েছে।', 'error');
    }
  }, 600);
}

// ============================================================
// 20. CATEGORY SEARCH (NEW)
// ============================================================
function handleCategorySearch(category) {
  var searchTerm = category.toLowerCase().trim();
  
  // First, check if we have category mapping for verses
  var categoryResults = [];
  
  // Search in verse categories
  for (var key in state.verseCategories) {
    if (state.verseCategories.hasOwnProperty(key)) {
      var catName = state.verseCategories[key];
      if (catName && catName.toLowerCase().indexOf(searchTerm) !== -1) {
        var parts = key.split(':');
        if (parts.length === 2) {
          var sura = parts[0];
          var aya = parts[1];
          var verseData = state.quranData.find(function(a) {
            return String(a.sura) === String(sura) && String(a.aya) === String(aya);
          });
          if (verseData) {
            categoryResults.push({
              sura: sura,
              aya: aya,
              text: verseData.text,
              category: catName
            });
          }
        }
      }
    }
  }
  
  // If we don't have category results, search in text
  if (categoryResults.length === 0) {
    state.quranData.forEach(function(aya) {
      var text = aya.text.toLowerCase();
      if (text.indexOf(searchTerm) !== -1) {
        // Check if this verse has a category
        var cat = getCategoryForVerse(aya.sura, aya.aya);
        if (cat) {
          categoryResults.push({
            sura: aya.sura,
            aya: aya.aya,
            text: aya.text,
            category: cat
          });
        }
      }
    });
  }
  
  // If still no results, search all text with highlighting
  if (categoryResults.length === 0) {
    // Fall back to regular search
    handleKeywordSearch(category);
    return;
  }
  
  // Limit results to avoid overwhelming
  var results = categoryResults.slice(0, 15);
  
  var html = '<strong>📑 "' + category + '" সম্পর্কিত ' + results.length + 'টি আয়াত পাওয়া গেছে</strong><br><br>';
  
  results.forEach(function(r, i) {
    var arabic = state.arabicData.find(function(a) {
      return String(a.sura) === String(r.sura) && String(a.VerseIDAr) === String(r.aya);
    });
    
    html += '<div class="search-result-item">';
    html += '<div class="search-result-sura">' + (i+1) + '. সূরা ' + r.sura + ', আয়াত ' + r.aya + ' - ' + getSurahName(parseInt(r.sura)) + '</div>';
    if (r.category) html += '<div style="font-size:0.65rem;color:var(--gold);font-weight:600;">📑 ' + r.category + '</div>';
    if (arabic && arabic.ayat) html += '<div style="font-size:0.85rem;text-align:right;direction:rtl;font-family:var(--font-arabic);margin:3px 0;color:var(--text-light);">' + arabic.ayat + '</div>';
    html += '<div class="search-result-text">' + r.text + '</div>';
    html += '<button onclick="window.selectAya(\'' + r.sura + '\',\'' + r.aya + '\')" style="margin-top:3px;background:var(--gold);color:#000;border:none;padding:2px 10px;border-radius:5px;cursor:pointer;font-weight:700;font-size:0.7rem;">📖 বিস্তারিত</button>';
    html += '</div>';
  });
  
  html += '<div class="home-btn-container"><button class="home-btn" onclick="window.goHome()">🏠 হোমে যান</button></div>';
  addBotMessage(html, 'normal', true);
}

