    window.filterBooks = function(category) {
      state.activeCategory = category;
      var grid = document.getElementById('book-grid');
      if (!grid) return;
      
      var books = state.books;
      var filtered = category === 'সব' ? books : books.filter(function(b) { return (b.category || 'বই') === category; });
      
      grid.innerHTML = '';
      filtered.forEach(function(book) {
        var viewUrl = book.driveId ? getDriveViewUrl(book.driveId) : null;
        var icon = book.icon || '📖';
        
        var card = document.createElement('div');
        card.className = 'book-card';
        card.innerHTML = 
          (book.isBloggerBook ? '<span class="book-badge">📝 ব্লগার বই</span>' : '') +
          '<span class="book-icon">' + icon + '</span>' +
          '<div class="book-title">' + book.title + '</div>' +
          '<div class="book-author">✍️ ' + book.author + '</div>' +
          '<div class="book-price">' + book.price + '</div>' +
          '<div class="book-actions">' +
          (viewUrl ? '<button class="book-btn preview" onclick="window.openPDF(\'' + viewUrl + '\', \'' + book.title + '\')">📖 পড়ুন</button>' : '<span style="font-size:0.5rem;color:var(--gray-dark);">🔗 লিংক নেই</span>') +
          (book.link ? '<a class="book-btn download" href="' + book.link + '" target="_blank">🔗 পোস্ট</a>' : '') +
          '</div>';
        grid.appendChild(card);
      });
      
      document.querySelectorAll('.book-category-tab').forEach(function(tab) {
        tab.classList.toggle('active', tab.textContent === category);
      });
    };

    window.openPDF = function(url, title) {
      loadPDF(url, title);
    };

