    // ============================================================
    // 22. KEYWORD SEARCH
    // ============================================================
    function handleKeywordSearch(query) {
      var words = query.toLowerCase().split(/\s+/);
      var results = [];
      
      state.quranData.forEach(function(aya) {
        var text = aya.text.toLowerCase();
        var matchCount = 0;
        var highlighted = aya.text;
        
        words.forEach(function(word) {
          var regex = new RegExp(word, 'gi');
          var matches = text.match(regex);
          if (matches) {
            matchCount += matches.length;
            highlighted = highlighted.replace(regex, function(m) {
              return '<span class="search-highlight">' + m + '</span>';
            });
          }
        });
        
        if (matchCount > 0) {
          results.push({
            sura: aya.sura,
            aya: aya.aya,
            text: aya.text,
            matchCount: matchCount,
            highlighted: highlighted
          });
        }
      });
      
      results.sort(function(a, b) { return b.matchCount - a.matchCount; });
      var top = results.slice(0, 6);
      state.currentSearchResults = top;
      
      if (top.length === 0) {
        addBotMessage('❌ "' + query + '" এর জন্য কোন ফলাফল পাওয়া যায়নি।', 'error');
        return;
      }
      
      var html = '<strong>"' + query + '" এর জন্য ' + top.length + 'টি আয়াত পাওয়া গেছে</strong><br><br>';
      
      top.forEach(function(r, i) {
        var category = getCategoryForVerse(r.sura, r.aya);
        html += '<div class="search-result-item">';
        html += '<div class="search-result-sura">' + (i+1) + '. সূরা ' + r.sura + ', আয়াত ' + r.aya + ' (' + r.matchCount + 'টি মিল)</div>';
        if (category) html += '<div style="font-size:0.65rem;color:var(--gray-dark);">📑 ' + category + '</div>';
        html += '<div class="search-result-text">' + r.highlighted + '</div>';
        html += '<button onclick="window.selectAyaFromSearch(' + i + ')" style="margin-top:3px;background:var(--gold);color:#000;border:none;padding:2px 8px;border-radius:5px;cursor:pointer;font-weight:600;font-size:0.65rem;">নির্বাচন</button>';
        html += '</div>';
      });
      
      addBotMessage(html, 'normal', true);
    }

    window.selectAyaFromSearch = function(index) {
      var result = state.currentSearchResults[index];
      if (result) {
        selectAya(result.sura, result.aya);
      }
    };

    // ============================================================
    // 23. SETTINGS
    // ============================================================
    function loadSettings() {
      var saved = localStorage.getItem('quranChatSettings');
      if (saved) {
        try {
          var settings = JSON.parse(saved);
          var bengaliSize = document.getElementById('bengali-font-size');
          var arabicSize = document.getElementById('arabic-font-size');
          var audioSpeed = document.getElementById('audio-speed');
          if (settings.bengaliSize) {
            bengaliSize.value = settings.bengaliSize;
            document.getElementById('bengali-font-size-value').textContent = settings.bengaliSize + 'px';
          }
          if (settings.arabicSize) {
            arabicSize.value = settings.arabicSize;
            document.getElementById('arabic-font-size-value').textContent = settings.arabicSize + 'px';
          }
          if (settings.audioSpeed) {
            audioSpeed.value = settings.audioSpeed;
            document.getElementById('audio-speed-value').textContent = settings.audioSpeed + 'x';
          }
          document.getElementById('bengali-font-family').value = settings.bengaliFont || 'Kalpurush, Hind Siliguri, sans-serif';
          document.getElementById('arabic-font-family').value = settings.arabicFont || 'Amiri, serif';
          document.getElementById('auto-play-audio').checked = settings.autoPlayAudio || false;
          state.audioSettings.speed = parseFloat(settings.audioSpeed) || 1;
          state.audioSettings.autoPlay = settings.autoPlayAudio || false;
          state.fontSettings.bengaliSize = parseInt(settings.bengaliSize) || 18;
          state.fontSettings.arabicSize = parseInt(settings.arabicSize) || 22;
          state.fontSettings.bengaliFont = settings.bengaliFont || 'Kalpurush, Hind Siliguri, sans-serif';
          state.fontSettings.arabicFont = settings.arabicFont || 'Amiri, serif';
          applySettings();
        } catch(e) {}
      }
    }

    function saveSettings() {
      var settings = {
        bengaliSize: document.getElementById('bengali-font-size').value,
        arabicSize: document.getElementById('arabic-font-size').value,
        audioSpeed: document.getElementById('audio-speed').value,
        bengaliFont: document.getElementById('bengali-font-family').value,
        arabicFont: document.getElementById('arabic-font-family').value,
        autoPlayAudio: document.getElementById('auto-play-audio').checked
      };
      localStorage.setItem('quranChatSettings', JSON.stringify(settings));
      state.audioSettings.speed = parseFloat(settings.audioSpeed);
      state.audioSettings.autoPlay = settings.autoPlayAudio;
      state.fontSettings.bengaliSize = parseInt(settings.bengaliSize);
      state.fontSettings.arabicSize = parseInt(settings.arabicSize);
      state.fontSettings.bengaliFont = settings.bengaliFont;
      state.fontSettings.arabicFont = settings.arabicFont;
      applySettings();
    }

    function applySettings() {
      var root = document.documentElement;
      root.style.setProperty('--bengali-font-size', state.fontSettings.bengaliSize + 'px');
      root.style.setProperty('--arabic-font-size', state.fontSettings.arabicSize + 'px');
      root.style.setProperty('--font-bengali', state.fontSettings.bengaliFont);
      root.style.setProperty('--font-arabic', state.fontSettings.arabicFont);
    }

    function resetSettings() {
      document.getElementById('bengali-font-size').value = 18;
      document.getElementById('bengali-font-size-value').textContent = '18px';
      document.getElementById('arabic-font-size').value = 22;
      document.getElementById('arabic-font-size-value').textContent = '22px';
      document.getElementById('audio-speed').value = 1;
      document.getElementById('audio-speed-value').textContent = '1.0x';
      document.getElementById('bengali-font-family').value = 'Kalpurush, Hind Siliguri, sans-serif';
      document.getElementById('arabic-font-family').value = 'Amiri, serif';
      document.getElementById('auto-play-audio').checked = false;
      saveSettings();
      addBotMessage('✅ সেটিংস রিসেট করা হয়েছে!', 'success');
    }

    // ============================================================
    // 24. SURA LIST
    // ============================================================
    function loadSuraList() {
      var names = ['আল-ফাতিহা','আল-বাকারা','আল-ইমরান','আন-নিসা','আল-মায়িদাহ','আল-আন\'আম','আল-আ\'রাফ','আল-আনফাল','আত-তাওবাহ','ইউনুস','হুদ','ইউসুফ','আর-রাদ','ইবরাহিম','আল-হিজর','আন-নাহল','আল-ইসরা','আল-কাহফ','মারইয়াম','তাহা','আল-আম্বিয়া','আল-হাজ্জ','আল-মুমিনুন','আন-নূর','আল-ফুরকান','আশ-শু\'আরা','আন-নামল','আল-কাসাস','আল-আনকাবুত','আর-রুম','লুকমান','আস-সাজদাহ','আল-আহযাব','সাবা','ফাতির','ইয়াসিন','আস-সাফফাত','সাদ','আয-যুমার','গাফির','ফুসসিলাত','আশ-শুরা','আয-যুখরুফ','আদ-দুখান','আল-জাসিয়াহ','আল-আহকাফ','মুহাম্মদ','আল-ফাতহ','আল-হুজুরাত','কাফ','আয-যারিয়াত','আত-তুর','আন-নাজম','আল-কামার','আর-রহমান','আল-ওয়াকিয়াহ','আল-হাদীদ','আল-মুজাদিলাহ','আল-হাশর','আল-মুমতাহিনাহ','আস-সাফ','আল-জুমু\'আহ','আল-মুনাফিকুন','আত-তাগাবুন','আত-তালাক','আত-তাহরীম','আল-মুলক','আল-কালাম','আল-হাক্কাহ','আল-মা\'আরিজ','নূহ','আল-জিন','আল-মুজাম্মিল','আল-মুদ্দাস্সির','আল-কিয়ামাহ','আল-ইনসান','আল-মুরসালাত','আন-নাবা','আন-নাজি\'আত','আবাসা','আত-তাকভীর','আল-ইনফিতার','আল-মুতাফফিফীন','আল-ইনশিকাক','আল-বুরূজ','আত-তারিক','আল-আ\'লা','আল-গাশিয়াহ','আল-ফাজর','আল-বালাদ','আশ-শামস','আল-লাইল','আদ-দুহা','আল-ইনশিরাহ','আত-তীন','আল-আলাক','আল-কাদর','আল-বাইয়্যিনাহ','আয-যিলযাল','আল-আদিয়াত','আল-কারি\'আহ','আত-তাকাসুর','আল-আসর','আল-হুমাজাহ','আল-ফীল','কুরাইশ','আল-মাউন','আল-কাওসার','আল-কাফিরুন','আন-নাসর','আল-মাসাদ','আল-ইখলাস','আল-ফালাক','আন-নাস'];
      
      var html = '';
      names.forEach(function(name, i) {
        var num = i + 1;
        html += '<div class="sura-item" data-sura="' + num + '">';
        html += '<strong>' + num + '</strong><br>' + name;
        html += '</div>';
      });
      
      dom.suraGrid.innerHTML = html;
      
      dom.suraGrid.querySelectorAll('.sura-item').forEach(function(el) {
        el.addEventListener('click', function() {
          var sura = this.getAttribute('data-sura');
          state.qtSura = sura;
          state.qtAya = '1';
          state.qtMode = 'quran';
          closeSuraPanel();
          openQuranTafsirTab();
        });
      });
    }

    function filterSuraList(query) {
      var items = dom.suraGrid.querySelectorAll('.sura-item');
      var q = query.toLowerCase();
      items.forEach(function(item) {
        var text = item.textContent.toLowerCase();
        item.style.display = text.indexOf(q) !== -1 ? '' : 'none';
      });
    }

    // ============================================================
    // 25. PANEL CONTROLS
    // ============================================================
    function openSuraPanel() {
      dom.suraPanel.classList.add('active');
      document.body.style.overflow = 'hidden';
      dom.suraSearch.focus();
    }

    function closeSuraPanel() {
      dom.suraPanel.classList.remove('active');
      document.body.style.overflow = '';
    }

    function openSettingsPanel() {
      dom.settingsPanel.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeSettingsPanel() {
      dom.settingsPanel.classList.remove('active');
      document.body.style.overflow = '';
    }

    function openAboutModal() {
      dom.aboutModal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeAboutModal() {
      dom.aboutModal.classList.remove('active');
      document.body.style.overflow = '';
    }

    window.closeAboutModal = closeAboutModal;

    // ============================================================
    // 26. QURAN & TAFSIR PANEL
    // ============================================================
    function populateQtSuraSelect() {
      if (!dom.qtSuraSelect) return;
      var html = '';
      for (var i = 1; i <= 114; i++) {
        html += '<option value="' + i + '">' + i + '. ' + getSurahName(i) + '</option>';
      }
      dom.qtSuraSelect.innerHTML = html;
      dom.qtSuraSelect.value = state.qtSura;
    }

    function openQuranTafsirTab() {
      if (!state.dataLoaded) {
        addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
        return;
      }
      if (dom.chatBodyMain) dom.chatBodyMain.style.display = 'none';
      if (dom.chatInputArea) dom.chatInputArea.style.display = 'none';
      dom.quranTafsirTab.classList.add('active');
      if (dom.qtSuraSelect) dom.qtSuraSelect.value = state.qtSura;
      if (dom.qtAyaInput) dom.qtAyaInput.value = state.qtAya;
      if (dom.qtTabQuran) dom.qtTabQuran.classList.toggle('active', state.qtMode === 'quran');
      if (dom.qtTabTafsir) dom.qtTabTafsir.classList.toggle('active', state.qtMode === 'tafsir');
      renderQtContent();
    }

    function closeQuranTafsirTab() {
      dom.quranTafsirTab.classList.remove('active');
      if (dom.chatBodyMain) dom.chatBodyMain.style.display = '';
      if (dom.chatInputArea) dom.chatInputArea.style.display = '';
    }

    function setQtMode(mode) {
      state.qtMode = mode;
      if (dom.qtTabQuran) dom.qtTabQuran.classList.toggle('active', mode === 'quran');
      if (dom.qtTabTafsir) dom.qtTabTafsir.classList.toggle('active', mode === 'tafsir');
      renderQtContent();
    }

    function renderQtContent() {
      if (!dom.qtDisplay) return;
      var sura = state.qtSura;
      var aya = state.qtAya;

      var bengali = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
      });
      var english = state.englishData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var category = getCategoryForVerse(sura, aya);

      if (!bengali && !arabic && !english) {
        dom.qtDisplay.innerHTML = '<div class="qt-empty">এই আয়াতের ডেটা এখনো যোগ করা হয়নি। অন্য সূরা বা আয়াত নম্বর চেষ্টা করুন।</div>';
        return;
      }

      var html = '<strong>সূরা ' + sura + ', আয়াত ' + aya + ' (' + getSurahName(parseInt(sura)) + ')</strong>';
      if (category) html += '<br>' + formatCategoryDisplay(category);

      if (state.qtMode === 'quran') {
        if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
        if (bengali) html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
        if (english) html += '<div class="verse-translation" style="border-left-color:var(--gold);background:#fff8e1;"><strong>ইংরেজি অনুবাদ:</strong><br>' + english.text + '</div>';
        html += '<div style="display:flex;gap:0.3rem;flex-wrap:wrap;margin-top:0.3rem;">';
        html += '<button onclick="window.playAudio(\'' + sura + '\',\'' + aya + '\')" style="background:var(--primary);color:#fff;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.75rem;">🎧 তিলাওয়াত শুনুন</button>';
        html += '<button onclick="window.copyAya(\'' + sura + '\',\'' + aya + '\')" style="background:var(--gold);color:#000;border:none;padding:5px 10px;border-radius:6px;cursor:pointer;font-weight:700;font-family:var(--font-ui);font-size:0.75rem;">📋 কপি করুন</button>';
        html += '</div>';
      } else {
        var key = sura + ':' + aya;
        var tafsir = state.tafsirData[key];
        if (arabic && arabic.ayat) html += '<div class="verse-arabic">' + arabic.ayat + '</div>';
        if (bengali) html += '<div class="verse-translation"><strong>বাংলা অনুবাদ:</strong><br>' + bengali.text + '</div>';
        if (english) html += '<div class="verse-translation" style="border-left-color:var(--gold);background:#fff8e1;"><strong>ইংরেজি অনুবাদ:</strong><br>' + english.text + '</div>';
        if (tafsir) {
          html += '<div class="tafsir-text"><strong>তাফসীর:</strong><br>' + tafsir + '</div>';
        } else {
          html += '<div class="tafsir-text"><p>এই আয়াতের তাফসীর এখনও যোগ করা হয়নি।</p></div>';
        }
        html += '<div class="tafsir-source"><strong>উৎস:</strong> ইবনে কাসিরের তাফসীর</div>';
      }

      dom.qtDisplay.innerHTML = html;
    }

    function qtGoToInput() {
      var sura = dom.qtSuraSelect ? dom.qtSuraSelect.value : '1';
      var aya = dom.qtAyaInput ? (dom.qtAyaInput.value || '1') : '1';
      state.qtSura = sura;
      state.qtAya = aya;
      renderQtContent();
    }

    function qtNavigate(direction) {
      var currentIndex = state.quranData.findIndex(function(a) {
        return String(a.sura) === String(state.qtSura) && String(a.aya) === String(state.qtAya);
      });

      if (currentIndex === -1) {
        var newAya = parseInt(state.qtAya) + direction;
        if (newAya < 1) newAya = 1;
        state.qtAya = String(newAya);
      } else {
        var newIndex = currentIndex + direction;
        if (newIndex < 0 || newIndex >= state.quranData.length) return;
        state.qtSura = state.quranData[newIndex].sura;
        state.qtAya = state.quranData[newIndex].aya;
      }

      if (dom.qtSuraSelect) dom.qtSuraSelect.value = state.qtSura;
      if (dom.qtAyaInput) dom.qtAyaInput.value = state.qtAya;
      renderQtContent();
    }

    // ============================================================
    // 27. VOICE
    // ============================================================
    function initVoice() {
      if (!('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
        addBotMessage('❌ আপনার ব্রাউজার ভয়েস সাপোর্ট করে না।', 'error');
        return;
      }
      
      var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      state.recognition = new SR();
      state.recognition.lang = 'bn-BD';
      state.recognition.continuous = false;
      state.recognition.interimResults = false;
      
      state.recognition.onstart = function() {
        state.isVoiceActive = true;
        dom.voiceBtn.innerHTML = '🔴 রেকর্ডিং';
        addBotMessage('🎤 কথা বলুন...', 'info');
      };
      
      state.recognition.onresult = function(e) {
        var text = e.results[0][0].transcript;
        dom.input.value = text;
        processQuery(text);
      };
      
      state.recognition.onerror = function(e) {
        addBotMessage('❌ ভয়েস ত্রুটি: ' + e.error, 'error');
        state.isVoiceActive = false;
        dom.voiceBtn.innerHTML = '🎤 ভয়েস';
      };
      
      state.recognition.onend = function() {
        state.isVoiceActive = false;
        dom.voiceBtn.innerHTML = '🎤 ভয়েস';
      };
    }

    function toggleVoice() {
      if (!state.recognition) initVoice();
      if (!state.recognition) return;
      
      if (state.isVoiceActive) {
        state.recognition.stop();
      } else {
        try {
          state.recognition.start();
        } catch(e) {
          addBotMessage('❌ মাইক্রোফোন এক্সেস সমস্যা।', 'error');
        }
      }
    }

    // ============================================================
    // 28. THEME
    // ============================================================
    function toggleTheme() {
      state.isDark = !state.isDark;
      document.documentElement.setAttribute('data-theme', state.isDark ? 'dark' : 'light');
      localStorage.setItem('quranTheme', state.isDark ? 'dark' : 'light');
      dom.themeIcon.textContent = state.isDark ? '☀️' : '🌙';
    }

    function loadTheme() {
      var saved = localStorage.getItem('quranTheme');
      if (saved === 'dark') {
        state.isDark = true;
        document.documentElement.setAttribute('data-theme', 'dark');
        dom.themeIcon.textContent = '☀️';
      }
    }

    // ============================================================
    // 29. INIT
    // ============================================================
    window.goHome = goHome;
    window.handleQuickAction = handleQuickAction;
    window.showHelp = showHelp;
    window.startQuiz = startQuiz;
    window.selectAya = selectAya;
    window.showTafsir = showTafsir;
    window.playAudio = playAudio;
    window.copyAya = copyAyaText;
    window.showRandomHadith = showRandomHadith;
    window.navKnowledge = navKnowledge;
    window.toggleBlogPost = toggleBlogPost;
    window.toggleTimer = toggleTimer;
    window.resetTimer = resetTimer;
    window.calculateZakat = calculateZakat;
    window.answerQuizOption = answerQuizOption;
    window.filterBooks = filterBooks;
    window.openPDF = openPDF;
    window.selectAyaFromSearch = selectAyaFromSearch;

    function init() {
      // Clock
      updateClock();
      setInterval(updateClock, 1000);
      
      // Load data from GitHub
      loadDataFromGithub();
      
      // Settings
      loadSettings();
      loadTheme();
      
      // Sura list
      loadSuraList();

      // Quran & Tafsir panel
      populateQtSuraSelect();

      // ===== Event Listeners =====
      
      dom.messages.addEventListener('click', function(e) {
        var target = e.target.closest('.quick-action-premium');
        if (target) {
          var action = target.getAttribute('data-action');
          if (action) handleQuickAction(action);
        }
      });

      document.querySelectorAll('#welcome-section .quick-action-premium').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var action = this.getAttribute('data-action');
          handleQuickAction(action);
        });
      });

      dom.sendBtn.addEventListener('click', function() {
        processQuery(dom.input.value);
      });

      dom.input.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          processQuery(dom.input.value);
        }
      });

      dom.clearBtn.addEventListener('click', function() {
        dom.messages.innerHTML = '';
        if (dom.welcomeSection) {
          dom.welcomeSection.style.display = 'block';
          state.welcomeVisible = true;
        }
        dom.input.focus();
      });

      dom.homeBtn.addEventListener('click', goHome);

      dom.aboutBtn.addEventListener('click', openAboutModal);
      dom.closeAbout.addEventListener('click', closeAboutModal);
      dom.aboutModal.addEventListener('click', function(e) {
        if (e.target === dom.aboutModal) closeAboutModal();
      });

      dom.tafsirBtn.addEventListener('click', function() {
        if (state.currentAya) {
          showTafsirModal(state.currentAya.sura, state.currentAya.aya);
        } else {
          addBotMessage('⚠️ প্রথমে একটি আয়াত নির্বাচন করুন।', 'error');
        }
      });

      dom.voiceBtn.addEventListener('click', toggleVoice);

      dom.themeToggle.addEventListener('click', toggleTheme);

      dom.suraPanelBtn.addEventListener('click', openSuraPanel);
      dom.closeSura.addEventListener('click', closeSuraPanel);
      dom.suraSearch.addEventListener('input', function(e) {
        filterSuraList(e.target.value);
      });

      dom.settingsPanelBtn.addEventListener('click', openSettingsPanel);
      dom.closeSettings.addEventListener('click', closeSettingsPanel);

      dom.quranTafsirBtn.addEventListener('click', openQuranTafsirTab);
      dom.qtBackBtn.addEventListener('click', closeQuranTafsirTab);
      dom.qtTabQuran.addEventListener('click', function() { setQtMode('quran'); });
      dom.qtTabTafsir.addEventListener('click', function() { setQtMode('tafsir'); });
      dom.qtGoBtn.addEventListener('click', qtGoToInput);
      dom.qtAyaInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); qtGoToInput(); }
      });
      dom.qtPrevBtn.addEventListener('click', function() { qtNavigate(-1); });
      dom.qtNextBtn.addEventListener('click', function() { qtNavigate(1); });

      document.getElementById('bengali-font-size').addEventListener('input', function() {
        document.getElementById('bengali-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      document.getElementById('arabic-font-size').addEventListener('input', function() {
        document.getElementById('arabic-font-size-value').textContent = this.value + 'px';
        saveSettings();
      });
      
      document.getElementById('audio-speed').addEventListener('input', function() {
        document.getElementById('audio-speed-value').textContent = this.value + 'x';
        saveSettings();
      });

      document.querySelectorAll('#bengali-font-family, #arabic-font-family, #auto-play-audio').forEach(function(el) {
        el.addEventListener('change', saveSettings);
      });

      document.getElementById('reset-settings').addEventListener('click', resetSettings);

      dom.closeTafsir.addEventListener('click', closeTafsirModal);
      dom.tafsirModal.addEventListener('click', function(e) {
        if (e.target === dom.tafsirModal) closeTafsirModal();
      });

      dom.pdfCloseBtn.addEventListener('click', closePDFViewer);
      dom.pdfFullscreenBtn.addEventListener('click', function(e) {
        e.preventDefault();
        togglePdfFullscreen();
      });
      dom.pdfBuyBtn.style.display = 'none';
      dom.pdfViewer.addEventListener('click', function(e) {
        if (e.target === dom.pdfViewer) closePDFViewer();
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
          closeTafsirModal();
          closeSuraPanel();
          closeSettingsPanel();
          closePDFViewer();
          closeQuranTafsirTab();
          closeAboutModal();
        }
      });

      dom.input.focus();
      console.log('🤖 কুরআন বট ১০.১ লোড হয়েছে!');
    }

    // ============================================================
    // 30. START
    // ============================================================
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }

  })();
//]]>
</script>
</body>
</html>
