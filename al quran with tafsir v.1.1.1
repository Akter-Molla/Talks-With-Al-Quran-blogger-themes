    function playAudio(sura, aya) {
      var url = 'https://cdn.islamic.network/quran/audio/128/ar.alafasy/' + sura + '/' + aya + '.mp3';
      var audio = new Audio(url);
      audio.playbackRate = parseFloat(state.audioSettings.speed || 1);
      audio.play().then(function() {
        addBotMessage('🎧 আয়াত তিলাওয়াত শোনা হচ্ছে...', 'info');
      }).catch(function() {
        addBotMessage('❌ অডিও প্লে করতে সমস্যা হয়েছে।', 'error');
      });
    }

    window.playAudio = playAudio;

    function copyAyaText(sura, aya) {
      var ayaData = state.quranData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var arabic = state.arabicData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.VerseIDAr) === String(aya);
      });
      var english = state.englishData.find(function(a) {
        return String(a.sura) === String(sura) && String(a.aya) === String(aya);
      });
      var category = getCategoryForVerse(sura, aya);
      
      var text = 'সূরা ' + sura + ', আয়াত ' + aya + '\n';
      if (category) text += 'বিষয়: ' + category + '\n\n';
      if (arabic && arabic.ayat) text += arabic.ayat + '\n\n';
      if (ayaData) text += ayaData.text + '\n\n';
      if (english) text += english.text;
      
      navigator.clipboard.writeText(text).then(function() {
        addBotMessage('✅ কপি করা হয়েছে!', 'success');
      }).catch(function() {
        addBotMessage('❌ কপি করতে সমস্যা হয়েছে।', 'error');
      });
    }

    window.copyAya = copyAyaText;

