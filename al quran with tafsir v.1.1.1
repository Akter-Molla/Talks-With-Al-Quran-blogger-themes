// ============================================================
// QUIZ CONFIGURATION
// ============================================================

var QUIZ_CONFIG = {
  questionsPerQuiz: 10,
  answerDelay: 1400,
  showProgressBar: true,
  shuffleQuestions: true,
  shuffleOptions: true
};


// ============================================================
// SHUFFLE ARRAY
// ============================================================

function shuffleArray(arr) {
  var a = arr.slice();

  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));

    var tmp = a[i];
    a[i] = a[j];
    a[j] = tmp;
  }

  return a;
}


// ============================================================
// PICK RANDOM QUIZ SET
// ============================================================

function pickRandomQuizSet(count) {

  var pool = shuffleArray(QUIZ_QUESTIONS);

  var picked = pool.slice(
    0,
    Math.min(count, pool.length)
  );

  return picked.map(function(item) {

    var correctText = item.o[item.c];

    var shuffledOptions = QUIZ_CONFIG.shuffleOptions
      ? shuffleArray(item.o)
      : item.o.slice();

    var newCorrectIndex =
      shuffledOptions.indexOf(correctText);

    return {
      q: item.q,
      o: shuffledOptions,
      c: newCorrectIndex
    };
  });
}


// ============================================================
// START QUIZ
// ============================================================

function startQuiz() {

  var questions = pickRandomQuizSet(
    QUIZ_CONFIG.questionsPerQuiz
  );

  state.quizState = {
    questions: questions,
    current: 0,
    score: 0,
    total: questions.length,
    answered: false,
    correctAnswers: 0,
    wrongAnswers: 0,
    startTime: Date.now()
  };

  askQuizQuestion();
}


// ============================================================
// ASK QUIZ QUESTION
// ============================================================

function askQuizQuestion() {

  if (
    !state.quizState ||
    state.quizState.current >= state.quizState.total
  ) {
    if (state.quizState) {
      showQuizResult();
    }

    return;
  }


  // Prevent accidental double rendering
  state.quizState.answered = false;


  var q =
    state.quizState.questions[
      state.quizState.current
    ];


  var current =
    state.quizState.current + 1;

  var total =
    state.quizState.total;


  var percentage =
    Math.round((current / total) * 100);


  var html = '';

  html += '<div class="quiz-card">';


  // ----------------------------------------------------------
  // Header
  // ----------------------------------------------------------

  html +=
    '<div class="quiz-progress">' +
    '🧠 প্রশ্ন ' +
    current +
    '/' +
    total +
    '</div>';


  // ----------------------------------------------------------
  // Progress bar
  // ----------------------------------------------------------

  if (QUIZ_CONFIG.showProgressBar) {

    html +=
      '<div style="' +
      'width:100%;' +
      'height:6px;' +
      'background:rgba(128,128,128,.2);' +
      'border-radius:20px;' +
      'overflow:hidden;' +
      'margin:8px 0 14px;' +
      '">' +

      '<div style="' +
      'width:' + percentage + '%;' +
      'height:100%;' +
      'background:var(--gold-gradient);' +
      'transition:width .3s ease;' +
      '"></div>' +

      '</div>';
  }


  // ----------------------------------------------------------
  // Question
  // ----------------------------------------------------------

  html +=
    '<div class="question">' +
    q.q +
    '</div>';


  // ----------------------------------------------------------
  // Options
  // ----------------------------------------------------------

  q.o.forEach(function(opt, i) {

    var letter =
      String.fromCharCode(65 + i);

    html +=
      '<button ' +
      'class="option-btn quiz-option" ' +
      'data-option="' + i + '" ' +
      'onclick="window.answerQuizOption(' + i + ')"' +
      '>' +

      '<span style="font-weight:700;margin-right:6px;">' +
      letter +
      '.</span>' +

      opt +

      '</button>';
  });


  // ----------------------------------------------------------
  // Score indicator
  // ----------------------------------------------------------

  html +=
    '<div style="' +
    'text-align:center;' +
    'margin-top:10px;' +
    'font-size:.72rem;' +
    'opacity:.75;' +
    '">' +

    'স্কোর: ' +
    state.quizState.score +
    '/' +
    state.quizState.current +

    '</div>';


  html += '</div>';


  addBotMessage(
    html,
    'normal',
    true
  );
}


// ============================================================
// ANSWER QUIZ OPTION
// ============================================================

window.answerQuizOption = function(selected) {

  if (!state.quizState) return;


  // Prevent multiple clicks
  if (state.quizState.answered) {
    return;
  }


  state.quizState.answered = true;


  var q =
    state.quizState.questions[
      state.quizState.current
    ];


  var correct =
    selected === q.c;


  // ----------------------------------------------------------
  // Get current quiz card buttons
  // ----------------------------------------------------------

  var buttons =
    document.querySelectorAll(
      '.quiz-option'
    );


  // Disable all options
  buttons.forEach(function(btn) {
    btn.disabled = true;
    btn.style.cursor = 'default';
  });


  // ----------------------------------------------------------
  // Highlight correct answer
  // ----------------------------------------------------------

  buttons.forEach(function(btn) {

    var index =
      parseInt(
        btn.getAttribute('data-option'),
        10
      );


    if (index === q.c) {

      btn.style.background =
        'rgba(34,197,94,.20)';

      btn.style.borderColor =
        '#22c55e';

      btn.style.color =
        '#22c55e';
    }
  });


  // ----------------------------------------------------------
  // Highlight selected wrong answer
  // ----------------------------------------------------------

  if (!correct) {

    buttons.forEach(function(btn) {

      var index =
        parseInt(
          btn.getAttribute('data-option'),
          10
        );


      if (index === selected) {

        btn.style.background =
          'rgba(239,68,68,.20)';

        btn.style.borderColor =
          '#ef4444';

        btn.style.color =
          '#ef4444';
      }
    });
  }


  // ----------------------------------------------------------
  // Score + feedback
  // ----------------------------------------------------------

 if (correct) {

  state.quizState.score++;
  state.quizState.correctAnswers++;

  addBotMessage(
    '✅ <b>সঠিক উত্তর!</b> 🎉<br>' +
    'মাশাআল্লাহ! আপনি সঠিক উত্তর দিয়েছেন।',
    'success',
    true
  );

} else {

  state.quizState.wrongAnswers++;

  addBotMessage(
    '❌ <b>ভুল উত্তর!</b><br>' +
    'সঠিক উত্তর: <b>' +
    q.o[q.c] +
    '</b>',
    'error',
    true
  );
}

  // ----------------------------------------------------------
  // Next question
  // ----------------------------------------------------------

  state.quizState.current++;


  setTimeout(
    askQuizQuestion,
    QUIZ_CONFIG.answerDelay
  );
};


// ============================================================
// QUIZ RESULT
// ============================================================

function showQuizResult() {

  if (!state.quizState) {
    return;
  }


  var score =
    state.quizState.score;

  var total =
    state.quizState.total;


  var pct =
    total > 0
      ? Math.round((score / total) * 100)
      : 0;


  // ----------------------------------------------------------
  // Grade
  // ----------------------------------------------------------

  var msg = '';
  var emoji = '';


  if (pct === 100) {

    emoji = '🏆';
    msg = 'মাশাআল্লাহ! অসাধারণ! সবগুলো উত্তর সঠিক।';

  } else if (pct >= 80) {

    emoji = '🎉';
    msg = 'অসাধারণ! আপনার ইসলামিক জ্ঞান খুব ভালো।';

  } else if (pct >= 60) {

    emoji = '👍';
    msg = 'খুব ভালো! আরও একটু অনুশীলন করুন।';

  } else if (pct >= 40) {

    emoji = '📚';
    msg = 'ভালো চেষ্টা! আরও পড়াশোনা করলে স্কোর বাড়বে।';

  } else {

    emoji = '🌱';
    msg = 'হাল ছাড়বেন না। নিয়মিত পড়ুন ও আবার চেষ্টা করুন।';
  }


  // ----------------------------------------------------------
  // Time
  // ----------------------------------------------------------

  var elapsed =
    state.quizState.startTime
      ? Math.round(
          (Date.now() -
           state.quizState.startTime) / 1000
        )
      : 0;


  var minutes =
    Math.floor(elapsed / 60);

  var seconds =
    elapsed % 60;


  var timeText =
    minutes + ' মিনিট ' +
    seconds + ' সেকেন্ড';


  // ----------------------------------------------------------
  // Result HTML
  // ----------------------------------------------------------

  var html = '';


  html +=
    '<div class="quiz-card">';


  html +=
    '<div class="result">' +
    '📊 কুইজ রেজাল্ট' +
    '</div>';


  // Score
  html +=
    '<div style="' +
    'text-align:center;' +
    'font-size:1.4rem;' +
    'font-weight:800;' +
    'padding:10px 0;' +
    '">' +

    score +
    '/' +
    total +

    '</div>';


  // Percentage
  html +=
    '<div style="' +
    'text-align:center;' +
    'font-size:1rem;' +
    'margin-bottom:8px;' +
    '">' +

    '📈 সঠিক উত্তর: ' +
    pct +
    '%' +

    '</div>';


  // Correct / Wrong
  html +=
    '<div style="' +
    'display:flex;' +
    'justify-content:space-around;' +
    'text-align:center;' +
    'margin:10px 0;' +
    '">' +

    '<div>' +
    '✅<br>' +
    '<b>' +
    state.quizState.correctAnswers +
    '</b><br>' +
    '<small>সঠিক</small>' +
    '</div>' +

    '<div>' +
    '❌<br>' +
    '<b>' +
    state.quizState.wrongAnswers +
    '</b><br>' +
    '<small>ভুল</small>' +
    '</div>' +

    '<div>' +
    '⏱️<br>' +
    '<b>' +
    timeText +
    '</b><br>' +
    '<small>সময়</small>' +
    '</div>' +

    '</div>';


  // Message
  html +=
    '<div style="' +
    'text-align:center;' +
    'padding:10px 0;' +
    'font-weight:600;' +
    '">' +

    emoji +
    ' ' +
    msg +

    '</div>';


  // Retry button
  html +=
    '<button ' +
    'onclick="window.startQuiz()" ' +
    'style="' +
    'display:block;' +
    'width:100%;' +
    'padding:.55rem;' +
    'background:var(--gold-gradient);' +
    'border:none;' +
    'border-radius:var(--rounded);' +
    'cursor:pointer;' +
    'font-weight:700;' +
    'font-family:var(--font-ui);' +
    'color:var(--dark);' +
    'font-size:.78rem;' +
    '">' +

    '🔄 আবার চেষ্টা করুন' +

    '</button>';


  html +=
    '</div>';


  // Home button
  html +=
    '<div class="home-btn-container">' +

    '<button ' +
    'class="home-btn" ' +
    'onclick="window.goHome()"' +
    '>' +

    '🏠 হোমে যান' +

    '</button>' +

    '</div>';


  addBotMessage(
    html,
    'normal',
    true
  );


  // Clear quiz state
  state.quizState = null;
}


// ============================================================
// OPTIONAL: QUIZ QUESTION COUNT
// ============================================================

function getQuizQuestionCount() {

  return QUIZ_QUESTIONS.length;
}


// ============================================================
// OPTIONAL: START CUSTOM QUIZ
// Example:
// startCustomQuiz(20);
// ============================================================

function startCustomQuiz(count) {

  count = parseInt(count, 10);

  if (
    isNaN(count) ||
    count < 1
  ) {
    count = 10;
  }


  if (count > QUIZ_QUESTIONS.length) {
    count = QUIZ_QUESTIONS.length;
  }


  var questions =
    pickRandomQuizSet(count);


  state.quizState = {

    questions: questions,

    current: 0,

    score: 0,

    total: questions.length,

    answered: false,

    correctAnswers: 0,

    wrongAnswers: 0,

    startTime: Date.now()
  };


  askQuizQuestion();
}


