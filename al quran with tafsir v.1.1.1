function showAllCategories() {
  var categories = [];
  for (var key in state.verseCategories) {
    if (state.verseCategories.hasOwnProperty(key)) {
      var cat = state.verseCategories[key];
      if (cat && categories.indexOf(cat) === -1) {
        categories.push(cat);
      }
    }
  }
  
  if (categories.length === 0) {
    addBotMessage('📑 কোনো ক্যাটাগরি পাওয়া যায়নি।', 'info');
