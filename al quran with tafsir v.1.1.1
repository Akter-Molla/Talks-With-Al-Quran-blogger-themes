      html += '</div>';
      html += '<button class="zakat-btn" onclick="window.calculateZakat()">🧮 যাকাত গণনা করুন</button>';
      html += '<div class="zakat-result"><div>আপনার যাকাতের পরিমাণ:</div><div class="amount" id="zakat-amount">প্রয়োজনীয় ইনপুট দিন</div></div>';
      html += '<div style="margin-top:0.2rem;font-size:0.55rem;color:var(--gray-dark);">⚠️ নিসাব: ৫২,৫০০ টাকা</div>';
      html += '</div>';
