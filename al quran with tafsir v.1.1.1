    function handleQuickAction(action) {
      if (!state.dataLoaded) {
        addBotMessage('⏳ ডেটা লোড হচ্ছে, একটু অপেক্ষা করুন...', 'info');
        return;
      }
      if (dom.welcomeSection && state.welcomeVisible) {
        dom.welcomeSection.style.display = 'none';
        state.welcomeVisible = false;
      }
      
      switch(action) {
        case 'start': addBotMessage('💬 চ্যাট শুরু হয়েছে! "সাহায্য" লিখে সাহায্য নিন।', 'info'); break;
        case 'popular': showPopularAyat(); break;
        case 'sura': openSuraPanel(); break;
        case 'prayer': showPrayerTimes(); break;
        case 'hadith': showRandomHadith(); break;
        case 'blog': showBlogPosts(); break;
        case 'books': showBookCorner(); break;
        case 'zakat': showZakatCalculator(); break;
        case 'timer': showTimer(); break;
        case 'quiz': startQuiz(); break;
        case 'opentafsirtab': openQuranTafsirTab(); break;
        case 'help': showHelp(); break;
        default: addBotMessage('❓ অজ্ঞাত কমান্ড', 'error');
      }
    }

    function handleBookCommand(query) {
      var bookPatterns = [
        /বই[\s]*(পড়|পড়|খুল|দেখ|শো|read|open|show|খোলো|দেখাও|পড়ো)[\s]*(.+)/i,
        /(পড়|পড়|খুল|দেখ|شо|read|open|show|খোলো|দেখাও|পড়ো)[\s]*(বই|পিডিএফ|pdf|book)[\s]*(.+)/i,
        /বই[\s]*(.+)/i,
        /book[\s]*(.+)/i
      ];
      
      var bookName = null;
      for (var i = 0; i < bookPatterns.length; i++) {
        var match = query.match(bookPatterns[i]);
        if (match) {
          bookName = match[match.length - 1];
          break;
        }
      }
      
      if (!bookName) {
        var cleaned = query.replace(/বই|পিডিএফ|pdf|book|পড়|পড়|খুল|দেখ|শো|read|open|show/gi, '').trim();
        if (cleaned.length > 1) bookName = cleaned;
      }
      
      if (bookName && bookName.length > 1) {
        var book = findBookByName(bookName);
        if (book) {
          var viewUrl = book.driveId ? getDriveViewUrl(book.driveId) : null;
          if (viewUrl) {
            addBotMessage('📖 "' + book.title + '" বইটি খোলা হচ্ছে...', 'info');
            loadPDF(viewUrl, book.title);
            return true;
          } else {
            addBotMessage('❌ "' + book.title + '" বইটির PDF লিংক উপলব্ধ নেই।', 'error');
            return true;
          }
        } else {
          addBotMessage('❌ "' + bookName + '" নামে কোনো বই পাওয়া যায়নি। "বই" লিখে সব বই দেখুন।', 'error');
          return true;
        }
      }
      return false;
    }

